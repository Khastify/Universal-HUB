    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

function H.RemoveSkeleton(player)
    local data = ESP.skeletons[player]

    if data then
        if data.gui then
            data.gui:Destroy()
        end
    end

    ESP.skeletons[player] = nil
end

function H.CreateSkeleton(player)
    H.RemoveSkeleton(player)
    local stale = Parent:FindFirstChild("KHASTIFY_SkeletonESP_" .. player.UserId)
    if stale then stale:Destroy() end

    if not State.skeleton
        or player == LP
        or not player.Parent then
        return
    end

    local character = player.Character
    if not character then return end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then return end

    local bones = humanoid.RigType == Enum.HumanoidRigType.R6
        and R6Bones or R15Bones

    -- Screen-space drawing means the skeleton is visible
    -- through walls and doesn't depend on avatar transparency.

    local screen = H.Create("ScreenGui", {
        Name = "KHASTIFY_SkeletonESP_" .. player.UserId,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 500,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, Parent)

    local lines = {}

    for i, pair in ipairs(bones) do
        local line = H.Create("Frame", {
            Name = "Bone" .. i,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(0, 2),
            BackgroundColor3 = ESPColors.skeleton,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 10
        }, screen)

        H.Corner(line, 2)

        table.insert(lines, {
            frame = line,
            first = character:FindFirstChild(pair[1]),
            second = character:FindFirstChild(pair[2])
        })
    end

    ESP.skeletons[player] = {
        gui = screen,
        character = character,
        humanoid = humanoid,
        lines = lines
    }
end

-- Reconcile character models occasionally, not on every rendered frame.
function H.RefreshSkeletons()
    if not State.skeleton then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local data = ESP.skeletons[player]
            if not data or data.character ~= player.Character then
                H.CreateSkeleton(player)
            end
        end
    end
end

-- Project cached bone parts every frame so lines track the camera smoothly.
function H.UpdateSkeletons()
    if not State.skeleton then return end
    local camera = workspace.CurrentCamera
    if not camera then return end

    for player, data in pairs(ESP.skeletons) do
        if not player.Parent or not data.character or not data.character.Parent
            or not data.humanoid or not data.humanoid.Parent
            or data.humanoid.Health <= 0 then
            H.RemoveSkeleton(player)
        else
                    for _, bone in ipairs(data.lines) do
                        local first = bone.first
                        local second = bone.second

                        if first and second
                            and first:IsA("BasePart")
                            and second:IsA("BasePart") then

                            local p1, visible1 =
                                camera:WorldToViewportPoint(
                                    first.Position
                                )

                            local p2, visible2 =
                                camera:WorldToViewportPoint(
                                    second.Position
                                )

                            if p1.Z > 0
                                and p2.Z > 0
                                and (visible1 or visible2) then

                                local x1, y1 = p1.X, p1.Y
                                local x2, y2 = p2.X, p2.Y

                                local dx = x2 - x1
                                local dy = y2 - y1

                                local length =
                                    math.sqrt(dx * dx + dy * dy)

                                bone.frame.Position =
                                    UDim2.fromOffset(
                                        (x1 + x2) / 2,
                                        (y1 + y2) / 2
                                    )

                                bone.frame.Size =
                                    UDim2.fromOffset(length, 2)

                                bone.frame.Rotation =
                                    math.deg(math.atan2(dy, dx))

                                bone.frame.Visible = true
                            else
                                bone.frame.Visible = false
                            end
                        else
                            bone.frame.Visible = false
                        end
                    end
        end
    end
end

function H.SetSkeleton(enabled)
    State.skeleton = enabled

    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP then
                H.CreateSkeleton(player)
            end
        end
    else
        local toRemove = {}

        for player in pairs(ESP.skeletons) do
            table.insert(toRemove, player)
        end

        for _, player in ipairs(toRemove) do
            H.RemoveSkeleton(player)
        end
    end
end

function H.CleanupESP()
    H.SetCharms(false)
    H.SetSkeleton(false)
end

H.Bind(Players.PlayerRemoving, function(player)
    H.RemoveCharms(player)
    H.RemoveSkeleton(player)
end)

