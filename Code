local function DrawIcon(parent, kind, color)
    color = color or C.muted

    local holder = Create("Frame", {
        Size = UDim2.fromOffset(26, 26),
        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, parent)

    if kind == "commands" then

        -- UNCHANGED FROM V26.

        Line(holder, 5, 8, 10.5, 13, color, 2.2)
        Line(holder, 10.5, 13, 5, 18, color, 2.2)

        Line(
            holder,
            13, 18.5,
            21, 18.5,
            color, 2.2
        )

    elseif kind == "voice" then

        --==================================================
        -- V27 VOICE CHAT
        --==================================================

        -- Rounded microphone capsule.
        -- One continuous closed outline.

        local mic = {}

        local function Append(points)
            for _, point in ipairs(points) do
                table.insert(mic, point)
            end
        end

        -- Top semicircle.
        Append(ArcPoints(
            13, 6.5,
            3.5, 3.5,
            180, 360, 18
        ))

        -- Right side.
        table.insert(mic, Vector2.new(16.5, 13))

        -- Bottom semicircle.
        Append(ArcPoints(
            13, 13,
            3.5, 3.5,
            0, 180, 18
        ))

        -- Left side.
        table.insert(mic, Vector2.new(9.5, 6.5))

        Path(holder, mic, color, true)

        -- Microphone arms:
        -- Both sides connect into the same U-shaped curve.

        local support = ArcPoints(
            13, 13,
            7.5, 7.5,
            0, 180, 32
        )

        table.insert(
            support,
            1,
            Vector2.new(20.5, 10)
        )

        table.insert(
            support,
            Vector2.new(5.5, 10)
        )

        Path(holder, support, color, false)

        -- Center stem and base.
        Line(holder, 13, 20.5, 13, 23, color, ICON_STROKE)
        Line(holder, 9, 23, 17, 23, color, ICON_STROKE)

    elseif kind == "players" then

        --==================================================
        -- V27 PLAYERS
        --==================================================

        -- Rear person's head.
        SmoothCircle(holder, 18.5, 8, 3, color)

        -- Rear person's shoulder and body.
        Curve(
            holder,

            Vector2.new(16.8, 14.2),
            Vector2.new(20.5, 13.2),
            Vector2.new(23, 16),
            Vector2.new(23, 20),

            color
        )

        Line(
            holder,
            23, 20,
            18.5, 20,
            color,
            ICON_STROKE
        )

        -- Front person's head.
        SmoothCircle(holder, 9.5, 8.5, 3.7, color)

        -- Front person's upper body.
        -- Left shoulder, torso, bottom and right shoulder.

        local body = {}

        local leftShoulder = CurvePoints(
            Vector2.new(8, 15),
            Vector2.new(4, 15),
            Vector2.new(2.5, 17.5),
            Vector2.new(2.5, 21),
            18
        )

        for _, point in ipairs(leftShoulder) do
            table.insert(body, point)
        end

        table.insert(body, Vector2.new(16.5, 21))

        local rightShoulder = CurvePoints(
            Vector2.new(16.5, 21),
            Vector2.new(16.5, 17.5),
            Vector2.new(14.5, 15),
            Vector2.new(11, 15),
            18
        )

        for _, point in ipairs(rightShoulder) do
            table.insert(body, point)
        end

        Path(holder, body, color, false)

    elseif kind == "actions" then

        --==================================================
        -- V27 ACTIONS
        --==================================================

        -- Hollow four-point diamond star.
        -- One connected closed path.
        -- No separate dots or disconnected tips.

        local top = Vector2.new(13, 2.5)
        local right = Vector2.new(23.5, 13)
        local bottom = Vector2.new(13, 23.5)
        local left = Vector2.new(2.5, 13)

        local star = {}

        local function AddCurve(p0, p1, p2, p3)
            local points = CurvePoints(
                p0, p1, p2, p3, 24
            )

            for _, point in ipairs(points) do
                table.insert(star, point)
            end
        end

        AddCurve(
            top,
            Vector2.new(16, 10),
            Vector2.new(16, 10),
            right
        )

        AddCurve(
            right,
            Vector2.new(16, 16),
            Vector2.new(16, 16),
            bottom
        )

        AddCurve(
            bottom,
            Vector2.new(10, 16),
            Vector2.new(10, 16),
            left
        )

        AddCurve(
            left,
            Vector2.new(10, 10),
            Vector2.new(10, 10),
            top
        )

        Path(holder, star, color, true)

    elseif kind == "servers" then

        -- UNCHANGED FROM V26.

        local function S(v)
            return v * 1.3
        end

        OutlineRect(
            holder,
            S(2), S(2),
            S(16), S(7),
            color, S(2.5), 1.8
        )

        OutlineRect(
            holder,
            S(2), S(11),
            S(16), S(7),
            color, S(2.5), 1.8
        )

        Dot(holder, S(5.5), S(5.5), S(1), color)
        Dot(holder, S(5.5), S(14.5), S(1), color)

        Line(
            holder,
            S(10), S(5.5),
            S(15), S(5.5),
            color, 1.6
        )

        Line(
            holder,
            S(10), S(14.5),
            S(15), S(14.5),
            color, 1.6
        )

    elseif kind == "settings" then

        --==================================================
        -- V27 SETTINGS
        --==================================================

        -- Connected gear outline.
        -- Eight evenly spaced teeth.
        -- Same stroke width for every edge.

        local cx = 13
        local cy = 13

        local outline = {}

        for i = 0, 7 do
            local center = math.rad(-90 + i * 45)

            local angles = {
                -22.5,
                -15,
                -15,
                15,
                15,
                22.5
            }

            local radii = {
                8.3,
                8.3,
                10.5,
                10.5,
                8.3,
                8.3
            }

            for j = 1, #angles do
                local angle =
                    center + math.rad(angles[j])

                local radius = radii[j]

                table.insert(
                    outline,
                    Vector2.new(
                        cx + math.cos(angle) * radius,
                        cy + math.sin(angle) * radius
                    )
                )
            end
        end

        Path(holder, outline, color, true)

        -- Center hole.
        SmoothCircle(holder, cx, cy, 3.4, color)
    end

    return holder
end

