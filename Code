        end
    )
end

local function numberControl(text, key, callback)
    local row = create("Frame", {
        Size = UDim2.new(1, -4, 0, 34),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0
    }, content)

    create("TextLabel", {
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(0.53, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Gotham,
        TextSize = 11
    }, row)

    local input = create("TextBox", {
        Position = UDim2.new(0.55, 0, 0, 4),
        Size = UDim2.new(0.25, 0, 1, -8),
        BackgroundColor3 = C.bg,
        Text = tostring(state[key]),
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        ClearTextOnFocus = false
    }, row)

    local set = create("TextButton", {
        Position = UDim2.new(0.81, 0, 0, 4),
        Size = UDim2.new(0.17, 0, 1, -8),
        BackgroundColor3 = C.purple,
        Text = "set",
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 10
    }, row)

    local function apply()
        local value = tonumber(input.Text)

        if value then
            value = math.clamp(value, 0, 500)
            state[key] = value
            input.Text = tostring(value)

            if callback then callback(value) end
            save()
        else
            input.Text = tostring(state[key])
        end
    end

    bind(set.MouseButton1Click, apply)

    bind(input.FocusLost, function(enter)
        if enter then apply() end
    end)
end

