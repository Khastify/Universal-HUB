local function ClearList()
    for _, object in ipairs(List:GetChildren()) do
        if object ~= ListLayout
            and not object:IsA("UIPadding") then

            object:Destroy()
        end
    end

    for _, object in ipairs(Categories:GetChildren()) do
        if object ~= CategoryLayout then
            object:Destroy()
        end
    end

    table.clear(Entries)
end

local function AddEntry(object, name, category)
    table.insert(Entries, {
        object = object,
        name = name:lower(),
        category = category
    })
end

local function FilterEntries()
    local query = SearchBox.Text:lower()

    for _, entry in ipairs(Entries) do
        local matches =
            query == ""
            or entry.name:find(
                query,
                1,
                true
            )

        local categoryMatches =
            CurrentCategory == "All"
            or entry.category == CurrentCategory

        entry.object.Visible =
            matches and categoryMatches
    end
end

local function AddCategory(name)
    local button = Create("TextButton", {
