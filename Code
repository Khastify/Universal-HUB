Bind(LP.CharacterAdded, function(c)
    StopFly()
    StopAirWalk()

    InvisibleActive = false
    DestroyInvisible()

    State.invisible = false
    State.airWalk = false
    State.freeze = false

    table.clear(Collisions)
    table.clear(Transparency)
    table.clear(HeadTransparency)
    table.clear(HeadDecals)

    OriginalCameraSubject = nil
    OriginalCameraType = nil
    OriginalCameraOffset = nil

    local h = c:WaitForChild("Humanoid", 10)

    if h then
        h.WalkSpeed = State.speed
        h.UseJumpPower = true
        h.JumpPower = State.jump
    end

    task.wait(0.3)

    if State.fly then
        StartFly()
    end
end)

