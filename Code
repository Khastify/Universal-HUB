-- ==========================================
-- COLLISION MANAGEMENT
-- ==========================================

local collisions = {}

local function applyNoclip()
    local c = character()
    if not c then return end

    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            if collisions[p] == nil then
                collisions[p] = p.CanCollide
            end

            p.CanCollide = false
        end
    end
end

local function restoreCollision()
    for p, value in pairs(collisions) do
        if p and p.Parent then
            p.CanCollide = value
        end
    end

    table.clear(collisions)
end

-- ==========================================
-- FLIGHT
-- ==========================================

local flyVelocity
local flyGyro

local function stopFly()
    if flyVelocity then flyVelocity:Destroy() end
    if flyGyro then flyGyro:Destroy() end

    flyVelocity = nil
    flyGyro = nil

    local h = humanoid()
    if h then h.PlatformStand = false end
end

local function startFly()
    stopFly()

    local r = root()
    local h = humanoid()
    if not r or not h then return end

    h.PlatformStand = true

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = r

    flyGyro = Instance.new("BodyGyro")
    flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyGyro.P = 9000
    flyGyro.Parent = r
end

local function makePlatform(name, size)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Anchored = true
    p.Transparency = 1
    p.CanCollide = true
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Parent = workspace
    return p
end

-- ==========================================
-- AIR WALK
-- ==========================================

local airPlatform
local airHeight

local function stopAirWalk()
    if airPlatform then airPlatform:Destroy() end
    airPlatform = nil
    airHeight = nil
end

local function startAirWalk()
    stopAirWalk()

    local r = root()
    if not r then return end

    airHeight = r.Position.Y - 3.2

    airPlatform = makePlatform(
        "KHASTIFY_AirWalk",
        Vector3.new(10, 0.5, 10)
    )

    airPlatform.Position = Vector3.new(
        r.Position.X,
        airHeight - 0.25,
        r.Position.Z
    )
end

local function dash()
    local r = root()
    local camera = workspace.CurrentCamera
    if not r or not camera then return end

    local d = camera.CFrame.LookVector
    d = Vector3.new(d.X, 0, d.Z)

    if d.Magnitude < 0.01 then return end

    local v = r.AssemblyLinearVelocity

    r.AssemblyLinearVelocity =
        d.Unit * state.dashPower
        + Vector3.new(0, v.Y, 0)
end

-- ==========================================
-- INVISIBILITY V9
-- ==========================================

local OFFSET = 11
local TRANSPARENCY = 0.30

local invisibleActive = false
local visualAvatar
local invisibleFloor

local partPairs = {}
local originalTransparency = {}

local originalCameraSubject
local originalCameraType
local originalCameraOffset

local floorY
local lastGroundY
local lastGroundPosition

-- These values can be tuned for different rigs.
local FLOOR_DISTANCE = 3.2
local MAX_STEP_UP = 3.5
local MAX_STEP_DOWN = 5
local CEILING_CLEARANCE = 4.5
local GROUND_SCAN_HEIGHT = 14
local GROUND_SCAN_LENGTH = 32

local function restoreTransparency()
    for p, value in pairs(originalTransparency) do
        if p and p.Parent then
            p.LocalTransparencyModifier = value
        end
    end

    table.clear(originalTransparency)
end

local function destroyInvisibleObjects()
    if visualAvatar then
        visualAvatar:Destroy()
        visualAvatar = nil
    end

    if invisibleFloor then
        invisibleFloor:Destroy()
        invisibleFloor = nil
    end

    table.clear(partPairs)
end

local function partPath(obj, ancestor)
    local pieces = {}
    local current = obj

    while current and current ~= ancestor do
        local index = 0

        for _, sibling in ipairs(current.Parent:GetChildren()) do
            if sibling.Name == current.Name
                and sibling.ClassName == current.ClassName then
                index += 1
                if sibling == current then break end
            end
        end

        table.insert(
            pieces,
            1,
            current.ClassName .. ":"
                .. current.Name .. ":" .. index
        )

        current = current.Parent
    end

    return table.concat(pieces, "/")
end

local function createVisualAvatar()
    local c = character()
    if not c then return nil end

    local previousArchivable = c.Archivable
    c.Archivable = true

    local ok, clone = pcall(function()
        return c:Clone()
    end)

    c.Archivable = previousArchivable

    if not ok or not clone then return nil end

    clone.Name = "KHASTIFY_TransparentAvatar"

    -- Remove all constraints so every visual part
    -- can be positioned independently.
    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("Script")
            or obj:IsA("LocalScript") then

            obj:Destroy()

        elseif obj:IsA("JointInstance")
            or obj:IsA("WeldConstraint")
            or obj:IsA("Constraint") then

            obj:Destroy()

        elseif obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.CastShadow = false

            if obj.Name == "HumanoidRootPart" then
                obj.Transparency = 1
            else
                obj.Transparency = math.max(
                    obj.Transparency,
                    TRANSPARENCY
                )
            end

            obj.LocalTransparencyModifier = 0

        elseif obj:IsA("Decal")
            or obj:IsA("Texture") then

            obj.Transparency = math.max(
                obj.Transparency,
                TRANSPARENCY
            )

        elseif obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Beam") then

            obj.Enabled = false
        end
    end

    local lookup = {}

    for _, p in ipairs(clone:GetDescendants()) do
        if p:IsA("BasePart") then
            lookup[partPath(p, clone)] = p
        end
    end

    table.clear(partPairs)

    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            local match = lookup[partPath(p, c)]

            if match then
                table.insert(partPairs, {
                    source = p,
                    visual = match
                })
            end
        end
    end

    local ghostHum = clone:FindFirstChildOfClass("Humanoid")

    if ghostHum then
        ghostHum.DisplayDistanceType =
            Enum.HumanoidDisplayDistanceType.None
    end

    clone.Parent = workspace

    return clone
end

-- ==========================================
-- TERRAIN DETECTION
-- ==========================================

local function groundAt(x, z, referenceY)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local exclusions = {}

    if character() then
        table.insert(exclusions, character())
    end

    if visualAvatar then
        table.insert(exclusions, visualAvatar)
    end

    if invisibleFloor then
        table.insert(exclusions, invisibleFloor)
    end

    if airPlatform then
        table.insert(exclusions, airPlatform)
    end

    params.FilterDescendantsInstances = exclusions
    params.IgnoreWater = false

    local origin = Vector3.new(
        x,
        referenceY + GROUND_SCAN_HEIGHT,
        z
    )

    local result = workspace:Raycast(
        origin,
        Vector3.new(0, -GROUND_SCAN_LENGTH, 0),
        params
    )

    if result and result.Normal.Y > 0.35 then
        return result.Position.Y
    end

    return nil
end

local function setBodyY(newY)
    local c = character()
    local r = root()

    if not c or not r then return end

    local delta = newY - r.Position.Y

    if math.abs(delta) > 0.001 then
        c:PivotTo(c:GetPivot() + Vector3.new(
            0, delta, 0
        ))
    end
end

-- ==========================================
-- CAMERA FIX
-- ==========================================

local function applyInvisibleCamera()
    local camera = workspace.CurrentCamera
    local h = humanoid()

    if not camera or not h then return end

    -- Keep Roblox's regular humanoid camera.
    -- Raise its subject offset by the same amount
    -- that the real body was lowered.
    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = h

    h.CameraOffset =
        (originalCameraOffset or Vector3.zero)
        + Vector3.new(0, OFFSET, 0)
end

local function restoreCamera()
    local camera = workspace.CurrentCamera
    local h = humanoid()

    if h and originalCameraOffset then
        h.CameraOffset = originalCameraOffset
    end

    if camera then
        camera.CameraType =
            originalCameraType or Enum.CameraType.Custom

        if originalCameraSubject
            and originalCameraSubject.Parent then

            camera.CameraSubject = originalCameraSubject

        elseif h then
            camera.CameraSubject = h
        end
    end

    originalCameraSubject = nil
    originalCameraType = nil
    originalCameraOffset = nil
end

-- ==========================================
-- EXACT VISUAL MIRROR
-- ==========================================

local function mirrorAvatar()
    if not invisibleActive then return end
    if not visualAvatar or not visualAvatar.Parent then return end

    local offset = Vector3.new(0, OFFSET, 0)

    for _, pair in ipairs(partPairs) do
        local source = pair.source
        local visual = pair.visual

        if source and source.Parent
            and visual and visual.Parent then

            visual.CFrame = source.CFrame + offset
            visual.Size = source.Size
        end
    end
end

-- ==========================================
-- INVISIBILITY CONTROL
-- ==========================================

local function setInvisible(enabled)
    local c = character()
    local r = root()
    local h = humanoid()
    local camera = workspace.CurrentCamera

    if not enabled then
        if invisibleActive and c then
            c:PivotTo(
                c:GetPivot()
                + Vector3.new(0, OFFSET, 0)
            )

            if r then
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        end

        invisibleActive = false

        restoreCamera()
        destroyInvisibleObjects()
        restoreTransparency()

        if not state.noclip then
            restoreCollision()
        end

        floorY = nil
        lastGroundY = nil
        lastGroundPosition = nil

        return
    end

    if invisibleActive then return end

    if not c or not r or not h then
        state.invisible = false
        return
    end

    local clone = createVisualAvatar()

    if not clone then
        state.invisible = false
        warn("[KHASTIFY] Failed to create visual avatar.")
        return
    end

    visualAvatar = clone

    if camera then
        originalCameraSubject = camera.CameraSubject
        originalCameraType = camera.CameraType
    end

    originalCameraOffset = h.CameraOffset

    -- Determine the visible ground level before
    -- moving the physical character.
    local startingPosition = r.Position

    lastGroundY = groundAt(
        startingPosition.X,
        startingPosition.Z,
        startingPosition.Y
    )

    if not lastGroundY then
        lastGroundY = startingPosition.Y - FLOOR_DISTANCE
    end

    lastGroundPosition = startingPosition

    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            originalTransparency[p] =
                p.LocalTransparencyModifier
        end
    end

    -- Enable noclip before going underground.
    applyNoclip()

    -- Move physical body 11 studs down.
    c:PivotTo(
        c:GetPivot()
        + Vector3.new(0, -OFFSET, 0)
    )

    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            p.LocalTransparencyModifier = 1
        end
    end

    -- Initial underground walking surface.
    floorY = r.Position.Y - FLOOR_DISTANCE

    invisibleFloor = makePlatform(
        "KHASTIFY_InvisibleSupport",
        Vector3.new(14, 0.5, 14)
    )

    invisibleFloor.Position = Vector3.new(
        r.Position.X,
        floorY - 0.25,
        r.Position.Z
    )

    invisibleActive = true

    mirrorAvatar()
    applyInvisibleCamera()
end

-- ==========================================
-- TERRAIN-FOLLOWING UNDERGROUND PHYSICS
-- ==========================================

local function updateInvisible()
    if not invisibleActive then return end

    local c = character()
    local r = root()
    local h = humanoid()

    if not c or not r or not h then return end

    applyNoclip()

    local p = r.Position

    -- Scan the real world at the visual avatar's height.
    local visualY = p.Y + OFFSET

    local detectedGround = groundAt(
        p.X,
        p.Z,
        visualY
    )

    if detectedGround then
        if not lastGroundY then
            lastGroundY = detectedGround
        end

        local difference = detectedGround - lastGroundY

        -- Small elevation changes, such as stairs,
        -- are applied to the underground body.
        if difference > 0
            and difference <= MAX_STEP_UP then

            setBodyY(r.Position.Y + difference)
            lastGroundY = detectedGround

        elseif difference < 0
            and difference >= -MAX_STEP_DOWN then

            setBodyY(r.Position.Y + difference)
            lastGroundY = detectedGround

        elseif math.abs(difference) < 0.05 then
            lastGroundY = detectedGround
        end
    end

    p = r.Position

    -- Walking floor tracks the visible terrain.
    -- It remains 11 studs beneath the corresponding
    -- aboveground walking surface.
    if lastGroundY then
        floorY = lastGroundY - OFFSET
    end

    if invisibleFloor then
        invisibleFloor.Position = Vector3.new(
            p.X,
            floorY - 0.25,
            p.Z
        )
    end

    if not state.fly then
        -- The physical root must remain above its
        -- underground walking support.
        local minimumRootY = floorY + FLOOR_DISTANCE

        if r.Position.Y < minimumRootY then
            setBodyY(minimumRootY)

            local v = r.AssemblyLinearVelocity
            r.AssemblyLinearVelocity = Vector3.new(
                v.X,
                math.max(0, v.Y),
                v.Z
            )
        end

        -- The physical character must not jump high
        -- enough to emerge through the visible ground.
        --
        -- The clearance accounts approximately for
        -- the upper body extending above the root.
        local maximumRootY =
            (lastGroundY or (r.Position.Y + OFFSET))
            - CEILING_CLEARANCE

        if r.Position.Y > maximumRootY then
            setBodyY(maximumRootY)

            local v = r.AssemblyLinearVelocity
            r.AssemblyLinearVelocity = Vector3.new(
                v.X,
                math.min(0, v.Y),
                v.Z
            )
        end
    end

    lastGroundPosition = r.Position
end

-- ==========================================
-- CHARACTER TOOLS
-- ==========================================

local savedHeadTransparency = {}
local savedHeadDecals = {}

local function setHeadless(enabled)
    local c = character()
    if not c then return end

    local head = c:FindFirstChild("Head")
    if not head then return end

    if enabled then
        if savedHeadTransparency[head] == nil then
            savedHeadTransparency[head] =
                head.LocalTransparencyModifier
        end

        head.LocalTransparencyModifier = 1

        for _, obj in ipairs(head:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then
                if savedHeadDecals[obj] == nil then
                    savedHeadDecals[obj] = obj.Transparency
                end
                obj.Transparency = 1
            end
        end
    else
        for p, v in pairs(savedHeadTransparency) do
            if p and p.Parent then
                p.LocalTransparencyModifier = v
            end
        end

        for p, v in pairs(savedHeadDecals) do
            if p and p.Parent then
                p.Transparency = v
            end
        end

        table.clear(savedHeadTransparency)
        table.clear(savedHeadDecals)
    end
end

local function setFreeze(enabled)
    local r = root()
    if not r then return end

    r.Anchored = enabled

    if enabled then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

local function sit()
    local h = humanoid()
    if h then h.Sit = true end
end

local function unstuck()
    local r = root()
    if not r then return end

    state.freeze = false
    r.Anchored = false

    r.CFrame = r.CFrame + Vector3.new(0, 6, 0)
    r.AssemblyLinearVelocity = Vector3.zero
end

local function respawn()
    local h = humanoid()
    if h then h.Health = 0 end
end

local function selfFling()
    local r = root()
    if not r then return end

    r.AssemblyLinearVelocity = Vector3.new(
        math.random(-120, 120),
        100,
        math.random(-120, 120)
    )

    r.AssemblyAngularVelocity = Vector3.new(15, 20, 15)
end

