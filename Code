    local input = H.Create("TextBox", {
        Position = UDim2.new(1, -148, 0, top),
        Size = UDim2.fromOffset(67, 27),
        BackgroundColor3 = C.bg,
        Text = tostring(State[key]),
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        ClearTextOnFocus = false
    }, parent)

    H.Corner(input, 6)
    H.Stroke(input, C.border)

    local reset = H.Create("TextButton", {
        Position = UDim2.new(1, -73, 0, top),
        Size = UDim2.fromOffset(58, 27),
        BackgroundColor3 = C.selected,
        BorderSizePixel = 0,
        Text = "Reset",
        TextColor3 = C.muted,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        AutoButtonColor = false
    }, parent)

    H.Corner(reset, 6)

    H.Bind(reset.MouseEnter, function()
        H.Tween(reset, {
            BackgroundColor3 = C.purple,
            TextColor3 = C.text
        }, 0.15)
    end)

    H.Bind(reset.MouseLeave, function()
        H.Tween(reset, {
            BackgroundColor3 = C.selected,
            TextColor3 = C.muted
        }, 0.15)
    end)

    local track = H.Create("Frame", {
        Position = UDim2.fromOffset(15, top + 42),
        Size = UDim2.new(1, -30, 0, 5),
        BackgroundColor3 = C.border,
        BorderSizePixel = 0
    }, parent)

    H.Corner(track, 3)

    local fill = H.Create("Frame", {
        Size = UDim2.fromScale(
            math.clamp(State[key] / maximum, 0, 1),
            1
        ),
        BackgroundColor3 = C.purple,
        BorderSizePixel = 0
    }, track)

    H.Corner(fill, 3)

    local knob = H.Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(
            math.clamp(State[key] / maximum, 0, 1),
            0.5
        ),
        Size = UDim2.fromOffset(11, 11),
        BackgroundColor3 = C.purple,
        BorderSizePixel = 0
    }, track)

    H.Corner(knob, 6)

    local function Apply(value)
        value = tonumber(value)

        if not value then
            input.Text = tostring(State[key])
            return
        end

        value = math.clamp(
            math.floor(value + 0.5),
            0,
            maximum
        )

        State[key] = value
        input.Text = tostring(value)

        local percent = value / maximum

        fill.Size = UDim2.fromScale(percent, 1)
        knob.Position = UDim2.fromScale(percent, 0.5)

        if callback then callback(value) end

        H.Save()
    end

    H.Bind(input.FocusLost, function()
        Apply(input.Text)
    end)

    H.Bind(reset.MouseButton1Click, function()
        Apply(default)
    end)

    local dragging = false

    local hitbox = H.Create("TextButton", {
        Position = UDim2.new(0, 0, 0.5, -12),
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 4
    }, track)

    local function UpdateFromX(x)
        local width = math.max(track.AbsoluteSize.X, 1)

        local percent = math.clamp(
            (x - track.AbsolutePosition.X) / width,
            0,
            1
        )

        Apply(percent * maximum)
    end

    H.Bind(hitbox.InputBegan, function(i)
        if i.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            dragging = true
            UpdateFromX(i.Position.X)
        end
    end)

    H.Bind(UIS.InputChanged, function(i)
        if dragging
            and i.UserInputType ==
            Enum.UserInputType.MouseMovement then

            UpdateFromX(i.Position.X)
        end
    end)

    H.Bind(UIS.InputEnded, function(i)
        if i.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            dragging = false
        end
    end)

    return {
        input = input,
        reset = reset,
        track = track,
        apply = Apply
    }
end

