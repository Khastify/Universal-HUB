        12,
        C.text,
        true
    )

    title.Position = UDim2.fromOffset(15, 8)
    title.Size = UDim2.new(1, -65, 0, 21)

    local sub = Label(
        card,
        description or category,
        10,
        C.faint
    )

    sub.Position = UDim2.fromOffset(15, 29)
    sub.Size = UDim2.new(1, -65, 0, 17)

    local arrow = Label(
        card,
        "›",
        22,
        C.muted
    )

    arrow.Position = UDim2.new(1, -29, 0, 10)
    arrow.Size = UDim2.fromOffset(19, 34)
    arrow.TextXAlignment = Enum.TextXAlignment.Center

