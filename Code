    username.Size = UDim2.new(1, -115, 0, 16)

    local arrow = label(
        card, "⌄", 20, C.muted, "medium"
    )

    arrow.Position = UDim2.new(1, -29, 0, 10)
    arrow.Size = UDim2.fromOffset(19, 39)
    arrow.TextXAlignment = Enum.TextXAlignment.Center

    local clickArea = create("TextButton", {
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, 0, 0, 59),

        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, card)

    create("Frame", {
        Position = UDim2.fromOffset(12, 59),
        Size = UDim2.new(1, -24, 0, 1),

        BackgroundColor3 = C.border,
        BorderSizePixel = 0
    }, card)

    local actions = create("Frame", {
        Position = UDim2.fromOffset(12, 70),
        Size = UDim2.new(1, -24, 0, 33),

        BackgroundTransparency = 1
    }, card)

    local tp = create("TextButton", {
        Size = UDim2.new(0.48, 0, 1, 0),

        BackgroundColor3 = C.selected,
        BorderSizePixel = 0,

        Text = "TP",
        TextColor3 = C.text,

        Font = Enum.Font.GothamBold,
        TextSize = 11
    }, actions)

    corner(tp, 7)

    local fling = create("TextButton", {
        Position = UDim2.new(0.52, 0, 0, 0),
        Size = UDim2.new(0.48, 0, 1, 0),

        BackgroundColor3 = C.selected,
        BorderSizePixel = 0,

        Text = "Fling",
        TextColor3 = C.text,

        Font = Enum.Font.GothamBold,
        TextSize = 11
    }, actions)

    corner(fling, 7)

    local function setExpanded(expanded)
        card.Size = UDim2.new(
            1, 0, 0,
            expanded and 114 or 59
        )

        arrow.Text = expanded and "⌃" or "⌄"

        card.BackgroundColor3 =
            expanded and C.hover or C.card
    end

    playerCards[player.UserId] = {
        frame = card,
        expand = setExpanded
    }

    setExpanded(expandedUserId == player.UserId)

    bind(clickArea.MouseButton1Click, function()
        if expandedUserId == player.UserId then
            expandedUserId = nil
        else
            expandedUserId = player.UserId
        end

        for userId, data in pairs(playerCards) do
            if data.frame.Parent then
                data.expand(userId == expandedUserId)
            end
        end
    end)

    bind(tp.MouseButton1Click, function()
        teleportToPlayer(player)
    end)

    bind(fling.MouseButton1Click, function()
        localFlingDemo()
    end)

    addEntry(
        card,
        player.DisplayName .. " " .. player.Name .. " TP Fling",
        "All"
    )
end

