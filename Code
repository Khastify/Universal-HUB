-- COMMAND BAR

local function executeCommand()
    local cmd = commandInput.Text:lower():match("^%s*(.-)%s*$")
    commandInput.Text = ""

    if cmd == "fly" then
        state.fly = true
        startFly()

    elseif cmd == "unfly" then
        state.fly = false
        stopFly()

    elseif cmd == "noclip" then
        state.noclip = true

    elseif cmd == "clip" then
        state.noclip = false
        restoreCollision()

    elseif cmd == "invisible" then
        state.invisible = true
        setInvisible(true)

    elseif cmd == "visible" then
        state.invisible = false
        setInvisible(false)

    elseif cmd == "airwalk" then
        state.airWalk = true
        startAirWalk()

    elseif cmd == "unairwalk" then
        state.airWalk = false
        stopAirWalk()

    elseif cmd == "fullbright" then
        state.fullbright = true
        setFullbright(true)

    elseif cmd == "normal" then
        state.fullbright = false
        setFullbright(false)

    elseif cmd == "rejoin" then
        pcall(function()
            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                game.JobId,
                LP
            )
        end)

    elseif cmd ~= "" then
        warn("[KHASTIFY HUB] Unknown command: " .. cmd)
    end

    if active == "Commands" then
        show("Commands")
    end
end

bind(send.MouseButton1Click, executeCommand)

