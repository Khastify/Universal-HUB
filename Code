    menuKey = "K",
    uiX = 0.5,
    uiY = 0.5
}

local saveFile = "KHASTIFY_Universal_Hub_Settings.json"

if type(readfile) == "function" then
    pcall(function()
        local data = Http:JSONDecode(readfile(saveFile))
        for key, value in pairs(data) do
            if state[key] ~= nil and type(value) == type(state[key]) then
                state[key] = value
            end
        end
    end)
end

local function save()
    if type(writefile) ~= "function" then return end
    pcall(function()
        writefile(saveFile, Http:JSONEncode({
            speed = state.speed,
            jump = state.jump,
            menuKey = state.menuKey,
            uiX = state.uiX,
            uiY = state.uiY
        }))
    end)
end

local function character()
    return LP.Character
end

local function humanoid()
    local c = character()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function root()
    local c = character()
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- MOVEMENT SYSTEM

local originalCollision = {}
local originalTransparency = {}

local function restoreCollision()
    for part, value in pairs(originalCollision) do
        if part and part.Parent then
            part.CanCollide = value
        end
    end
    table.clear(originalCollision)
end

local function restoreTransparency()
    for part, value in pairs(originalTransparency) do
        if part and part.Parent then
            part.LocalTransparencyModifier = value
        end
    end
    table.clear(originalTransparency)
end

-- AIR WALK SYSTEM

local airPlatform
local invisiblePlatform
local airHeight

local function makePlatform(name)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = Vector3.new(7, 0.5, 7)
    p.Transparency = 1
    p.Anchored = true
    p.CanCollide = true
    p.CanTouch = false
    p.CastShadow = false
    p.Parent = workspace
    return p
end

local function stopAirWalk()
    if airPlatform then
        airPlatform:Destroy()
        airPlatform = nil
    end
    airHeight = nil
end

local function startAirWalk()
    stopAirWalk()

    local r = root()
    if not r then return end

    airHeight = r.Position.Y - 3.2
    airPlatform = makePlatform("KHASTIFY_AirWalk")
end

local function updateAirWalk()
    local r = root()
    if not r or not airPlatform then return end

    airPlatform.Position = Vector3.new(
        r.Position.X,
        airHeight - 0.25,
        r.Position.Z
    )
end

-- INVISIBILITY SYSTEM
-- Real character moves beneath the visible hologram.
-- A local platform supports the underground character.

local hologram
local invisibleOffset = 8
local invisibleStart
local invisibleActive = false

local function removeHologram()
    if hologram then
        hologram:Destroy()
        hologram = nil
    end
end

local function removeInvisiblePlatform()
    if invisiblePlatform then
        invisiblePlatform:Destroy()
        invisiblePlatform = nil
    end
end

local function setInvisible(enabled)
    local c = character()
    local r = root()
    local h = humanoid()
    local camera = workspace.CurrentCamera

    if not enabled then
        if invisibleActive and r then
            r.CFrame = r.CFrame * CFrame.new(0, invisibleOffset, 0)
            r.AssemblyLinearVelocity = Vector3.zero
        end

        invisibleActive = false
        removeHologram()
        removeInvisiblePlatform()
        restoreTransparency()

        if camera and h then
            camera.CameraSubject = h
        end

        invisibleStart = nil
        return
    end

    if not c or not r or not h then
        state.invisible = false
        return
    end

    if invisibleActive then return end

    invisibleStart = r.CFrame

    local oldArchivable = c.Archivable
    c.Archivable = true

    local success, copy = pcall(function()
        return c:Clone()
    end)

    c.Archivable = oldArchivable

    if not success or not copy then
        state.invisible = false
        return
    end

    copy.Name = "KHASTIFY_Hologram"

    for _, obj in ipairs(copy:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.Material = Enum.Material.ForceField

            if obj.Name ~= "HumanoidRootPart" then
                obj.Transparency = math.max(obj.Transparency, 0.3)
            end
        end
    end

    copy.Parent = workspace
    copy:PivotTo(c:GetPivot())
    hologram = copy

    for _, obj in ipairs(c:GetDescendants()) do
        if obj:IsA("BasePart") then
            originalTransparency[obj] = obj.LocalTransparencyModifier
            obj.LocalTransparencyModifier = 1
        end
    end

    -- Move the real body beneath the visible character.
    r.CFrame = r.CFrame * CFrame.new(0, -invisibleOffset, 0)
    r.AssemblyLinearVelocity = Vector3.zero

    invisiblePlatform = makePlatform("KHASTIFY_InvisibleSupport")

    invisibleActive = true

    local ghostHumanoid = copy:FindFirstChildOfClass("Humanoid")

    if camera and ghostHumanoid then
        camera.CameraSubject = ghostHumanoid
    end
end

local function updateInvisible()
    if not invisibleActive then return end

    local r = root()
    if not r then return end

    -- Keep the hologram aligned with the moving character.
    if hologram and hologram.Parent then
        hologram:PivotTo(
            r.CFrame * CFrame.new(0, invisibleOffset, 0)
        )
    end

    -- Support the underground body while allowing horizontal movement.
    if invisiblePlatform then
        invisiblePlatform.Position = Vector3.new(
            r.Position.X,
            r.Position.Y - 3.2,
            r.Position.Z
        )
    end
end

-- FLIGHT SYSTEM

local flyVelocity
local flyGyro

local function stopFly()
    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end

    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end

    local h = humanoid()
    if h then h.PlatformStand = false end
end

local function startFly()
    stopFly()

    local r = root()
    local h = humanoid()
    if not r or not h then return end

    h.PlatformStand = true

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyVelocity.Parent = r

    flyGyro = Instance.new("BodyGyro")
    flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyGyro.P = 9000
    flyGyro.Parent = r
end

