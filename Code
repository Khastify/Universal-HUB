local function Dash()
    local r = Root()
    local camera = workspace.CurrentCamera

    if not r or not camera then return end

    local d = camera.CFrame.LookVector
    d = Vector3.new(d.X, 0, d.Z)

    if d.Magnitude < 0.01 then return end

    local velocity = r.AssemblyLinearVelocity

    r.AssemblyLinearVelocity =
        d.Unit * State.dashPower
        + Vector3.new(0, velocity.Y, 0)
end

-- ==========================================
-- INVISIBILITY
-- ==========================================

local OFFSET = 11

local InvisibleActive = false
local VisualAvatar
local InvisibleFloor

local PartPairs = {}
local Transparency = {}

local OriginalCameraSubject
local OriginalCameraType
local OriginalCameraOffset

local FloorY
local LastGroundY

local function RestoreTransparency()
    for p, value in pairs(Transparency) do
        if p and p.Parent then
            p.LocalTransparencyModifier = value
        end
    end

    table.clear(Transparency)
end

local function DestroyInvisible()
    if VisualAvatar then
        VisualAvatar:Destroy()
    end

    if InvisibleFloor then
        InvisibleFloor:Destroy()
    end

    VisualAvatar = nil
    InvisibleFloor = nil

    table.clear(PartPairs)
end

local function PartPath(obj, ancestor)
    local pieces = {}
    local current = obj

    while current and current ~= ancestor do
        local index = 0

        for _, sibling in ipairs(current.Parent:GetChildren()) do
            if sibling.Name == current.Name
                and sibling.ClassName == current.ClassName then

                index += 1

                if sibling == current then
                    break
                end
            end
        end

        table.insert(
            pieces,
            1,
            current.ClassName .. ":"
                .. current.Name .. ":"
                .. index
        )

        current = current.Parent
    end

    return table.concat(pieces, "/")
end

local function MakeVisual()
    local c = Char()
    if not c then return nil end

    local archivable = c.Archivable
    c.Archivable = true

    local ok, clone = pcall(function()
        return c:Clone()
    end)

    c.Archivable = archivable

    if not ok or not clone then
        return nil
    end

    clone.Name = "KHASTIFY_TransparentAvatar"

    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("Script")
            or obj:IsA("LocalScript") then

            obj:Destroy()

        elseif obj:IsA("JointInstance")
            or obj:IsA("WeldConstraint")
            or obj:IsA("Constraint") then

            obj:Destroy()

        elseif obj:IsA("BasePart") then
            obj.Anchored = true

            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false

            obj.CastShadow = false
            obj.LocalTransparencyModifier = 0

            if obj.Name == "HumanoidRootPart" then
                obj.Transparency = 1
            else
                obj.Transparency = math.max(
                    obj.Transparency,
                    0.3
                )
            end

        elseif obj:IsA("Decal")
            or obj:IsA("Texture") then

            obj.Transparency = math.max(
                obj.Transparency,
                0.3
            )

        elseif obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Beam") then

            obj.Enabled = false
        end
    end

    local lookup = {}

    for _, p in ipairs(clone:GetDescendants()) do
        if p:IsA("BasePart") then
            lookup[PartPath(p, clone)] = p
        end
    end

    table.clear(PartPairs)

    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            local matching = lookup[PartPath(p, c)]

            if matching then
                table.insert(PartPairs, {
                    source = p,
                    visual = matching
                })
            end
        end
    end

    clone.Parent = workspace
    return clone
end

local function GroundAt(x, z, referenceY)
    local params = RaycastParams.new()

    params.FilterType = Enum.RaycastFilterType.Exclude

    local excluded = {}

    if Char() then
        table.insert(excluded, Char())
    end

    if VisualAvatar then
        table.insert(excluded, VisualAvatar)
    end

    if InvisibleFloor then
        table.insert(excluded, InvisibleFloor)
    end

    if AirPlatform then
        table.insert(excluded, AirPlatform)
    end

    params.FilterDescendantsInstances = excluded

    local result = workspace:Raycast(
        Vector3.new(x, referenceY + 14, z),
        Vector3.new(0, -32, 0),
        params
    )

    if result and result.Normal.Y > 0.35 then
        return result.Position.Y
    end

    return nil
end

local function SetBodyY(y)
    local c = Char()
    local r = Root()

    if not c or not r then return end

    local delta = y - r.Position.Y

    if math.abs(delta) > 0.001 then
        c:PivotTo(
            c:GetPivot() + Vector3.new(0, delta, 0)
        )
    end
end

local function RestoreCamera()
    local camera = workspace.CurrentCamera
    local h = Hum()

    if h and OriginalCameraOffset then
        h.CameraOffset = OriginalCameraOffset
    end

    if camera then
        camera.CameraType =
            OriginalCameraType or Enum.CameraType.Custom

        if OriginalCameraSubject
            and OriginalCameraSubject.Parent then

            camera.CameraSubject = OriginalCameraSubject

        elseif h then
            camera.CameraSubject = h
        end
    end

    OriginalCameraSubject = nil
    OriginalCameraType = nil
    OriginalCameraOffset = nil
end

local function MirrorAvatar()
    if not InvisibleActive or not VisualAvatar then
        return
    end

    local offset = Vector3.new(0, OFFSET, 0)

    for _, pair in ipairs(PartPairs) do
        if pair.source.Parent and pair.visual.Parent then
            pair.visual.CFrame = pair.source.CFrame + offset
            pair.visual.Size = pair.source.Size
        end
    end
end

local function SetInvisible(enabled)
    local c = Char()
    local r = Root()
    local h = Hum()
    local camera = workspace.CurrentCamera

    if not enabled then
        if InvisibleActive and c then
            c:PivotTo(
                c:GetPivot() + Vector3.new(0, OFFSET, 0)
            )

            if r then
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        end

        InvisibleActive = false

        RestoreCamera()
        DestroyInvisible()
        RestoreTransparency()

        if not State.noclip then
            RestoreCollision()
        end

        FloorY = nil
        LastGroundY = nil

        return
    end

    if InvisibleActive or not c or not r or not h then
        return
    end

    local clone = MakeVisual()

    if not clone then
        State.invisible = false
        return
    end

    VisualAvatar = clone

    if camera then
        OriginalCameraSubject = camera.CameraSubject
        OriginalCameraType = camera.CameraType
    end

    OriginalCameraOffset = h.CameraOffset

    LastGroundY = GroundAt(
        r.Position.X,
        r.Position.Z,
        r.Position.Y
    ) or (r.Position.Y - 3.2)

    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            Transparency[p] = p.LocalTransparencyModifier
        end
    end

    Noclip()

    c:PivotTo(
        c:GetPivot() + Vector3.new(0, -OFFSET, 0)
    )

    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            p.LocalTransparencyModifier = 1
        end
    end

    FloorY = r.Position.Y - 3.2

    InvisibleFloor = Platform(
        "KHASTIFY_InvisibleSupport",
        Vector3.new(14, 0.5, 14)
    )

    InvisibleActive = true
    MirrorAvatar()

    if camera then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = h

        h.CameraOffset =
            OriginalCameraOffset + Vector3.new(0, OFFSET, 0)
    end
end

local function UpdateInvisible()
    if not InvisibleActive then return end

    local r = Root()
    if not r then return end

    Noclip()

    local p = r.Position

    local ground = GroundAt(
        p.X,
        p.Z,
        p.Y + OFFSET
    )

    if ground then
        local difference = ground - LastGroundY

        if (difference >= 0 and difference <= 3.5)
            or (difference < 0 and difference >= -5) then

            SetBodyY(r.Position.Y + difference)
            LastGroundY = ground
        end
    end

    p = r.Position
    FloorY = LastGroundY - OFFSET

    if InvisibleFloor then
        InvisibleFloor.Position = Vector3.new(
            p.X,
            FloorY - 0.25,
            p.Z
        )
    end

    if not State.fly then
        local minimumY = FloorY + 3.2
        local maximumY = LastGroundY - 4.5

        if r.Position.Y < minimumY then
            SetBodyY(minimumY)

            local v = r.AssemblyLinearVelocity

            r.AssemblyLinearVelocity = Vector3.new(
                v.X,
                math.max(0, v.Y),
                v.Z
            )

        elseif r.Position.Y > maximumY then
            SetBodyY(maximumY)

            local v = r.AssemblyLinearVelocity

            r.AssemblyLinearVelocity = Vector3.new(
                v.X,
                math.min(0, v.Y),
                v.Z
            )
        end
    end
end

-- ==========================================
-- CHARACTER UTILITIES
-- ==========================================

local HeadTransparency = {}
local HeadDecals = {}

local function SetHeadless(enabled)
    local c = Char()
    local head = c and c:FindFirstChild("Head")

    if not head then return end

    if enabled then
        if HeadTransparency[head] == nil then
            HeadTransparency[head] =
                head.LocalTransparencyModifier
        end

        head.LocalTransparencyModifier = 1

        for _, obj in ipairs(head:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then
                if HeadDecals[obj] == nil then
                    HeadDecals[obj] = obj.Transparency
                end

                obj.Transparency = 1
            end
        end
    else
        for p, value in pairs(HeadTransparency) do
            if p.Parent then
                p.LocalTransparencyModifier = value
            end
        end

        for p, value in pairs(HeadDecals) do
            if p.Parent then
                p.Transparency = value
            end
        end

        table.clear(HeadTransparency)
        table.clear(HeadDecals)
    end
end

local function Freeze(enabled)
    local r = Root()
    if not r then return end

    r.Anchored = enabled

    if enabled then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

local function Sit()
    local h = Hum()
    if h then h.Sit = true end
end

local function Unstuck()
    local r = Root()
    if not r then return end

    State.freeze = false
    r.Anchored = false

    r.CFrame = r.CFrame + Vector3.new(0, 6, 0)
    r.AssemblyLinearVelocity = Vector3.zero
end

local function Respawn()
    local h = Hum()
    if h then h.Health = 0 end
end

local function SelfFling()
    local r = Root()
    if not r then return end

    r.AssemblyLinearVelocity = Vector3.new(
        math.random(-120, 120),
        100,
        math.random(-120, 120)
    )

    r.AssemblyAngularVelocity = Vector3.new(15, 20, 15)
end

local function Wave()
    local h = Hum()

    if h then
        pcall(function()
            h:PlayEmote("wave")
        end)
    end
end

local OriginalLighting = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    FogEnd = Lighting.FogEnd,
    GlobalShadows = Lighting.GlobalShadows
}

local function Fullbright(enabled)
    if enabled then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1000000
        Lighting.GlobalShadows = false
    else
        for key, value in pairs(OriginalLighting) do
            Lighting[key] = value
        end
    end
end

