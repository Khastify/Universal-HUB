            uiY = state.uiY
        }))
    end)
end

-- MOVEMENT

local collisions = {}

local function restoreCollision()
    for p, original in pairs(collisions) do
        if p and p.Parent then
            p.CanCollide = original
        end
    end
    table.clear(collisions)
end

local flyVelocity
local flyGyro

local function stopFly()
    if flyVelocity then flyVelocity:Destroy() end
    if flyGyro then flyGyro:Destroy() end

    flyVelocity = nil
    flyGyro = nil

    local h = hum()
    if h then h.PlatformStand = false end
end

local function startFly()
    stopFly()

    local r = root()
    local h = hum()
    if not r or not h then return end

    h.PlatformStand = true

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.Name = "KHASTIFY_FlyVelocity"
    flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = r

    flyGyro = Instance.new("BodyGyro")
    flyGyro.Name = "KHASTIFY_FlyGyro"
    flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyGyro.P = 9000
    flyGyro.Parent = r
end

local airPlatform
local airHeight

local function stopAirWalk()
    if airPlatform then airPlatform:Destroy() end
    airPlatform = nil
    airHeight = nil
end

local function startAirWalk()
    stopAirWalk()

    local r = root()
    if not r then return end

    airHeight = r.Position.Y - 3.2

    airPlatform = Instance.new("Part")
    airPlatform.Name = "KHASTIFY_AirWalk"
    airPlatform.Size = Vector3.new(9, 0.5, 9)
    airPlatform.Anchored = true
    airPlatform.Transparency = 1
    airPlatform.CanCollide = true
    airPlatform.CanTouch = false
    airPlatform.CastShadow = false
    airPlatform.Position = Vector3.new(
        r.Position.X,
        airHeight - 0.25,
        r.Position.Z
    )
    airPlatform.Parent = workspace
end

local function dash()
    local r = root()
    local camera = workspace.CurrentCamera
    if not r or not camera then return end

    local direction = camera.CFrame.LookVector
    direction = Vector3.new(direction.X, 0, direction.Z)

    if direction.Magnitude < 0.01 then return end

    direction = direction.Unit

    local current = r.AssemblyLinearVelocity

    r.AssemblyLinearVelocity =
        direction * state.dashPower +
        Vector3.new(0, current.Y, 0)
end

-- CHARACTER

local hologram
local support
local invisibleOffset = 8
local invisibleActive = false
local savedTransparency = {}
local savedHeadTransparency = {}
local savedHeadDecals = {}

local function removePart(p)
    if p then p:Destroy() end
end

local function restoreTransparency()
    for p, value in pairs(savedTransparency) do
        if p and p.Parent then
            p.LocalTransparencyModifier = value
        end
    end
    table.clear(savedTransparency)
end

local function setInvisible(enabled)
    local c = char()
    local r = root()
    local h = hum()
    local camera = workspace.CurrentCamera

    if not enabled then
        if invisibleActive and r then
            r.CFrame = r.CFrame * CFrame.new(0, invisibleOffset, 0)
            r.AssemblyLinearVelocity = Vector3.zero
        end

        invisibleActive = false

        removePart(hologram)
        removePart(support)

        hologram = nil
        support = nil

        restoreTransparency()

        if camera and h then
            camera.CameraSubject = h
        end

        return
    end

    if not c or not r or not h or invisibleActive then return end

    local oldArchivable = c.Archivable
    c.Archivable = true

    local ok, copy = pcall(function()
        return c:Clone()
    end)

    c.Archivable = oldArchivable

    if not ok or not copy then
        state.invisible = false
        return
    end

    copy.Name = "KHASTIFY_Hologram"

    for _, obj in ipairs(copy:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false

            if obj.Name ~= "HumanoidRootPart" then
                obj.Material = Enum.Material.ForceField
                obj.Transparency = math.max(obj.Transparency, 0.35)
            end
        end
    end

    copy.Parent = workspace
    hologram = copy

    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            savedTransparency[p] = p.LocalTransparencyModifier
            p.LocalTransparencyModifier = 1
        end
    end

    r.CFrame = r.CFrame * CFrame.new(0, -invisibleOffset, 0)
    r.AssemblyLinearVelocity = Vector3.zero

    support = Instance.new("Part")
    support.Name = "KHASTIFY_InvisibleSupport"
    support.Size = Vector3.new(8, 0.5, 8)
    support.Transparency = 1
    support.Anchored = true
    support.CanCollide = true
    support.CanTouch = false
    support.Parent = workspace

    invisibleActive = true

    local ghostHum = copy:FindFirstChildOfClass("Humanoid")

    if camera and ghostHum then
        camera.CameraSubject = ghostHum
    end
end

local function updateInvisible()
    if not invisibleActive then return end

    local r = root()
    if not r then return end

    if hologram and hologram.Parent then
        hologram:PivotTo(r.CFrame * CFrame.new(0, invisibleOffset, 0))
    end

    if support then
        support.Position = r.Position - Vector3.new(0, 3.2, 0)
    end
end

local function setHeadless(enabled)
    local c = char()
    if not c then return end

    local head = c:FindFirstChild("Head")
    if not head then return end

    if enabled then
        if savedHeadTransparency[head] == nil then
            savedHeadTransparency[head] = head.LocalTransparencyModifier
        end

        head.LocalTransparencyModifier = 1

        for _, obj in ipairs(head:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then
                if savedHeadDecals[obj] == nil then
                    savedHeadDecals[obj] = obj.Transparency
                end
                obj.Transparency = 1
            end
        end
    else
        for p, value in pairs(savedHeadTransparency) do
            if p and p.Parent then
                p.LocalTransparencyModifier = value
            end
        end

        for p, value in pairs(savedHeadDecals) do
            if p and p.Parent then
                p.Transparency = value
            end
        end

        table.clear(savedHeadTransparency)
        table.clear(savedHeadDecals)
    end
end

local function setFreeze(enabled)
    local r = root()
    if not r then return end

    r.Anchored = enabled

    if enabled then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

local function sit()
    local h = hum()
    if h then h.Sit = true end
end

local function unstuck()
    local r = root()
    if not r then return end

    r.Anchored = false
    state.freeze = false

    r.CFrame = r.CFrame * CFrame.new(0, 6, 0)
    r.AssemblyLinearVelocity = Vector3.zero
end

local function respawn()
    local h = hum()
    if h then h.Health = 0 end
end

local function selfFling()
    local r = root()
    if not r then return end

    r.AssemblyLinearVelocity =
        Vector3.new(
            math.random(-120, 120),
            100,
            math.random(-120, 120)
        )

    r.AssemblyAngularVelocity = Vector3.new(15, 20, 15)
end

