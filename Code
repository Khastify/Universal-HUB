    )

    username.Position = UDim2.fromOffset(63, 34)
    username.Size = UDim2.new(1, -115, 0, 19)

    local arrow = H.Label(card, "›", 24, C.muted)
    arrow.Position = UDim2.new(1, -32, 0, 15)
    arrow.Size = UDim2.fromOffset(20, 32)
    arrow.TextXAlignment = Enum.TextXAlignment.Center

    local click = H.Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 63),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, card)

    local actions = H.Create("Frame", {
        Position = UDim2.fromOffset(12, 74),
        Size = UDim2.new(1, -24, 0, 36),
        BackgroundTransparency = 1
    }, card)

    local function Button(text, index, callback)
        local button = H.Create("TextButton", {
            Position = UDim2.new(
                (index - 1) * 0.34, 0, 0, 0
            ),
            Size = UDim2.new(0.32, 0, 1, 0),
            BackgroundColor3 = C.selected,
            Text = text,
            TextColor3 = C.text,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            AutoButtonColor = false
        }, actions)

        H.Corner(button, 7)
        H.Bind(button.MouseButton1Click, callback)

        return button
    end

    local tp = Button("TP", 1, function()
        local target = player.Character
            and player.Character:FindFirstChild(
                "HumanoidRootPart"
            )

        local c = H.Char()

        if target and c then
            if Spy.active then H.StopSpy() end

            if State.invisible then
                State.invisible = false
                H.SetInvisible(false)
            end

            c:PivotTo(
                target.CFrame * CFrame.new(3, 0, 0)
            )
        end
    end)

    local fling = Button("Fling", 2, function()
        if Spy.active then H.StopSpy() end

        local r = H.Root()
        if not r then return end

        local old = r.AssemblyAngularVelocity

        r.AssemblyAngularVelocity =
            Vector3.new(0, 30, 0)

        task.delay(0.45, function()
            if r.Parent then
                r.AssemblyAngularVelocity = old
            end
        end)
    end)

    local spyButton = Button("Spy", 3, function()
        H.ToggleSpy(player)
    end)

    local data = {
        frame = card,
        spyButton = spyButton,
        expanded = false
    }

    local function Expand(open)
        data.expanded = open

        local color = open and C.selected or C.card
        local buttonColor = open and C.card or C.selected

        tp.BackgroundColor3 = buttonColor
        fling.BackgroundColor3 = buttonColor
        spyButton.BackgroundColor3 = buttonColor
        spyButton.Text = "Spy"

        H.Tween(card, {
            Size = UDim2.new(
                1, 0, 0,
                open and 121 or 63
            ),
            BackgroundColor3 = color
        })

        H.Tween(arrow, {
            Rotation = open and 90 or 0
        })
    end

    data.expand = Expand
    PlayerCards[player.UserId] = data

    H.Bind(click.MouseButton1Click, function()
        ExpandedPlayer =
            ExpandedPlayer == player.UserId
            and nil
            or player.UserId

        for id, entry in pairs(PlayerCards) do
            entry.expand(id == ExpandedPlayer)
        end
    end)

    H.AddEntry(
        card,
        player.DisplayName .. " " .. player.Name,
        "All"
    )

    UpdateSpyButtons()
end

