    state.invisible = false
    state.airWalk = false

    table.clear(originalCollision)
    table.clear(originalTransparency)

    local h = c:WaitForChild("Humanoid", 10)

    if h then
        h.WalkSpeed = state.speed
        h.UseJumpPower = true
        h.JumpPower = state.jump
    end

    task.wait(0.3)

    if state.fly then
        startFly()
    end
end)

