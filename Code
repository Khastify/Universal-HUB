function H.IconFrame(parent, x, y, w, h, color, radius)
    local frame = H.Create("Frame", {
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),
        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parent)

    if radius then H.Corner(frame, radius) end
    return frame
end

function H.IconCircle(parent, x, y, diameter, color, thickness)
    local circle = H.IconFrame(
        parent, x, y, diameter, diameter,
        color, diameter / 2
    )

    if thickness then
        circle.BackgroundTransparency = 1
        H.Stroke(circle, color, thickness)
    end

    return circle
end

function H.IconOutline(parent, x, y, w, h, color, thickness, radius)
    local frame = H.IconFrame(
        parent, x, y, w, h, color, radius or 8
    )

    frame.BackgroundTransparency = 1
    H.Stroke(frame, color, thickness)

    return frame
end

function H.IconLine(parent, x1, y1, x2, y2, color, thickness)
    local dx = x2 - x1
    local dy = y2 - y1
    local length = math.sqrt(dx * dx + dy * dy)

    if length < 0.001 then return end

    local line = H.Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(
            (x1 + x2) / 2,
            (y1 + y2) / 2
        ),
        Size = UDim2.fromOffset(length, thickness),
        Rotation = math.deg(math.atan2(dy, dx)),
        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parent)

    H.Corner(line, thickness / 2)
    return line
end

