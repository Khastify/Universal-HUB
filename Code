function H.WaitForRetry(seconds, generation)
    local remaining = math.ceil(seconds)

    while remaining > 0 do
        if not Alive
            or Active ~= "Servers"
            or generation ~= ServerBrowser.generation then
            return false
        end

        H.SetServerStatus(
            "Rate limited - retrying in "
            .. tostring(remaining) .. "s..."
        )

        task.wait(1)
        remaining -= 1
    end

    return Alive
        and Active == "Servers"
        and generation == ServerBrowser.generation
end

function H.FetchServerPageWithRetry(url, generation)
    for attempt = 1, SERVER_MAX_RETRIES + 1 do
        if not Alive
            or Active ~= "Servers"
            or generation ~= ServerBrowser.generation then
            return nil, "Cancelled"
        end

        local data, err, retryAfter, rateLimited =
            H.RequestServers(url)

        if data then
            ServerBrowser.cooldownUntil = 0
            return data
        end

        if not rateLimited then
            return nil, err
        end

        local delaySeconds = retryAfter or math.min(
            SERVER_INITIAL_BACKOFF * (2 ^ (attempt - 1)),
            SERVER_MAX_BACKOFF
        )

        ServerBrowser.cooldownUntil = math.max(
            ServerBrowser.cooldownUntil,
            os.clock() + delaySeconds
        )

        if attempt > SERVER_MAX_RETRIES then
            ServerBrowser.cooldownUntil = math.max(
                ServerBrowser.cooldownUntil, os.clock() + SERVER_MAX_BACKOFF
            )
            return nil, "Rate limited - retry available after cooldown"
        end

        if not H.WaitForRetry(delaySeconds, generation) then
            return nil, "Cancelled"
        end
    end

    return nil, "Server request failed"
end

local LoadServerPage

LoadServerPage = function(reset)
    if ServerBrowser.loading or Active ~= "Servers" then
        return
    end

    local now = os.clock()

    -- Do not abandon the request during cooldown. Queue a single
    -- delayed attempt instead, preserving the current server list.
    if now < ServerBrowser.cooldownUntil then
        if ServerBrowser.loading then return end
        ServerBrowser.loading = true
        local generation = ServerBrowser.generation
        task.spawn(function()
            while Alive and Active == "Servers"
                and generation == ServerBrowser.generation
                and os.clock() < ServerBrowser.cooldownUntil do
                H.SetServerStatus("Rate limited - retrying in "
                    .. math.ceil(ServerBrowser.cooldownUntil - os.clock()) .. "s")
                task.wait(1)
            end
            if generation == ServerBrowser.generation then
                ServerBrowser.loading = false
                if Alive and Active == "Servers" then
                    LoadServerPage(reset)
                end
            end
        end)
        return
    end

    local generation = ServerBrowser.generation
    local cursor = reset and nil or ServerBrowser.cursor

    ServerBrowser.loading = true

    H.SetServerStatus(
        reset and "Refreshing public servers..."
        or "Loading more public servers..."
    )

    task.spawn(function()
        local data, err = H.FetchServerPageWithRetry(
            H.ServerURL(cursor), generation
        )

        if not Alive
            or Active ~= "Servers"
            or generation ~= ServerBrowser.generation then
            return
        end

        ServerBrowser.loading = false

        if not data then
            if err ~= "Cancelled" then
                H.SetServerStatus(
                    tostring(#ServerBrowser.servers)
                    .. " servers loaded - " .. tostring(err)
                )
            end
            return
        end

        if reset then
            local currentCards = {}

            for key, entry in pairs(ServerBrowser.cards) do
                if entry.current then
                    currentCards[key] = entry
                else
                    H.RemoveEntry(entry.frame)

                    if entry.frame.Parent then
                        entry.frame:Destroy()
                    end
                end
            end

            ServerBrowser.cards = currentCards
            ServerBrowser.servers = {}
            ServerBrowser.expanded = nil
        end

        ServerBrowser.cursor = data.nextPageCursor

        for _, server in ipairs(data.data) do
            if type(server.id) == "string"
                and server.id ~= game.JobId then

                local key =
                    tostring(game.PlaceId) .. ":" .. server.id

                if not ServerBrowser.cards[key] then
                    table.insert(
                        ServerBrowser.servers,
                        server
                    )

                    H.ServerCard(
                        server,
                        #ServerBrowser.servers,
                        false
                    )
                end
            end
        end

        H.SetServerStatus(
            tostring(#ServerBrowser.servers)
            .. " other public servers loaded"
        )

        if ServerBrowser.loadMore then
            ServerBrowser.loadMore.Visible =
                ServerBrowser.cursor ~= nil
                and ServerBrowser.cursor ~= ""
        end

        H.Filter()
    end)
end

