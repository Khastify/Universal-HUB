    }, sidebar)

    sidebarButtons[name] = b

    bind(b.MouseButton1Click, function()
        show(name)
    end)
end

-- COMMANDS

local function executeCommand()
    local cmd = commandInput.Text:lower():match("^%s*(.-)%s*$")
    commandInput.Text = ""

    if cmd == "fly" then
        state.fly = true
        startFly()
    elseif cmd == "unfly" then
        state.fly = false
        stopFly()
    elseif cmd == "noclip" then
        state.noclip = true
    elseif cmd == "clip" then
        state.noclip = false
        restoreCollision()
    elseif cmd == "airwalk" then
        state.airWalk = true
        startAirWalk()
    elseif cmd == "unairwalk" then
        state.airWalk = false
        stopAirWalk()
    elseif cmd == "invisible" then
        state.invisible = true
        setInvisible(true)
    elseif cmd == "visible" then
        state.invisible = false
        setInvisible(false)
    elseif cmd == "dash" then
        dash()
    elseif cmd == "sit" then
        sit()
    elseif cmd == "unstuck" then
        unstuck()
    elseif cmd == "freeze" then
        state.freeze = true
        setFreeze(true)
    elseif cmd == "unfreeze" then
        state.freeze = false
        setFreeze(false)
    elseif cmd == "respawn" then
        respawn()
    elseif cmd == "fling" then
        selfFling()
    elseif cmd == "fullbright" then
        state.fullbright = true
        fullbright(true)
    elseif cmd == "normal" then
        state.fullbright = false
        fullbright(false)
    end

    if active == "Commands" then
        show("Commands")
    end
end

bind(send.MouseButton1Click, executeCommand)

bind(commandInput.FocusLost, function(enter)
    if enter then executeCommand() end
end)

bind(close.MouseButton1Click, function()
    window.Visible = false
end)

bind(minimize.MouseButton1Click, function()
    window.Visible = false
end)

-- DRAGGING

local dragging = false
local dragStart
local startPosition

bind(topbar.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = window.Position
    end
end)

bind(UIS.InputChanged, function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart

        window.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

bind(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false

        local camera = workspace.CurrentCamera
        if camera then
            local size = camera.ViewportSize

            state.uiX = math.clamp(
                (window.AbsolutePosition.X + 217) / size.X,
                0, 1
            )

            state.uiY = math.clamp(
                (window.AbsolutePosition.Y + 235) / size.Y,
                0, 1
            )

            save()
        end
    end
end)

-- INPUT

bind(UIS.InputBegan, function(input, processed)
    if processed or UIS:GetFocusedTextBox() then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode.Name == state.menuKey then
            window.Visible = not window.Visible
        end

        if input.KeyCode == Enum.KeyCode.Space and state.infiniteJump then
            local h = hum()
            if h then
                h:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end

        if input.KeyCode == Enum.KeyCode.Q then
            dash()
        end
    end

    if state.clickTP and
        input.UserInputType == Enum.UserInputType.MouseButton1 then

        local pos = UIS:GetMouseLocation()
        local overUI = false

        for _, obj in ipairs(
            parent:GetGuiObjectsAtPosition(pos.X, pos.Y)
        ) do
            if obj:IsDescendantOf(gui) then
                overUI = true
                break
            end
        end

        if not overUI then
            local camera = workspace.CurrentCamera
            local r = root()

            if camera and r then
                local ray = camera:ViewportPointToRay(pos.X, pos.Y)

                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude

                local exclude = {}

                if char() then table.insert(exclude, char()) end
                if hologram then table.insert(exclude, hologram) end
                if airPlatform then table.insert(exclude, airPlatform) end
                if support then table.insert(exclude, support) end

                params.FilterDescendantsInstances = exclude

                local hit = workspace:Raycast(
                    ray.Origin,
                    ray.Direction * 10000,
                    params
                )

                if hit then
                    if state.invisible then
                        setInvisible(false)
                        state.invisible = false
                    end

                    r.CFrame = CFrame.new(
                        hit.Position + Vector3.new(0, 3.5, 0)
                    )

                    if state.airWalk then
                        startAirWalk()
                    end
                end
            end
        end
    end
end)

-- CONTINUOUS UPDATES

bind(Run.Stepped, function()
    if (state.noclip or state.invisible) and char() then
        for _, p in ipairs(char():GetDescendants()) do
            if p:IsA("BasePart") then
                if collisions[p] == nil then
                    collisions[p] = p.CanCollide
                end

                p.CanCollide = false
            end
        end
    end
end)

bind(Run.Heartbeat, function()
    local r = root()

    if state.airWalk and airPlatform and r then
        airPlatform.Position = Vector3.new(
            r.Position.X,
            airHeight - 0.25,
            r.Position.Z
        )
    end

    if state.invisible then
        updateInvisible()
    end
end)

bind(Run.RenderStepped, function()
    if state.fly and flyVelocity and flyGyro then
        local camera = workspace.CurrentCamera
        if not camera then return end

        local cf = camera.CFrame
        local direction = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            direction += cf.LookVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.S) then
            direction -= cf.LookVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.D) then
            direction += cf.RightVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.A) then
            direction -= cf.RightVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end

        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        flyVelocity.Velocity =
            (direction.Magnitude > 0 and direction.Unit or Vector3.zero)
            * state.flySpeed

        flyGyro.CFrame = cf
    end
end)

