local function create(class, props, parentObj)
    local obj = Instance.new(class)

    for key, value in pairs(props or {}) do
        obj[key] = value
    end

    obj.Parent = parentObj
    return obj
end

local function corner(obj, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, obj)
end

local function stroke(obj, color, thickness)
    return create("UIStroke", {
        Color = color or C.border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, obj)
end

local function label(parentObj, value, size, color, weight)
    local fonts = {
        regular = Enum.Font.Gotham,
        medium = Enum.Font.GothamMedium,
        bold = Enum.Font.GothamBold
    }

    return create("TextLabel", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,

        Text = value,
        TextColor3 = color or C.text,

        Font = fonts[weight or "regular"],
        TextSize = size or 12,

        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,

        TextTruncate = Enum.TextTruncate.AtEnd
    }, parentObj)
end

-- ==========================================
-- V15 ICON SYSTEM
-- ==========================================
-- Rounded endpoints, thicker strokes.
-- Same renderer for sidebar and headings.

local function iconLine(parentObj, x1, y1, x2, y2, color, thickness)
    local dx = x2 - x1
    local dy = y2 - y1

    local length = math.sqrt(dx * dx + dy * dy)

    local obj = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),

        Position = UDim2.fromOffset(
            (x1 + x2) / 2,
            (y1 + y2) / 2
        ),

        Size = UDim2.fromOffset(
            length,
            thickness or 2
        ),

        Rotation = math.deg(math.atan2(dy, dx)),

        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parentObj)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, obj)

    return obj
end

local function iconDot(parentObj, x, y, radius, color)
    local obj = create("Frame", {
        Position = UDim2.fromOffset(
            x - radius,
            y - radius
        ),

        Size = UDim2.fromOffset(
            radius * 2,
            radius * 2
        ),

        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parentObj)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, obj)

    return obj
end

local function iconCircle(parentObj, x, y, radius, color)
    local obj = create("Frame", {
        Position = UDim2.fromOffset(
            x - radius,
            y - radius
        ),

        Size = UDim2.fromOffset(
            radius * 2,
            radius * 2
        ),

        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, parentObj)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, obj)

    stroke(obj, color, 1.8)

    return obj
end

local function iconRect(parentObj, x, y, w, h, color, radius)
    local obj = create("Frame", {
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),

        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, parentObj)

    corner(obj, radius or 3)
    stroke(obj, color, 1.8)

    return obj
end

local function iconCurve(parentObj, points, color, thickness)
    for i = 1, #points - 1 do
        local a = points[i]
        local b = points[i + 1]

        iconLine(
            parentObj,
            a.X, a.Y,
            b.X, b.Y,
            color,
            thickness
        )
    end

    for _, point in ipairs(points) do
        iconDot(
            parentObj,
            point.X,
            point.Y,
            (thickness or 2) / 2,
            color
        )
    end
end

local function drawIcon(parentObj, kind, color)
