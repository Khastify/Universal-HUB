local ICON_SIZE = 120
local ICON_SCALE = 0.25

local function IconFrame(parent, x, y, w, h, color, radius)
    local frame = Create("Frame", {
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),
        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parent)

    if radius then Corner(frame, radius) end
    return frame
end

local function IconCircle(parent, x, y, diameter, color, thickness)
    local circle = IconFrame(
        parent, x, y, diameter, diameter,
        color, diameter / 2
    )

    if thickness then
        circle.BackgroundTransparency = 1
        Stroke(circle, color, thickness)
    end

    return circle
end

local function IconOutline(parent, x, y, w, h, color, thickness, radius)
    local frame = IconFrame(parent, x, y, w, h, color, radius or 8)
    frame.BackgroundTransparency = 1
    Stroke(frame, color, thickness)
    return frame
end

local function IconLine(parent, x1, y1, x2, y2, color, thickness)
    local dx, dy = x2 - x1, y2 - y1
    local length = math.sqrt(dx * dx + dy * dy)
    if length < 0.001 then return end

    local line = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset((x1+x2)/2, (y1+y2)/2),
        Size = UDim2.fromOffset(length, thickness),
        Rotation = math.deg(math.atan2(dy, dx)),
        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parent)

    Corner(line, thickness / 2)
    return line
end

-- Continuous-looking native GUI stroke.
-- Each line overlaps its neighbor slightly.
local function PathLine(parent, x1, y1, x2, y2, color, thickness)
    local dx, dy = x2-x1, y2-y1
    local length = math.sqrt(dx*dx + dy*dy)
    if length < 0.001 then return end

    local overlap = 0.75
    local ux, uy = dx/length, dy/length

    local ax = x1 - ux*overlap
    local ay = y1 - uy*overlap
    local bx = x2 + ux*overlap
    local by = y2 + uy*overlap

    return Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset((ax+bx)/2, (ay+by)/2),
        Size = UDim2.fromOffset(length+overlap*2, thickness),
        Rotation = math.deg(math.atan2(dy, dx)),
        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parent)
end

local function PathDot(parent, x, y, color, diameter)
    return IconCircle(
        parent,
        x-diameter/2,
        y-diameter/2,
        diameter,
        color
    )
end

local function DrawPath(parent, points, color, thickness, closed, rounded)
    for i = 1, #points - 1 do
        local a, b = points[i], points[i+1]
        PathLine(parent, a[1], a[2], b[1], b[2], color, thickness)
    end

    if closed and #points > 2 then
        local a, b = points[#points], points[1]
        PathLine(parent, a[1], a[2], b[1], b[2], color, thickness)
    end

    if rounded then
        for _, p in ipairs(points) do
            PathDot(parent, p[1], p[2], color, thickness)
        end
    end
end

local function DrawArc(
    parent, cx, cy, rx, ry,
    startAngle, endAngle, color, thickness, steps
)
    local points = {}

    for i = 0, steps do
        local angle = startAngle
            + (endAngle-startAngle)*i/steps

        points[#points+1] = {
            cx + math.cos(angle)*rx,
            cy + math.sin(angle)*ry
        }
    end

    DrawPath(parent, points, color, thickness, false, false)
    return points
end

