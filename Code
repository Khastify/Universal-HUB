Bind(Run.Heartbeat, function(dt)
    local r = Root()

    if State.airWalk and AirPlatform and r then
        AirPlatform.Position = Vector3.new(
            r.Position.X,
            AirHeight - 0.25,
            r.Position.Z
        )
    end

    if State.invisible then
        UpdateInvisible()
    end

    if Spy.active then
        local c = Spy.savedCharacter
        local spyRoot = Spy.savedRoot

        if c and c.Parent
            and spyRoot and spyRoot.Parent
            and Spy.savedPivot then

            local undergroundPivot =
                Spy.savedPivot + Vector3.new(0, -OFFSET, 0)

            if (
                c:GetPivot().Position
                - undergroundPivot.Position
            ).Magnitude > 0.1 then

                c:PivotTo(undergroundPivot)
            end

            if not spyRoot.Anchored then
                spyRoot.Anchored = true
            end

            spyRoot.AssemblyLinearVelocity = Vector3.zero
            spyRoot.AssemblyAngularVelocity = Vector3.zero
        end

        if not Spy.target or not Spy.target.Parent then
            StopSpy()
        end
    end

    -- Camera-based nametags.

    NametagSystem.elapsed += dt

    if NametagSystem.elapsed >= 0.05 then
        NametagSystem.elapsed = 0
        UpdateNametags()
    end

    if Active == "Servers" then
        local key =
            tostring(game.PlaceId) .. ":" .. game.JobId

        local data = ServerBrowser.cards[key]

        if data
            and data.population
            and data.population.Parent then

            local value =
                tostring(#Players:GetPlayers())
                .. "/"
                .. tostring(Players.MaxPlayers)
                .. " Players"

            if data.population.Text ~= value then
                data.population.Text = value
            end
        end
    end
end)

Bind(Run.RenderStepped, function()
    if State.invisible then
        MirrorAvatar()
    end

    if State.fly and FlyVelocity and FlyGyro then
        local camera = workspace.CurrentCamera
        if not camera then return end

        local cf = camera.CFrame
        local direction = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            direction += cf.LookVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.S) then
            direction -= cf.LookVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.D) then
            direction += cf.RightVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.A) then
            direction -= cf.RightVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end

        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        FlyVelocity.Velocity =
            (
                direction.Magnitude > 0
                and direction.Unit
                or Vector3.zero
            ) * State.flySpeed

        FlyGyro.CFrame = cf
    end
end)

