-- ==========================================
-- DRAGGING
-- ==========================================

local dragging = false
local dragStart
local startPosition

bind(topbar.InputBegan, function(input)
    if input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        dragging = true
        dragStart = input.Position
        startPosition = window.Position
    end
end)

bind(UIS.InputChanged, function(input)
    if dragging
        and input.UserInputType ==
        Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        window.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,

            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

bind(UIS.InputEnded, function(input)
    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        and dragging then

        dragging = false

        local camera = workspace.CurrentCamera

        if camera then
            local size = camera.ViewportSize

            if size.X > 0 and size.Y > 0 then
                state.uiX = math.clamp(
                    (window.AbsolutePosition.X + WIDTH / 2)
                    / size.X,
                    0,
                    1
                )

                state.uiY = math.clamp(
                    (window.AbsolutePosition.Y + HEIGHT / 2)
                    / size.Y,
                    0,
                    1
                )

                save()
            end
        end
    end
end)

-- ==========================================
-- INPUT
-- ==========================================

bind(UIS.InputBegan, function(input, processed)
    if changingHotkey then
        if input.UserInputType ==
            Enum.UserInputType.Keyboard then

            changingHotkey = false

            if input.KeyCode ~= Enum.KeyCode.Escape
                and input.KeyCode ~= Enum.KeyCode.Unknown then

                state.menuKey = input.KeyCode.Name
                save()
            end

            showSection("Settings")
        end

        return
    end

    if processed or UIS:GetFocusedTextBox() then
        return
    end

    if input.UserInputType ==
        Enum.UserInputType.Keyboard then

        if input.KeyCode.Name == state.menuKey then
            window.Visible = not window.Visible
        end

        if input.KeyCode == Enum.KeyCode.Space
            and state.infiniteJump then

            local h = hum()

            if h then
                h:ChangeState(
                    Enum.HumanoidStateType.Jumping
                )
            end
        end

        if input.KeyCode == Enum.KeyCode.Q then
            dash()
        end
    end

    if state.clickTP
        and input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        local position = UIS:GetMouseLocation()

        local x = window.AbsolutePosition.X
        local y = window.AbsolutePosition.Y
        local w = window.AbsoluteSize.X
        local h = window.AbsoluteSize.Y

        local overUI =
            window.Visible
            and position.X >= x
            and position.X <= x + w
            and position.Y >= y
            and position.Y <= y + h

        if not overUI then
            local camera = workspace.CurrentCamera
            local r = root()

            if camera and r then
                local ray = camera:ViewportPointToRay(
                    position.X,
                    position.Y
                )

                local params = RaycastParams.new()

                params.FilterType =
                    Enum.RaycastFilterType.Exclude

                local excluded = {}

                if char() then
                    table.insert(excluded, char())
                end

                if visualAvatar then
                    table.insert(excluded, visualAvatar)
                end

                if invisibleFloor then
                    table.insert(excluded, invisibleFloor)
                end

                if airPlatform then
                    table.insert(excluded, airPlatform)
                end

                params.FilterDescendantsInstances = excluded

                local hit = workspace:Raycast(
                    ray.Origin,
                    ray.Direction * 10000,
                    params
                )

                if hit then
                    if state.invisible then
                        state.invisible = false
                        setInvisible(false)
                    end

                    local c = char()

                    if c then
                        c:PivotTo(
                            CFrame.new(
                                hit.Position
                                    + Vector3.new(0, 3.5, 0)
                            )
                        )
                    end

                    if state.airWalk then
                        startAirWalk()
                    end
                end
            end
        end
    end
end)

-- ==========================================
-- CONTINUOUS UPDATES
-- ==========================================

bind(Run.Stepped, function()
    if state.noclip or state.invisible then
        noclip()
    end
end)

bind(Run.Heartbeat, function()
    local r = root()

    if state.airWalk and airPlatform and r then
        airPlatform.Position = Vector3.new(
            r.Position.X,
            airHeight - 0.25,
            r.Position.Z
        )
    end

    if state.invisible then
        updateInvisible()
    end
end)

bind(Run.RenderStepped, function()
    if state.invisible then
        mirrorAvatar()
    end

    if state.fly and flyVelocity and flyGyro then
        local camera = workspace.CurrentCamera

        if not camera then return end

        local cf = camera.CFrame
        local direction = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            direction += cf.LookVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.S) then
            direction -= cf.LookVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.D) then
            direction += cf.RightVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.A) then
            direction -= cf.RightVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end

        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        flyVelocity.Velocity =
            (direction.Magnitude > 0
                and direction.Unit
                or Vector3.zero)
            * state.flySpeed

        flyGyro.CFrame = cf
    end
end)

