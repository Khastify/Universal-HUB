local function LoaderSource()
    return [[
repeat task.wait() until game:IsLoaded()
local Players = game:GetService("Players")
repeat task.wait() until Players.LocalPlayer

if not _G.KHASTIFY_HUB_AUTO_RUNNING then
    _G.KHASTIFY_HUB_AUTO_RUNNING = true

    local ok, err = pcall(function()
        loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/Khastify/Universal-HUB/main/Code"
        ))()
    end)

    _G.KHASTIFY_HUB_AUTO_RUNNING = false

    if not ok then
        warn("[KHASTIFY AUTO EXECUTE]", err)
    end
end
]]
end

local function InstallStartupLoader()
    if type(writefile) ~= "function"
        or type(isfolder) ~= "function" then
        return false
    end

    for _, folder in ipairs({"autoexec", "Autoexec"}) do
        local exists = false
        pcall(function() exists = isfolder(folder) end)

        if exists then
            local ok = pcall(function()
                writefile(
                    folder .. "/" .. AUTOEXEC_FILENAME,
                    LoaderSource()
                )
            end)

            if ok then
                AutoExecute.startupInstalled = true
                return true
            end
        end
    end

    return false
end

local function RemoveStartupLoader()
    if type(delfile) ~= "function" then return end

    for _, folder in ipairs({"autoexec", "Autoexec"}) do
        local path = folder .. "/" .. AUTOEXEC_FILENAME

        pcall(function()
            if type(isfile) == "function" and isfile(path) then
                delfile(path)
            end
        end)
    end

    AutoExecute.startupInstalled = false
end

local function QueueNextTeleport()
    if not State.autoExecute then return false end
    if type(QueueTeleport) ~= "function" then return false end

    local ok = pcall(function()
        QueueTeleport(LoaderSource())
    end)

    AutoExecute.teleportSupported = ok
    return ok
end

local function ConfigureAutoExecute(enabled)
    State.autoExecute = enabled
    Save()

    if enabled then
        local startup = InstallStartupLoader()
        local teleport = QueueNextTeleport()

        if startup and teleport then
            AutoExecute.status = "Startup and teleport enabled"
        elseif startup then
            AutoExecute.status = "Startup enabled"
        elseif teleport then
            AutoExecute.status = "Teleport only"
        else
            AutoExecute.status = "Executor setup required"
        end
    else
        RemoveStartupLoader()
        AutoExecute.status = "Disabled"
    end

    return AutoExecute.status
end

if State.autoExecute then
    ConfigureAutoExecute(true)
end

