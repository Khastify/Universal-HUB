    cooldownUntil = 0
}

local SERVER_REFRESH_COOLDOWN = 15
local SERVER_MAX_RETRIES = 4
local SERVER_INITIAL_BACKOFF = 3
local SERVER_MAX_BACKOFF = 45

local function GetRequestFunction()
    return
        (type(request) == "function" and request)
        or (type(http_request) == "function" and http_request)
        or (syn and syn.request)
        or (http and http.request)
end

local function HeaderValue(headers, wanted)
    if type(headers) ~= "table" then return nil end

    for key, value in pairs(headers) do
        if tostring(key):lower() == wanted:lower() then
            return value
        end
    end

    return nil
end

local function RequestServers(url)
    local requestFunction = GetRequestFunction()

    if type(requestFunction) ~= "function" then
        return nil, "HTTP requests unsupported", nil, false
    end

    local ok, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET",
            Headers = {["Accept"] = "application/json"}
        })
    end)

    if not ok then
        return nil, tostring(response), nil, false
    end

    if type(response) ~= "table" then
        return nil, "Invalid response", nil, false
    end

    local status = tonumber(response.StatusCode or response.Status)

    if status == 429 then
        local retryAfter = HeaderValue(
            response.Headers or response.headers,
            "Retry-After"
        )

        local seconds = tonumber(retryAfter)
        if seconds then
            seconds = math.clamp(seconds, 1, 120)
        end

        return nil, "HTTP 429", seconds, true
    end

    if status and status ~= 200 then
        return nil, "HTTP "..tostring(status), nil, false
    end

    local decodedOk, decoded = pcall(function()
        return HttpService:JSONDecode(
            response.Body or response.body
        )
    end)

    if not decodedOk
        or type(decoded) ~= "table"
        or type(decoded.data) ~= "table" then
        return nil, "Invalid server data", nil, false
    end

    return decoded, nil, nil, false
end

local function ServerURL(cursor)
    local url =
        "https://games.roblox.com/v1/games/"
        .. tostring(game.PlaceId)
        .. "/servers/Public?sortOrder=Desc&limit=100"

    if cursor and cursor ~= "" then
        url ..= "&cursor="..HttpService:UrlEncode(cursor)
    end

    return url
end

local function JoinServer(placeId, jobId)
    if type(placeId) ~= "number"
        or type(jobId) ~= "string"
        or jobId == "" then
        return false, "Invalid server"
    end

    return pcall(function()
        TeleportService:TeleportToPlaceInstance(
            placeId, jobId, LP
        )
    end)
end

