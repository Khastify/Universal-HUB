-- Client-side utility panel. Behavior depends on the Roblox experience.
local Players=game:GetService('Players')
local UIS=game:GetService('UserInputService')
local Run=game:GetService('RunService')
local Lighting=game:GetService('Lighting')
local LP=Players.LocalPlayer
local mouse=LP:GetMouse()
local guiParent=(gethui and gethui()) or LP:WaitForChild('PlayerGui')
local old=guiParent:FindFirstChild('KhastifyUniversalHub')
if old then old:Destroy() end
if _G.KHASTIFY_HUB_CLEANUP then pcall(_G.KHASTIFY_HUB_CLEANUP) end
local connections={}
local function bind(signal,fn) local c=signal:Connect(fn);table.insert(connections,c);return c end
local state={noclip=false,fly=false,invisible=false,clickTP=false,infiniteJump=false,fullbright=false,speed=16,jump=50,menuKey='K',uiX=.5,uiY=.5}
local saveName='KHASTIFY_Universal_Hub_Settings.json'
local HttpService=game:GetService('HttpService')
if type(readfile)=='function' then pcall(function() local data=HttpService:JSONDecode(readfile(saveName));for k,v in pairs(data) do if state[k]~=nil and type(v)==type(state[k]) then state[k]=v end end end) end
local function save() if type(writefile)=='function' then pcall(function() writefile(saveName,HttpService:JSONEncode({speed=state.speed,jump=state.jump,menuKey=state.menuKey,uiX=state.uiX,uiY=state.uiY})) end) end end
local function char()return LP.Character end
local function hum()local c=char();return c and c:FindFirstChildOfClass('Humanoid') end
local function root()local c=char();return c and c:FindFirstChild('HumanoidRootPart') end
local originalCollision={}
local originalTransparency={}
local function restoreNoclip()for p,value in pairs(originalCollision) do if p and p.Parent then p.CanCollide=value end end;table.clear(originalCollision) end
local function restoreInvisible()for p,value in pairs(originalTransparency) do if p and p.Parent then p.LocalTransparencyModifier=value end end;table.clear(originalTransparency) end
local function setInvisible(on)restoreInvisible();if on and char() then for _,p in ipairs(char():GetDescendants()) do if p:IsA('BasePart') then originalTransparency[p]=p.LocalTransparencyModifier;p.LocalTransparencyModifier=1 end end end end
local flyVelocity,flyGyro
local function stopFly()if flyVelocity then flyVelocity:Destroy();flyVelocity=nil end;if flyGyro then flyGyro:Destroy();flyGyro=nil end;local h=hum();if h then h.PlatformStand=false end end
local function startFly()stopFly();local r=root();local h=hum();if not(r and h) then return end;h.PlatformStand=true;flyVelocity=Instance.new('BodyVelocity');flyVelocity.MaxForce=Vector3.new(1e9,1e9,1e9);flyVelocity.Velocity=Vector3.zero;flyVelocity.Parent=r;flyGyro=Instance.new('BodyGyro');flyGyro.MaxTorque=Vector3.new(1e9,1e9,1e9);flyGyro.P=9000;flyGyro.Parent=r end
local oldLighting={Brightness=Lighting.Brightness,ClockTime=Lighting.ClockTime,FogEnd=Lighting.FogEnd,GlobalShadows=Lighting.GlobalShadows}
local function setFullbright(on)if on then Lighting.Brightness=3;Lighting.ClockTime=14;Lighting.FogEnd=1e6;Lighting.GlobalShadows=false else for k,v in pairs(oldLighting) do Lighting[k]=v end end end
local gui=Instance.new('ScreenGui');gui.Name='KhastifyUniversalHub';gui.ResetOnSpawn=false;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;gui.Parent=guiParent
local function ui(class,props,parent)local x=Instance.new(class);for k,v in pairs(props) do x[k]=v end;x.Parent=parent;return x end
local C={bg=Color3.fromRGB(8,9,14),side=Color3.fromRGB(12,13,20),card=Color3.fromRGB(16,17,25),edge=Color3.fromRGB(33,34,47),text=Color3.fromRGB(231,229,245),muted=Color3.fromRGB(120,119,143),purple=Color3.fromRGB(142,77,244)}
local bg=ui('Frame',{Name='Window',Size=UDim2.fromOffset(435,470),Position=UDim2.new(.5,-217,.5,-235),BackgroundColor3=C.bg,BorderSizePixel=0},gui)
bg.Position=UDim2.new(math.clamp(state.uiX,0,1),-217,math.clamp(state.uiY,0,1),-235)
ui('UICorner',{CornerRadius=UDim.new(0,8)},bg);ui('UIStroke',{Color=C.edge,Thickness=1},bg)
local sidebar=ui('Frame',{Size=UDim2.fromOffset(118,470),BackgroundColor3=C.side,BorderSizePixel=0},bg)
ui('UICorner',{CornerRadius=UDim.new(0,8)},sidebar)
ui('Frame',{Position=UDim2.new(1,-1,0,0),Size=UDim2.new(0,1,1,0),BackgroundColor3=C.edge,BorderSizePixel=0},sidebar)
local header=ui('TextLabel',{Size=UDim2.fromOffset(118,43),BackgroundTransparency=1,Text='KHASTIFY  v2',TextColor3=C.text,Font=Enum.Font.GothamBold,TextSize=11},sidebar)
local topbar=ui('Frame',{Position=UDim2.fromOffset(118,0),Size=UDim2.new(1,-118,0,39),BackgroundTransparency=1},bg)
local title=ui('TextLabel',{Position=UDim2.fromOffset(12,0),Size=UDim2.new(1,-78,1,0),BackgroundTransparency=1,Text='Commands',TextXAlignment=Enum.TextXAlignment.Left,TextColor3=C.text,Font=Enum.Font.GothamBold,TextSize=13},topbar)
local close=ui('TextButton',{Position=UDim2.new(1,-27,0,8),Size=UDim2.fromOffset(19,20),BackgroundTransparency=1,Text='×',TextColor3=C.muted,Font=Enum.Font.GothamBold,TextSize=18},topbar)
local minimize=ui('TextButton',{Position=UDim2.new(1,-52,0,8),Size=UDim2.fromOffset(19,20),BackgroundTransparency=1,Text='−',TextColor3=C.muted,Font=Enum.Font.GothamBold,TextSize=17},topbar)
local content=ui('ScrollingFrame',{Position=UDim2.fromOffset(130,44),Size=UDim2.new(1,-142,1,-90),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=2,ScrollBarImageColor3=C.purple,CanvasSize=UDim2.fromOffset(0,0)},bg)
local list=ui('UIListLayout',{Padding=UDim.new(0,6)},content)
bind(list:GetPropertyChangedSignal('AbsoluteContentSize'),function()content.CanvasSize=UDim2.fromOffset(0,list.AbsoluteContentSize.Y+10)end)
local commandBar=ui('Frame',{Position=UDim2.new(0,129,1,-39),Size=UDim2.new(1,-140,0,31),BackgroundColor3=C.card,BorderSizePixel=0},bg)
ui('UICorner',{CornerRadius=UDim.new(0,5)},commandBar);ui('UIStroke',{Color=C.edge,Thickness=1},commandBar)
local commandInput=ui('TextBox',{Position=UDim2.fromOffset(8,0),Size=UDim2.new(1,-44,1,0),BackgroundTransparency=1,Text='',PlaceholderText='›  command...',PlaceholderColor3=C.muted,TextColor3=C.text,ClearTextOnFocus=false,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left},commandBar)
local send=ui('TextButton',{Position=UDim2.new(1,-29,0,3),Size=UDim2.fromOffset(25,25),BackgroundTransparency=1,Text='➤',TextColor3=C.purple,Font=Enum.Font.GothamBold,TextSize=16},commandBar)
local sections={};local active='Commands';local sidebarButtons={}
local function clear()for _,c in ipairs(content:GetChildren()) do if c~=list then c:Destroy() end end end
local function label(t)
 return ui('TextLabel',{Size=UDim2.new(1,-4,0,25),BackgroundTransparency=1,Text=t,TextColor3=C.muted,TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.GothamBold,TextSize=11},content)
end
local function button(text,parent,callback)
 local b=ui('TextButton',{Size=UDim2.new(1,-4,0,33),BackgroundColor3=C.card,Text='  '..text,TextXAlignment=Enum.TextXAlignment.Left,TextColor3=C.text,Font=Enum.Font.Gotham,TextSize=11,AutoButtonColor=true,BorderSizePixel=0},parent)
 ui('UICorner',{CornerRadius=UDim.new(0,5)},b);ui('UIStroke',{Color=C.edge,Thickness=.7},b)
 bind(b.MouseButton1Click,function()callback(b)end);return b
end
local function toggle(text,key,fn)
 local b;b=button(text..'     '..(state[key] and 'ON' or 'OFF'),content,function()
  state[key]=not state[key];b.Text='  '..text..'     '..(state[key] and 'ON' or 'OFF');if fn then fn(state[key]) end
 end)
end
local function slider(text,key,min,max,callback)
 local row=ui('Frame',{Size=UDim2.new(1,-4,0,54),BackgroundColor3=C.card,BorderSizePixel=0},content);ui('UICorner',{CornerRadius=UDim.new(0,5)},row)
 local t=ui('TextLabel',{Position=UDim2.fromOffset(8,3),Size=UDim2.new(1,-16,0,23),BackgroundTransparency=1,Text=text..'   '..state[key],TextXAlignment=Enum.TextXAlignment.Left,TextColor3=C.text,Font=Enum.Font.Gotham,TextSize=11},row)
 local track=ui('Frame',{Position=UDim2.new(0,9,0,37),Size=UDim2.new(1,-18,0,5),BackgroundColor3=C.edge,BorderSizePixel=0},row);ui('UICorner',{CornerRadius=UDim.new(1,0)},track)
 local fill=ui('Frame',{Size=UDim2.fromScale(math.clamp((state[key]-min)/(max-min),0,1),1),BackgroundColor3=C.purple,BorderSizePixel=0},track);ui('UICorner',{CornerRadius=UDim.new(1,0)},fill)
 local dragging=false
 local function update(x)local ratio=math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1);state[key]=math.floor(min+(max-min)*ratio+.5);fill.Size=UDim2.fromScale(ratio,1);t.Text=text..'   '..state[key];callback(state[key]);save()end
 bind(track.InputBegan,function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=true;update(i.Position.X)end end)
 bind(UIS.InputChanged,function(i)if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch)then update(i.Position.X)end end)
 bind(UIS.InputEnded,function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=false end end)
end
local function playerList()local names={};for _,p in ipairs(Players:GetPlayers())do if p~=LP then table.insert(names,p)end end;table.sort(names,function(a,b)return a.Name:lower()<b.Name:lower()end);return names end
sections.Commands=function()
 label('COMMANDS  /  QUICK ACTIONS')
 button('fly  •  Toggle flight',content,function()state.fly=not state.fly;if state.fly then startFly()else stopFly()end end)
 button('noclip  •  Toggle collisions',content,function()state.noclip=not state.noclip;if not state.noclip then restoreNoclip()end end)
 button('invisible  •  Local invisibility',content,function()state.invisible=not state.invisible;setInvisible(state.invisible)end)
 button('fullbright  •  Lighting',content,function()state.fullbright=not state.fullbright;setFullbright(state.fullbright)end)
 label('Type fly, unfly, noclip, clip, invisible, visible, fullbright, normal, or rejoin below.')
end
sections['Voice Chat']=function()label('VOICE CHAT');label('Voice chat controls will be added in a future update.')end
sections.Players=function()
 label('PLAYERS  /  TELEPORT')
 button('Refresh player list',content,function()sections.Players()end)
 for _,p in ipairs(playerList())do button(p.DisplayName..'  (@'..p.Name..')   → TP',content,function()local r=root();local target=p.Character and p.Character:FindFirstChild('HumanoidRootPart');if r and target then r.CFrame=target.CFrame*CFrame.new(3,0,0)end end)end
end
sections.Actions=function()
 label('ACTIONS  /  MOVEMENT')
 toggle('Noclip','noclip',function(on)if not on then restoreNoclip()end end)
 toggle('Fly (WASD / Space / Ctrl)','fly',function(on)if on then startFly()else stopFly()end end)
 toggle('Infinite Jump','infiniteJump')
 toggle('Ctrl + Click TP','clickTP')
 slider('WalkSpeed','speed',0,200,function(v)local h=hum();if h then h.WalkSpeed=v end end)
 slider('JumpPower','jump',0,200,function(v)local h=hum();if h then h.UseJumpPower=true;h.JumpPower=v end end)
end
sections['ESV Users']=function()label('HUB USERS');label('Cross-player hub discovery is not available yet.')end
sections.Nametags=function()label('NAMETAGS');label('Nametag options coming later.')end
sections.Shaders=function()label('SHADERS  /  VISUALS');toggle('Fullbright','fullbright',setFullbright)end
sections['Local Player']=function()label('LOCAL PLAYER');toggle('Local invisibility','invisible',setInvisible);toggle('Infinite Jump','infiniteJump');toggle('Click TP','clickTP');slider('WalkSpeed','speed',0,200,function(v)local h=hum();if h then h.WalkSpeed=v end end)end
sections.Servers=function()label('SERVERS');button('Rejoin current server',content,function()pcall(function()game:GetService('TeleportService'):TeleportToPlaceInstance(game.PlaceId,game.JobId,LP)end)end)end
sections.Settings=function()
 label('GENERAL  /  SETTINGS')
 button('Menu hotkey: '..state.menuKey..'  •  Change',content,function(b)
  b.Text='  Press a key (Esc cancels)';local conn;conn=UIS.InputBegan:Connect(function(i)
   if i.UserInputType==Enum.UserInputType.Keyboard then conn:Disconnect();if i.KeyCode~=Enum.KeyCode.Escape and i.KeyCode~=Enum.KeyCode.Unknown then state.menuKey=i.KeyCode.Name;save()end;b.Text='  Menu hotkey: '..state.menuKey..'  •  Change'end
  end)
 end)
 button('Reset UI position',content,function()state.uiX=.5;state.uiY=.5;bg.Position=UDim2.new(.5,-217,.5,-235);save()end)
 button('Unload hub',content,function()if _G.KHASTIFY_HUB_CLEANUP then _G.KHASTIFY_HUB_CLEANUP()end end)
end
local function show(name)
 active=name;title.Text=name;clear();sections[name]()
 for n,b in pairs(sidebarButtons)do b.TextColor3=(n==name and C.purple or C.muted);b.BackgroundColor3=(n==name and Color3.fromRGB(27,21,43)or C.side)end
end
local sidebarEntries={{'Commands','⌘'},{'Voice Chat','◉'},{'Players','♙'},{'Actions','✧'},{'ESV Users','◈'},{'Nametags','◇'},{'Shaders','☼'},{'Local Player','♟'},{'Servers','▣'},{'Settings','⚙'}}
for i,e in ipairs(sidebarEntries)do
 local name=e[1];local y=i==10 and 435 or (49+(i-1)*34)
 local b=ui('TextButton',{Position=UDim2.fromOffset(5,y),Size=UDim2.fromOffset(108,29),BackgroundColor3=C.side,BorderSizePixel=0,Text=e[2]..'  '..name,TextXAlignment=Enum.TextXAlignment.Left,TextColor3=C.muted,Font=Enum.Font.Gotham,TextSize=10},sidebar)
 ui('UICorner',{CornerRadius=UDim.new(0,4)},b);sidebarButtons[name]=b;bind(b.MouseButton1Click,function()show(name)end)
end
local function executeCommand()
 local cmd=commandInput.Text:lower():match('^%s*(.-)%s*$');commandInput.Text=''
 if cmd=='fly' then state.fly=true;startFly() elseif cmd=='unfly' then state.fly=false;stopFly()
 elseif cmd=='noclip' then state.noclip=true elseif cmd=='clip' then state.noclip=false;restoreNoclip()
 elseif cmd=='invisible' then state.invisible=true;setInvisible(true) elseif cmd=='visible' then state.invisible=false;setInvisible(false)
 elseif cmd=='fullbright' then state.fullbright=true;setFullbright(true) elseif cmd=='normal' then state.fullbright=false;setFullbright(false)
 elseif cmd=='rejoin' then pcall(function()game:GetService('TeleportService'):TeleportToPlaceInstance(game.PlaceId,game.JobId,LP)end)
 elseif cmd~='' then warn('[KHASTIFY HUB] Unknown command: '..cmd)end
 if active=='Commands' then show('Commands')end
end
bind(send.MouseButton1Click,executeCommand)
bind(commandInput.FocusLost,function(enter)if enter then executeCommand()end end)
bind(close.MouseButton1Click,function()bg.Visible=false end)
bind(minimize.MouseButton1Click,function()bg.Visible=false end)
local drag,dragStart,startPos=false,nil,nil
bind(topbar.InputBegan,function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true;dragStart=i.Position;startPos=bg.Position end end)
bind(UIS.InputChanged,function(i)if drag and(i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch)then local d=i.Position-dragStart;bg.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)end end)
bind(UIS.InputEnded,function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false;local viewport=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize;if viewport and viewport.X>0 and viewport.Y>0 then state.uiX=math.clamp((bg.AbsolutePosition.X+217)/viewport.X,0,1);state.uiY=math.clamp((bg.AbsolutePosition.Y+235)/viewport.Y,0,1);save()end end end)
bind(UIS.InputBegan,function(i,processed)
 if processed or UIS:GetFocusedTextBox() then return end
 if i.UserInputType==Enum.UserInputType.Keyboard then
  if i.KeyCode.Name==state.menuKey then bg.Visible=not bg.Visible end
  if i.KeyCode==Enum.KeyCode.Space and state.infiniteJump then local h=hum();if h then h:ChangeState(Enum.HumanoidStateType.Jumping)end end
 end
 if state.clickTP and i.UserInputType==Enum.UserInputType.MouseButton1 and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) and not bg.Visible then
  local r=root();if r and mouse.Hit then r.CFrame=CFrame.new(mouse.Hit.Position+Vector3.new(0,4,0))end
 end
end)
bind(Run.Stepped,function()
 if state.noclip and char() then for _,p in ipairs(char():GetDescendants()) do if p:IsA('BasePart') then if originalCollision[p]==nil then originalCollision[p]=p.CanCollide end;p.CanCollide=false end end end
end)
bind(Run.RenderStepped,function()
 if state.fly and flyVelocity and flyGyro then local camera=workspace.CurrentCamera;if not camera then return end;local cf=camera.CFrame;local v=Vector3.zero
  if UIS:IsKeyDown(Enum.KeyCode.W) then v=v+cf.LookVector end
  if UIS:IsKeyDown(Enum.KeyCode.S) then v=v-cf.LookVector end
  if UIS:IsKeyDown(Enum.KeyCode.D) then v=v+cf.RightVector end
  if UIS:IsKeyDown(Enum.KeyCode.A) then v=v-cf.RightVector end
  if UIS:IsKeyDown(Enum.KeyCode.Space) then v=v+Vector3.yAxis end
  if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v=v-Vector3.yAxis end
  flyVelocity.Velocity=(v.Magnitude>0 and v.Unit or Vector3.zero)*math.max(state.speed,35)
  flyGyro.CFrame=cf
 end
end)
bind(LP.CharacterAdded,function(c)
 stopFly();table.clear(originalCollision);table.clear(originalTransparency)
 local h=c:WaitForChild('Humanoid',10);if h then h.WalkSpeed=state.speed;h.UseJumpPower=true;h.JumpPower=state.jump end
 task.wait(.3);if state.fly then startFly()end;if state.invisible then setInvisible(true)end
end)
local h=hum();if h then h.WalkSpeed=state.speed;h.UseJumpPower=true;h.JumpPower=state.jump end
if state.fullbright then setFullbright(true)end
show('Commands')
_G.KHASTIFY_HUB_CLEANUP=function()
 state.fly=false;stopFly();state.noclip=false;restoreNoclip();state.invisible=false;restoreInvisible();state.fullbright=false;setFullbright(false)
 for _,c in ipairs(connections) do pcall(function()c:Disconnect()end) end
 gui:Destroy();_G.KHASTIFY_HUB_CLEANUP=nil
end
print("KHASTIFY'S UNIVERSAL HUB V2 loaded. Press "..state.menuKey.." to open/close.")
