        iconLine(parent, 4, 9, 4, 12, color)
        iconLine(parent, 16, 9, 16, 12, color)
        iconLine(parent, 4, 12, 7, 15, color)
        iconLine(parent, 16, 12, 13, 15, color)
        iconLine(parent, 7, 15, 13, 15, color)
        iconLine(parent, 10, 15, 10, 18, color)
