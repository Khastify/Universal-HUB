local HeadTransparency = {}
local HeadDecals = {}

local function SetHeadless(enabled)
    local c = Char()
    local head = c and c:FindFirstChild("Head")

    if not head then return end

    if enabled then
        if HeadTransparency[head] == nil then
            HeadTransparency[head] =
                head.LocalTransparencyModifier
        end

        head.LocalTransparencyModifier = 1

        for _, obj in ipairs(head:GetDescendants()) do
            if obj:IsA("Decal")
                or obj:IsA("Texture") then

                if HeadDecals[obj] == nil then
                    HeadDecals[obj] = obj.Transparency
                end

                obj.Transparency = 1
            end
        end
    else
        for part, value in pairs(HeadTransparency) do
            if part.Parent then
                part.LocalTransparencyModifier = value
            end
        end

        for obj, value in pairs(HeadDecals) do
            if obj.Parent then
                obj.Transparency = value
            end
        end

        table.clear(HeadTransparency)
        table.clear(HeadDecals)
    end
end

local function Freeze(enabled)
    local r = Root()
    if not r then return end

    r.Anchored = enabled

    if enabled then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

local function Sit()
    local h = Hum()
    if h then h.Sit = true end
end

local function Unstuck()
    local r = Root()
    if not r then return end

    State.freeze = false
    r.Anchored = false

    r.CFrame = r.CFrame + Vector3.new(0, 6, 0)
    r.AssemblyLinearVelocity = Vector3.zero
end

local function Respawn()
    local h = Hum()
    if h then h.Health = 0 end
end

local function SelfFling()
    local r = Root()
    if not r then return end

    r.AssemblyLinearVelocity = Vector3.new(
        math.random(-120, 120),
        100,
        math.random(-120, 120)
    )

    r.AssemblyAngularVelocity =
        Vector3.new(15, 20, 15)
end

local function Wave()
    local h = Hum()

    if h then
        pcall(function()
            h:PlayEmote("wave")
        end)
    end
end

local OriginalLighting = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    FogEnd = Lighting.FogEnd,
    GlobalShadows = Lighting.GlobalShadows
}

local function Fullbright(enabled)
    if enabled then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1000000
        Lighting.GlobalShadows = false
    else
        for key, value in pairs(OriginalLighting) do
            Lighting[key] = value
        end
    end
end

