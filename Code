local sections = {}

local function toggleFeature(name, key, category, callback)
    local function description()
        return state[key] and "Enabled" or "Disabled"
    end

    featureCard(name, category, function(_, subtitle)
        state[key] = not state[key]

        if callback then
            callback(state[key])
