function H.Create(class, props, parent)
    local obj = Instance.new(class)

    for key, value in pairs(props or {}) do
        obj[key] = value
    end

    obj.Parent = parent
    return obj
end

function H.Corner(obj, radius)
    return H.Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, obj)
end

function H.Stroke(obj, color, thickness)
    return H.Create("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, obj)
end

function H.Label(parent, value, size, color, bold)
    return H.Create("TextLabel", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = value,
        TextColor3 = color,
        Font = bold and Enum.Font.GothamBold
            or Enum.Font.Gotham,
        TextSize = size or 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, parent)
end

function H.Tween(obj, props, duration)
    local tween = TweenService:Create(
        obj,
        TweenInfo.new(
            duration or 0.2,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        props
    )

    tween:Play()
    return tween
end

