local HeadTransparency = {}
local HeadDecals = {}

function H.SetHeadless(enabled)
    local c = H.Char()
    local head = c and c:FindFirstChild("Head")

    if not head then return end

    if enabled then
        if HeadTransparency[head] == nil then
            HeadTransparency[head] =
                head.LocalTransparencyModifier
        end

        head.LocalTransparencyModifier = 1

        for _, obj in ipairs(head:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then
                if HeadDecals[obj] == nil then
                    HeadDecals[obj] = obj.Transparency
                end

                obj.Transparency = 1
            end
        end
    else
        for part, value in pairs(HeadTransparency) do
            if part.Parent then
                part.LocalTransparencyModifier = value
            end
        end

        for obj, value in pairs(HeadDecals) do
            if obj.Parent then
                obj.Transparency = value
            end
        end

        table.clear(HeadTransparency)
        table.clear(HeadDecals)
    end
end

function H.Freeze(enabled)
    local r = H.Root()
    if not r then return end

    r.Anchored = enabled

    if enabled then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

function H.Unstuck()
    local r = H.Root()
    if not r then return end

    State.freeze = false
    r.Anchored = false
    r.CFrame = r.CFrame + Vector3.new(0, 6, 0)
    r.AssemblyLinearVelocity = Vector3.zero
end

function H.Respawn()
    local h = H.Hum()
    if h then h.Health = 0 end
end

function H.SelfFling()
    local r = H.Root()
    if not r then return end

    r.AssemblyLinearVelocity = Vector3.new(
        math.random(-120, 120),
        100,
        math.random(-120, 120)
    )

    r.AssemblyAngularVelocity = Vector3.new(15, 20, 15)
end

local OriginalLighting = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    FogEnd = Lighting.FogEnd,
    GlobalShadows = Lighting.GlobalShadows
}

function H.Fullbright(enabled)
    if enabled then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1000000
        Lighting.GlobalShadows = false
    else
        for key, value in pairs(OriginalLighting) do
            Lighting[key] = value
        end
    end
end

--==================================================
-- SPY SYSTEM - V53 PRESERVED
--==================================================

local Spy = {
    active = false,
    target = nil,
    savedPivot = nil,
    savedCharacter = nil,
    savedRoot = nil,
    savedAnchored = false,
    savedAutoRotate = true,
    savedCameraType = nil,
    savedCameraSubject = nil,
    savedCameraMode = nil,
    savedCameraMinZoom = nil,
    savedCameraMaxZoom = nil,
    targetCharacterConnection = nil,
    generation = 0
}

local UpdateSpyButtons = function() end
local UpdateHeaderSpyButton = function() end

function H.DisconnectSpyTarget()
    if Spy.targetCharacterConnection then
        Spy.targetCharacterConnection:Disconnect()
        Spy.targetCharacterConnection = nil
    end
end

function H.GetTargetHumanoid(player)
    if not player or not player.Parent then return nil end

    local character = player.Character
    if not character then return nil end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if humanoid and humanoid.Health > 0 then
        return humanoid
    end

    return nil
end

function H.ApplySpyCamera(player)
    if not Spy.active or Spy.target ~= player then
        return false
    end

    local camera = workspace.CurrentCamera
    local humanoid = H.GetTargetHumanoid(player)

    if not camera or not humanoid then return false end

    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = humanoid

    return true
end

function H.RestoreSpyCamera()
    local camera = workspace.CurrentCamera
    local humanoid = H.Hum()

    if Spy.savedCameraMode then
        pcall(function()
            LP.CameraMode = Spy.savedCameraMode
        end)
    end

    if Spy.savedCameraMinZoom then
        pcall(function()
            LP.CameraMinZoomDistance = Spy.savedCameraMinZoom
        end)
    end

    if Spy.savedCameraMaxZoom then
        pcall(function()
            LP.CameraMaxZoomDistance = Spy.savedCameraMaxZoom
        end)
    end

    if camera then
        camera.CameraType =
            Spy.savedCameraType or Enum.CameraType.Custom

        if Spy.savedCameraSubject
            and Spy.savedCameraSubject.Parent then
            camera.CameraSubject = Spy.savedCameraSubject
        elseif humanoid then
            camera.CameraSubject = humanoid
        end
    end
end

function H.StopSpy()
    if not Spy.active then return end

    Spy.generation += 1

    local savedCharacter = Spy.savedCharacter
    local savedRoot = Spy.savedRoot
    local savedPivot = Spy.savedPivot
    local savedAnchored = Spy.savedAnchored
    local savedAutoRotate = Spy.savedAutoRotate

    H.DisconnectSpyTarget()

    Spy.active = false
    Spy.target = nil

    if savedCharacter
        and savedCharacter.Parent
        and savedCharacter == H.Char() then

        if savedPivot then
            pcall(function()
                savedCharacter:PivotTo(savedPivot)
            end)
        end

        if savedRoot and savedRoot.Parent then
            savedRoot.AssemblyLinearVelocity = Vector3.zero
            savedRoot.AssemblyAngularVelocity = Vector3.zero
            savedRoot.Anchored = savedAnchored
        end

        local humanoid = H.Hum()
        if humanoid then
            humanoid.AutoRotate = savedAutoRotate
        end
    end

    H.RestoreSpyCamera()

    Spy.savedPivot = nil
    Spy.savedCharacter = nil
    Spy.savedRoot = nil
    Spy.savedCameraType = nil
    Spy.savedCameraSubject = nil
    Spy.savedCameraMode = nil
    Spy.savedCameraMinZoom = nil
    Spy.savedCameraMaxZoom = nil

    UpdateSpyButtons()
    UpdateHeaderSpyButton()
end

function H.WatchSpyTarget(player)
    H.DisconnectSpyTarget()

    Spy.targetCharacterConnection =
        player.CharacterAdded:Connect(function(character)
            local generation = Spy.generation

            task.spawn(function()
                local humanoid =
                    character:WaitForChild("Humanoid", 10)

                if not humanoid then return end

                task.wait(0.15)

                if not Alive
                    or not Spy.active
                    or Spy.target ~= player
                    or generation ~= Spy.generation then
                    return
                end

                H.ApplySpyCamera(player)
            end)
        end)
end

function H.StartSpy(player)
    if not player
        or player == LP
        or not player.Parent then
        return
    end

    if Spy.active and Spy.target == player then
        H.ApplySpyCamera(player)
        return
    end

    if Spy.active then
        Spy.generation += 1
        Spy.target = player

        H.WatchSpyTarget(player)
        H.ApplySpyCamera(player)

        UpdateSpyButtons()
        UpdateHeaderSpyButton()
        return
    end

    local character = H.Char()
    local root = H.Root()
    local humanoid = H.Hum()
    local camera = workspace.CurrentCamera

    if not character or not root or not humanoid or not camera then
        return
    end

    if not H.GetTargetHumanoid(player) then return end

    if State.fly then
        State.fly = false
        H.StopFly()
    end

    if State.airWalk then
        State.airWalk = false
        H.StopAirWalk()
    end

    if State.invisible then
        State.invisible = false
        H.SetInvisible(false)
    end

    Spy.savedPivot = character:GetPivot()
    Spy.savedCharacter = character
    Spy.savedRoot = root
    Spy.savedAnchored = root.Anchored
    Spy.savedAutoRotate = humanoid.AutoRotate

    Spy.savedCameraType = camera.CameraType
    Spy.savedCameraSubject = camera.CameraSubject
    Spy.savedCameraMode = LP.CameraMode
    Spy.savedCameraMinZoom = LP.CameraMinZoomDistance
    Spy.savedCameraMaxZoom = LP.CameraMaxZoomDistance

    Spy.active = true
    Spy.target = player
    Spy.generation += 1

    local undergroundPivot =
        Spy.savedPivot + Vector3.new(0, -OFFSET, 0)

    character:PivotTo(undergroundPivot)

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    root.Anchored = true
    humanoid.AutoRotate = false

    pcall(function()
        LP.CameraMode = Enum.CameraMode.Classic
    end)

    H.WatchSpyTarget(player)
    H.ApplySpyCamera(player)

    UpdateSpyButtons()
    UpdateHeaderSpyButton()
end

function H.ToggleSpy(player)
    H.StartSpy(player)
end

H.Bind(Players.PlayerRemoving, function(player)
    if Spy.active and Spy.target == player then
        H.StopSpy()
    end
end)

--==================================================
-- CAMERA-BASED NAMETAGS - SIZE 16
--==================================================

local NametagSystem = {
    enabled = true,
    maxDistance = 100,
    textSize = 16,
    tags = {},
    originalDisplays = {},
    characterConnections = {},
    elapsed = 0,
    nativeScanElapsed = 0,
    hiddenNativeTags = {}
}

-- Only hide name-only BillboardGuis attached to a player character.
-- Record original Enabled states so unloading restores the game UI.
function H.HideNativeNametags(player)
    local character = player.Character
    if not character then return end
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BillboardGui") and obj.Name ~= "KHASTIFY_CameraNametag"
            and NametagSystem.hiddenNativeTags[obj] == nil then
            local hasName = false
            local hasOtherText = false
            for _, child in ipairs(obj:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    local value = child.Text:gsub("^%s+", ""):gsub("%s+$", "")
                    if value == player.DisplayName or value == player.Name
                        or value == ("@" .. player.Name) then
                        hasName = true
                    elseif value ~= "" then
                        hasOtherText = true
                    end
                end
            end
            if hasName and not hasOtherText then
                NametagSystem.hiddenNativeTags[obj] = obj.Enabled
                obj.Enabled = false
            end
        end
    end
end

function H.RestoreNativeNametags()
    for gui, enabled in pairs(NametagSystem.hiddenNativeTags) do
        if gui and gui.Parent then
            pcall(function() gui.Enabled = enabled end)
        end
        NametagSystem.hiddenNativeTags[gui] = nil
    end
end

function H.RestoreNametagDisplay(humanoid)
    local original = NametagSystem.originalDisplays[humanoid]

    if original and humanoid and humanoid.Parent then
        pcall(function()
            humanoid.DisplayDistanceType = original
        end)
    end

    NametagSystem.originalDisplays[humanoid] = nil
end

function H.RemoveNametag(player)
    local data = NametagSystem.tags[player]

    if data then
        if data.gui then data.gui:Destroy() end

        if data.humanoid then
            H.RestoreNametagDisplay(data.humanoid)
        end
    end

    NametagSystem.tags[player] = nil
end

function H.CreateNametag(player)
    if not Alive or not NametagSystem.enabled then return end
    if player == LP then return end

    H.RemoveNametag(player)

    local character = player.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not head or not humanoid then return end

    if NametagSystem.originalDisplays[humanoid] == nil then
        NametagSystem.originalDisplays[humanoid] =
            humanoid.DisplayDistanceType
    end

    pcall(function()
        humanoid.DisplayDistanceType =
            Enum.HumanoidDisplayDistanceType.None
    end)

    local billboard = H.Create("BillboardGui", {
        Name = "KHASTIFY_CameraNametag",
        Adornee = head,
        StudsOffsetWorldSpace = Vector3.new(0, 2.1, 0),
        Size = UDim2.fromOffset(200, 32),
        AlwaysOnTop = false,
        LightInfluence = 0,
        MaxDistance = 0,
        Enabled = false
    }, head)

    local nameLabel = H.Create("TextLabel", {
        Name = "DisplayName",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = player.DisplayName,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        TextStrokeTransparency = 0.45,
        Font = Enum.Font.SourceSans,
        TextSize = NametagSystem.textSize,
        TextScaled = false,
        TextWrapped = false,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center
    }, billboard)

    H.HideNativeNametags(player)

    NametagSystem.tags[player] = {
        gui = billboard,
        label = nameLabel,
        head = head,
        humanoid = humanoid,
        character = character
    }
end

function H.SetupNametagPlayer(player)
    if player == LP then return end

    if NametagSystem.characterConnections[player] then
        NametagSystem.characterConnections[player]:Disconnect()
    end

    NametagSystem.characterConnections[player] =
        player.CharacterAdded:Connect(function(character)
            H.RemoveNametag(player)

            task.spawn(function()
                local head = character:WaitForChild("Head", 10)
                local humanoid =
                    character:WaitForChild("Humanoid", 10)

                if not Alive or not head or not humanoid then
                    return
                end

                if player.Character == character then
                    H.CreateNametag(player)
                end
            end)
        end)

    if player.Character then
        task.spawn(function()
            local character = player.Character

            local head = character:FindFirstChild("Head")
                or character:WaitForChild("Head", 10)

            local humanoid =
                character:FindFirstChildOfClass("Humanoid")
                or character:WaitForChild("Humanoid", 10)

            if Alive
                and head
                and humanoid
                and player.Character == character then
                H.CreateNametag(player)
            end
        end)
    end
end

function H.UpdateNametags()
    if not NametagSystem.enabled then return end

    NametagSystem.nativeScanElapsed += 0.05
    if NametagSystem.nativeScanElapsed >= 1 then
        NametagSystem.nativeScanElapsed = 0
        for player in pairs(NametagSystem.tags) do
            H.HideNativeNametags(player)
        end
    end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local cameraPosition = camera.CFrame.Position

    for player, data in pairs(NametagSystem.tags) do
        if not player.Parent
            or not data.character
            or player.Character ~= data.character
            or not data.head
            or not data.head.Parent
            or not data.humanoid
            or not data.humanoid.Parent then

            H.RemoveNametag(player)
        else
            local distance =
                (cameraPosition - data.head.Position).Magnitude

            local withinRange =
                distance <= NametagSystem.maxDistance

            local alive = data.humanoid.Health > 0

            local _, onScreen =
                camera:WorldToViewportPoint(data.head.Position)

            local shouldShow =
                withinRange and alive and onScreen

            if data.gui.Enabled ~= shouldShow then
                data.gui.Enabled = shouldShow
            end

            if data.label.Text ~= player.DisplayName then
                data.label.Text = player.DisplayName
            end

            if data.humanoid.DisplayDistanceType
                ~= Enum.HumanoidDisplayDistanceType.None then

                pcall(function()
                    data.humanoid.DisplayDistanceType =
                        Enum.HumanoidDisplayDistanceType.None
                end)
            end
        end
    end
end

function H.CleanupNametags()
    NametagSystem.enabled = false
    H.RestoreNativeNametags()

    for player, connection in pairs(
        NametagSystem.characterConnections
    ) do
        connection:Disconnect()
        NametagSystem.characterConnections[player] = nil
    end

    local toRemove = {}

    for player in pairs(NametagSystem.tags) do
        table.insert(toRemove, player)
    end

    for _, player in ipairs(toRemove) do
        H.RemoveNametag(player)
    end

    for humanoid in pairs(NametagSystem.originalDisplays) do
        H.RestoreNametagDisplay(humanoid)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    H.SetupNametagPlayer(player)
end

H.Bind(Players.PlayerAdded, H.SetupNametagPlayer)

H.Bind(Players.PlayerRemoving, function(player)
    H.RemoveNametag(player)

    local connection =
        NametagSystem.characterConnections[player]

    if connection then
        connection:Disconnect()
        NametagSystem.characterConnections[player] = nil
    end
end)

