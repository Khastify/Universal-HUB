function H.ClearList()
    for _, obj in ipairs(List:GetChildren()) do
        if obj ~= ListLayout
            and not obj:IsA("UIPadding") then
            obj:Destroy()
        end
    end

    for _, obj in ipairs(Categories:GetChildren()) do
        if obj ~= CategoryLayout then
            obj:Destroy()
        end
    end

    table.clear(Entries)
    table.clear(KeybindButtons)
    table.clear(FavoriteButtons)

    EntryOrder = 0
end

function H.AddEntry(obj, name, category, pinned, commandName)
    table.insert(Entries, {
        object = obj,
        name = name:lower(),
        category = category,
        pinned = pinned or false,
        commandName = commandName
    })
end

function H.RemoveEntry(obj)
    for i = #Entries, 1, -1 do
        if Entries[i].object == obj then
            table.remove(Entries, i)
        end
    end
end

function H.Filter()
    local query = SearchBox.Text:lower()

    for _, entry in ipairs(Entries) do
        if entry.object and entry.object.Parent then
            local matches =
                query == ""
                or entry.name:find(query, 1, true)

            local categoryMatches = true

            if Active == "Commands" then
                if CurrentCategory == "Favorites" then
                    categoryMatches =
                        entry.commandName ~= nil
                        and Favorites[entry.commandName] == true

                elseif CurrentCategory ~= "All" then
                    categoryMatches =
                        entry.category == CurrentCategory
                end
            end

            entry.object.Visible =
                matches and categoryMatches
        end
    end

    if Active == "Commands" then
        -- Show a section heading only when it has matching cards.
        for _, heading in ipairs(Entries) do
            if heading.commandName == nil and heading.category ~= "All" then
                local found = false
                for _, item in ipairs(Entries) do
                    if item.commandName and item.category == heading.category
                        and item.object and item.object.Visible then
                        found = true
                        break
                    end
                end
                heading.object.Visible = found
            end
        end
    end
end

