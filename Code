local ESP = {
    charms = {},
    skeletons = {},
    characterConnections = {},
    playerConnections = {},
    elapsed = 0,
    skeletonRefreshElapsed = 0
}

local ESPColor = C.purple -- fallback only; each ESP has independent saved color
local function RecolorESP(kind)
    local color = ESPColors[kind]
    if kind == "charms" then
        for _, data in pairs(ESP.charms) do
            if data.highlight then
                data.highlight.OutlineColor = color
                data.highlight.FillColor = color
            end
            if data.fallbackHighlight then data.fallbackHighlight.OutlineColor = color end
        end
    else
        for _, data in pairs(ESP.skeletons) do
            for _, bone in ipairs(data.lines) do bone.frame.BackgroundColor3 = color end
        end
    end
end

function H.RemoveCharms(player)
    local data = ESP.charms[player]

    if data then
        if data.highlight then
            data.highlight:Destroy()
        end

        if data.fallback then
            data.fallback:Destroy()
        end
    end

    ESP.charms[player] = nil
end

function H.MakeCharmsFallback(character)
    -- Transparent characters can fail to render Highlight.
    -- A separate, local-only model gives Highlight opaque
    -- geometry to outline without changing the real avatar.

    local model = Instance.new("Model")
    model.Name = "KHASTIFY_CharmsFallback"

    local parts = {}

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart")
            and part.Name ~= "HumanoidRootPart"
            and not part:IsA("Terrain") then

            local proxy = Instance.new("Part")
            proxy.Name = part.Name
            proxy.Anchored = true
            proxy.CanCollide = false
            proxy.CanTouch = false
            proxy.CanQuery = false
            proxy.CastShadow = false
            proxy.Material = Enum.Material.SmoothPlastic
            proxy.Color = ESPColors.charms
            proxy.Transparency = 0.5
            proxy.Size = part.Size
            proxy.CFrame = part.CFrame
            proxy.Parent = model

            table.insert(parts, {
                source = part,
                proxy = proxy
            })
        end
    end

    model.Parent = workspace

    return model, parts
end

function H.CreateCharms(player)
    H.RemoveCharms(player)

    if not State.charms
        or player == LP
        or not player.Parent then
        return
    end

    local character = player.Character
    if not character then return end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then return end

    local highlight = H.Create("Highlight", {
        Name = "KHASTIFY_CharmsESP",
        Adornee = character,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        FillColor = ESPColors.charms,
        FillTransparency = 1,
        OutlineColor = ESPColors.charms,
        OutlineTransparency = 0,
        Enabled = true
    }, character)

    -- Do not spawn a second proxy avatar: it caused solid purple doubles
    -- and substantial per-frame work in populated servers.
    local fallback, parts, fallbackHighlight = nil, {}, nil

    ESP.charms[player] = {
        character = character,
        humanoid = humanoid,
        highlight = highlight,
        fallback = fallback,
        fallbackHighlight = fallbackHighlight,
        parts = parts
    }
end

function H.UpdateCharms()
    if not State.charms then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local data = ESP.charms[player]

            if not data
                or data.character ~= player.Character then
                H.CreateCharms(player)
                data = ESP.charms[player]
            end

            if data then
                local valid =
                    data.character
                    and data.character.Parent
                    and data.humanoid
                    and data.humanoid.Parent
                    and data.humanoid.Health > 0

                if not valid then
                    H.RemoveCharms(player)
                else
                    data.highlight.Enabled = true
                end
            end
        end
    end
end

function H.SetCharms(enabled)
    State.charms = enabled

    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP then
                H.CreateCharms(player)
            end
        end
    else
        local toRemove = {}

        for player in pairs(ESP.charms) do
            table.insert(toRemove, player)
        end

        for _, player in ipairs(toRemove) do
            H.RemoveCharms(player)
        end
    end
end

--==================================================
-- ANTI INVIS: CLIENT-VISIBLE TRANSPARENCY DETECTION
-- Rebuild only invisible characters, never visible ones.
--==================================================

local AntiInvis = {records = {}, elapsed = 0}

function H.AntiInvisRemove(player)
    local record = AntiInvis.records[player]
    if not record then return end
    if record.clone then record.clone:Destroy() end
    AntiInvis.records[player] = nil
end

function H.AntiInvisClear()
    for player in pairs(AntiInvis.records) do
        H.AntiInvisRemove(player)
    end
end

function H.AntiInvisRecord(player, character)
    local record = AntiInvis.records[player]
    if record and record.character ~= character then
        H.AntiInvisRemove(player)
        record = nil
    end
    if not record then
        record = {character = character, original = {}, clone = nil, pairs = {}}
        AntiInvis.records[player] = record
    end
    return record
end

function H.AntiInvisCheck(player)
    if player == LP then return end
    local character = player.Character
    if not character or not character.Parent then
        H.AntiInvisRemove(player)
        return
    end
    local record = H.AntiInvisRecord(player, character)
    local total, hidden = 0, 0
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            total += 1
            if part.Transparency >= 0.95 then
                hidden += 1
            elseif not record.clone then
                record.original[part.Name] = part.Transparency
            end
        end
    end
    -- Avoid triggering on naturally invisible root parts or one-off effects.
    local invisible = total >= 3 and hidden / total >= 0.85
    if not invisible then
        if record.clone then
            record.clone:Destroy()
            record.clone = nil
            table.clear(record.pairs)
        end
        return
    end
    if record.clone then return end

    local archivable = character.Archivable
    character.Archivable = true
    local ok, clone = pcall(function() return character:Clone() end)
    character.Archivable = archivable
    if not ok or not clone then return end
    clone.Name = "KHASTIFY_AntiInvisAvatar"
    local sourceParts = {}
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            sourceParts[H.PartPath(part, character)] = part
        end
    end
    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") then
            obj:Destroy()
        elseif obj:IsA("JointInstance") or obj:IsA("WeldConstraint")
            or obj:IsA("Constraint") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.CastShadow = false
            obj.LocalTransparencyModifier = 0
            if obj.Name == "HumanoidRootPart" then
                obj.Transparency = 1
            else
                obj.Transparency = record.original[obj.Name] or 0
            end
            local source = sourceParts[H.PartPath(obj, clone)]
            if source then
                table.insert(record.pairs, {source = source, visual = obj})
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 0
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
            obj.Enabled = false
        end
    end
    clone.Parent = workspace
    record.clone = clone
end

function H.AntiInvisUpdate(dt)
    if not State.antiInvis then return end
    AntiInvis.elapsed += dt
    if AntiInvis.elapsed < 0.2 then return end
    AntiInvis.elapsed = 0
    for _, player in ipairs(Players:GetPlayers()) do
        H.AntiInvisCheck(player)
    end
end

function H.AntiInvisRender()
    if not State.antiInvis then return end
    for player, record in pairs(AntiInvis.records) do
        if record.clone and record.clone.Parent then
            for _, pair in ipairs(record.pairs) do
                if pair.source.Parent and pair.visual.Parent then
                    pair.visual.CFrame = pair.source.CFrame
                    pair.visual.Size = pair.source.Size
                end
            end
        end
    end
end

function H.SetAntiInvis(enabled)
    State.antiInvis = enabled
    if not enabled then
        H.AntiInvisClear()
        AntiInvis.elapsed = 0
    else
        AntiInvis.elapsed = 0.2
    end
end

