local function filterFeatures()
    local query = string.lower(currentSearch)

    for _, entry in ipairs(featureCards) do
        local matchesSearch =
            query == ""
            or string.find(entry.name, query, 1, true)
            or string.find(entry.description, query, 1, true)

        local matchesCategory =
            currentCategory == "All"
            or entry.category == currentCategory

        entry.object.Visible =
            matchesSearch and matchesCategory
    end

    featureList.CanvasPosition = Vector2.zero
end

