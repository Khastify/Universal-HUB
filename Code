local function DrawSettings(parent, color)
    -- Outlined eight-tooth gear.
    --
    -- The center is genuinely hollow:
    -- no solid background-colored masking circle.
    --
    -- Outer geometry is generated as one closed
    -- contour, rather than a solid disk with spokes.

    local cx, cy = 60, 60
    local teeth = 8
    local thickness = 5.2

    -- Reference-inspired radii.
    local valleyRadius = 43
    local shoulderRadius = 46
    local tipRadius = 54

    local points = {}

    -- Each tooth has a flat outer edge, sloping
    -- shoulders, and a rounded-looking transition.
    for tooth = 0, teeth-1 do
        local centerAngle =
            -math.pi/2 + tooth*(math.pi*2/teeth)

        local profile = {
            {-0.392, valleyRadius},
            {-0.320, valleyRadius},
            {-0.260, shoulderRadius},
            {-0.205, tipRadius},
            {-0.105, tipRadius},
            { 0.105, tipRadius},
            { 0.205, tipRadius},
            { 0.260, shoulderRadius},
            { 0.320, valleyRadius},
            { 0.392, valleyRadius}
        }

        for _, item in ipairs(profile) do
            local angle = centerAngle + item[1]
            local radius = item[2]

            points[#points+1] = {
                cx + math.cos(angle)*radius,
                cy + math.sin(angle)*radius
            }
        end
    end

    -- Outer contour.
    DrawPath(
        parent,
        points,
        color,
        thickness,
        true,
        true
    )

    -- Large, centered hollow circular opening.
    IconCircle(
        parent,
        33, 33,
        54,
        color,
        6
    )
end

