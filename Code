local function makeScrollList()
    -- The list itself stays inside the main panel.
    -- All cards receive padding INSIDE this frame.

    local frame = create("ScrollingFrame", {
        Name = "FeatureList",

        Position = UDim2.fromOffset(17, 174),
        Size = UDim2.new(1, -34, 1, -190),

        BackgroundTransparency = 1,
        BorderSizePixel = 0,

        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.purple,

        CanvasSize = UDim2.fromOffset(0, 0),

        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.None,

        ClipsDescendants = true
    }, main)

    -- IMPORTANT:
    -- Leave room for rounded corners and scrollbar.
    create("UIPadding", {
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 13),

        PaddingTop = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 8)
    }, frame)

    local layout = create("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, frame)

    bind(
        layout:GetPropertyChangedSignal("AbsoluteContentSize"),
        function()
            frame.CanvasSize = UDim2.fromOffset(
                0,
                layout.AbsoluteContentSize.Y + 20
            )
        end
    )

    return frame, layout
end

