local function feature(name, category, description, callback)
    local card = makeCard(56)

    local clickArea = create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, card)

    local title = label(
        card, name, 12, C.text, "bold"
    )

    title.Position = UDim2.fromOffset(15, 8)
    title.Size = UDim2.new(1, -65, 0, 21)

    local sub = label(
        card, description or category, 10, C.faint
    )

    sub.Position = UDim2.fromOffset(15, 29)
    sub.Size = UDim2.new(1, -65, 0, 17)

    local arrow = label(
        card, "›", 22, C.muted
    )

    arrow.Position = UDim2.new(1, -29, 0, 10)
    arrow.Size = UDim2.fromOffset(19, 34)
    arrow.TextXAlignment = Enum.TextXAlignment.Center

    bind(clickArea.MouseEnter, function()
        card.BackgroundColor3 = C.hover
    end)

    bind(clickArea.MouseLeave, function()
        card.BackgroundColor3 = C.card
    end)

    bind(clickArea.MouseButton1Click, function()
        if callback then
            callback(sub)
        end
    end)

    addEntry(
        card,
        name .. " " .. (description or ""),
        category
    )

    return card
end

local function toggle(name, key, category, callback)
    feature(
        name,
        category,
        state[key] and "Enabled" or "Disabled",

        function(sub)
            state[key] = not state[key]

            if callback then
                callback(state[key])
            end

            sub.Text =
                state[key] and "Enabled" or "Disabled"
        end
    )
end

local function number(name, key, category, maximum, callback)
    local row = makeCard(67)

    local title = label(
        row, name, 12, C.text, "bold"
    )

    title.Position = UDim2.fromOffset(15, 7)
    title.Size = UDim2.new(1, -110, 0, 23)

    local input = create("TextBox", {
        Position = UDim2.new(1, -91, 0, 9),
        Size = UDim2.fromOffset(75, 25),

        BackgroundColor3 = C.bg,

        Text = tostring(state[key]),
        TextColor3 = C.text,

        Font = Enum.Font.GothamMedium,
        TextSize = 11,

        ClearTextOnFocus = false
    }, row)

    corner(input, 6)

    local track = create("Frame", {
        Position = UDim2.fromOffset(15, 48),
        Size = UDim2.new(1, -30, 0, 4),

        BackgroundColor3 = C.border,
        BorderSizePixel = 0
    }, row)

    corner(track, 3)

    local fill = create("Frame", {
        Size = UDim2.fromScale(
            math.clamp(state[key] / maximum, 0, 1),
            1
        ),

        BackgroundColor3 = C.purple,
        BorderSizePixel = 0
    }, track)

    corner(fill, 3)

    local function apply(value)
        value = tonumber(value)

        if not value then
            input.Text = tostring(state[key])
            return
        end

        value = math.clamp(
            math.floor(value + 0.5),
            0,
            maximum
        )

        state[key] = value
        input.Text = tostring(value)

        fill.Size = UDim2.fromScale(
            value / maximum,
            1
        )

        if callback then
            callback(value)
        end

        save()
    end

    bind(input.FocusLost, function()
        apply(input.Text)
    end)

    local sliding = false

    bind(track.InputBegan, function(i)
        if i.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            sliding = true

            apply(
                (i.Position.X - track.AbsolutePosition.X)
                / math.max(track.AbsoluteSize.X, 1)
                * maximum
            )
        end
    end)

    bind(UIS.InputChanged, function(i)
        if sliding
            and i.UserInputType ==
            Enum.UserInputType.MouseMovement then

            apply(
                (i.Position.X - track.AbsolutePosition.X)
                / math.max(track.AbsoluteSize.X, 1)
                * maximum
            )
        end
    end)

    bind(UIS.InputEnded, function(i)
        if i.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            sliding = false
        end
    end)

    addEntry(row, name, category)
end

