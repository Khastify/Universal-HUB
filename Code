        CornerRadius = UDim.new(1, 0)
    }, avatar)

    local generation = PlayerGeneration

    task.spawn(function()
        local ok, image = pcall(function()
            return Players:GetUserThumbnailAsync(
                player.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
        end)

        if ok
            and Alive
            and generation == PlayerGeneration
            and avatar.Parent then
            avatar.Image = image
        end
    end)

    local display = H.Label(
        card, player.DisplayName, 14, C.text, true
    )

    display.Position = UDim2.fromOffset(63, 10)
    display.Size = UDim2.new(1, -115, 0, 24)

