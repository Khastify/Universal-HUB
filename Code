local function Toggle(name, key, category, callback)
    local status

    local function Execute()
        State[key] = not State[key]

        if callback then
            callback(State[key])
        end

        if status and status.Parent then
            status.Text =
                State[key] and "Enabled" or "Disabled"
        end
    end

    RegisterCommand(name, Execute)

    local card = Feature(
        name,
        category,
        State[key] and "Enabled" or "Disabled",
        Execute,
        true
    )

    status = card:FindFirstChild("StatusLabel")
end

