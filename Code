    fly = false,
    flySpeed = 60,
    flyAnim = false,
    noclip = false,
    infiniteJump = false,
    clickTP = false,
    airWalk = false,
    dashPower = 84,
    invisible = false,
    headless = false,
    freeze = false,
    fullbright = false,
    speed = 16,
    jump = 50,
    menuKey = "K",
    uiX = 0.5,
    uiY = 0.5
}

local saveFile = "KHASTIFY_Universal_Hub_Settings.json"

if type(readfile) == "function" then
    pcall(function()
        local data = Http:JSONDecode(readfile(saveFile))

        for k, v in pairs(data) do
            if state[k] ~= nil and type(v) == type(state[k]) then
                state[k] = v
            end
        end
    end)
end

local function save()
    if type(writefile) ~= "function" then return end

    pcall(function()
        writefile(saveFile, Http:JSONEncode({
            flySpeed = state.flySpeed,
            dashPower = state.dashPower,
            speed = state.speed,
            jump = state.jump,
            menuKey = state.menuKey,
            uiX = state.uiX,
            uiY = state.uiY
        }))
    end)
end

-- ==========================================
-- MOVEMENT
-- ==========================================

local collisions = {}

local function restoreCollision()
    for part, value in pairs(collisions) do
        if part and part.Parent then
            part.CanCollide = value
        end
    end

    table.clear(collisions)
end

local flyVelocity
local flyGyro

local function stopFly()
    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end

    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end

    local h = hum()
    if h then h.PlatformStand = false end
end

local function startFly()
    stopFly()

    local r = root()
    local h = hum()

    if not r or not h then return end

    h.PlatformStand = true

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.Name = "KHASTIFY_FlyVelocity"
    flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = r

    flyGyro = Instance.new("BodyGyro")
    flyGyro.Name = "KHASTIFY_FlyGyro"
    flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyGyro.P = 9000
    flyGyro.Parent = r
end

-- ==========================================
-- AIR WALK
-- ==========================================

local airPlatform
local airHeight

local function createPlatform(name, size)
    local part = Instance.new("Part")

    part.Name = name
    part.Size = size
    part.Anchored = true
    part.Transparency = 1
    part.CanCollide = true
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Parent = workspace

    return part
end

local function stopAirWalk()
    if airPlatform then
        airPlatform:Destroy()
        airPlatform = nil
    end

    airHeight = nil
end

local function startAirWalk()
    stopAirWalk()

    local r = root()
    if not r then return end

    airHeight = r.Position.Y - 3.2

    airPlatform = createPlatform(
        "KHASTIFY_AirWalk",
        Vector3.new(9, 0.5, 9)
    )

    airPlatform.Position = Vector3.new(
        r.Position.X,
        airHeight - 0.25,
        r.Position.Z
    )
end

local function dash()
    local r = root()
    local camera = workspace.CurrentCamera

    if not r or not camera then return end

    local direction = camera.CFrame.LookVector
    direction = Vector3.new(direction.X, 0, direction.Z)

    if direction.Magnitude < 0.01 then return end

    local velocity = r.AssemblyLinearVelocity

    r.AssemblyLinearVelocity =
        direction.Unit * state.dashPower +
        Vector3.new(0, velocity.Y, 0)
end

-- ==========================================
-- INVISIBILITY V6
-- ==========================================

local invisibleOffset = 8
local invisibleActive = false

local visualAvatar
local invisibleFloor

local savedTransparency = {}
local savedCollisions = {}

local invisibleFloorY
local lastInvisiblePosition

local savedCameraSubject
local savedCameraType

local function restoreTransparency()
    for part, value in pairs(savedTransparency) do
        if part and part.Parent then
            part.LocalTransparencyModifier = value
        end
    end

    table.clear(savedTransparency)
end

local function restoreInvisibleCollision()
    for part, value in pairs(savedCollisions) do
        if part and part.Parent then
            part.CanCollide = value
        end
    end

    table.clear(savedCollisions)
end

local function removeInvisibleObjects()
    if visualAvatar then
        visualAvatar:Destroy()
        visualAvatar = nil
    end

    if invisibleFloor then
        invisibleFloor:Destroy()
        invisibleFloor = nil
    end
end

local function makeVisualAvatar()
    local c = char()
    if not c then return nil end

    local oldArchivable = c.Archivable
    c.Archivable = true

    local success, clone = pcall(function()
        return c:Clone()
    end)

    c.Archivable = oldArchivable

    if not success or not clone then
        return nil
    end

    clone.Name = "KHASTIFY_TranslucentAvatar"

    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") then
            obj:Destroy()

        elseif obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.CastShadow = false

            if obj.Name == "HumanoidRootPart" then
                obj.Transparency = 1
            else
                -- 30% see-through.
                obj.Transparency = 0.3
                obj.LocalTransparencyModifier = 0
            end

        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = math.max(obj.Transparency, 0.3)

        elseif obj:IsA("ParticleEmitter") or
               obj:IsA("Trail") or
               obj:IsA("Beam") then
            obj.Enabled = false
        end
    end

    local ghostHum = clone:FindFirstChildOfClass("Humanoid")

    if ghostHum then
        ghostHum.DisplayDistanceType =
            Enum.HumanoidDisplayDistanceType.None

        ghostHum.BreakJointsOnDeath = false
    end

    clone.Parent = workspace

    return clone
end

local function setInvisible(enabled)
    local c = char()
    local r = root()
    local h = hum()
    local camera = workspace.CurrentCamera

    if not enabled then
        if invisibleActive and r then
            r.CFrame = r.CFrame * CFrame.new(0, invisibleOffset, 0)

            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end

        invisibleActive = false

        removeInvisibleObjects()
        restoreTransparency()
        restoreInvisibleCollision()

        if camera then
            camera.CameraType = savedCameraType or Enum.CameraType.Custom

            if h then
                camera.CameraSubject = h
            elseif savedCameraSubject then
                camera.CameraSubject = savedCameraSubject
            end
        end

        savedCameraSubject = nil
        savedCameraType = nil
        invisibleFloorY = nil
        lastInvisiblePosition = nil

        return
    end

    if invisibleActive then return end

    if not c or not r or not h then
        state.invisible = false
        return
    end

    local clone = makeVisualAvatar()

    if not clone then
        state.invisible = false
        warn("[KHASTIFY] Could not create translucent avatar.")
        return
    end

    visualAvatar = clone
    visualAvatar:PivotTo(c:GetPivot())

    if camera then
        savedCameraSubject = camera.CameraSubject
        savedCameraType = camera.CameraType
    end

    -- Make the physical character locally invisible.
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            savedTransparency[part] = part.LocalTransparencyModifier
            part.LocalTransparencyModifier = 1

            savedCollisions[part] = part.CanCollide
        end
    end

    -- Move the physical body underground.
    r.CFrame = r.CFrame * CFrame.new(0, -invisibleOffset, 0)

    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    -- Fixed-height support platform.
    invisibleFloorY = r.Position.Y - 3.2

    invisibleFloor = createPlatform(
        "KHASTIFY_InvisibleFloor",
        Vector3.new(10, 0.5, 10)
    )

    invisibleFloor.Position = Vector3.new(
        r.Position.X,
        invisibleFloorY - 0.25,
        r.Position.Z
    )

    lastInvisiblePosition = r.Position

    invisibleActive = true

    -- Follow the visible avatar rather than the underground body.
    local ghostHum = clone:FindFirstChildOfClass("Humanoid")

    if camera and ghostHum then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = ghostHum
    end
end

local function updateInvisible()
    if not invisibleActive then return end

    local c = char()
    local r = root()

    if not c or not r then return end

    -- Move the support floor horizontally, keeping its height fixed.
    if invisibleFloor then
        invisibleFloor.Position = Vector3.new(
            r.Position.X,
            invisibleFloorY - 0.25,
            r.Position.Z
        )
    end

    -- Prevent falling indefinitely if collision support fails.
    local minimumY = invisibleFloorY + 3

    if r.Position.Y < minimumY - 2 then
        local current = r.CFrame

        r.CFrame = CFrame.new(
            current.Position.X,
            minimumY,
            current.Position.Z
        ) * current.Rotation

        local velocity = r.AssemblyLinearVelocity

        r.AssemblyLinearVelocity = Vector3.new(
            velocity.X,
            math.max(velocity.Y, 0),
            velocity.Z
        )
    end

    -- Match the visible avatar to the actual character's pose.
    if visualAvatar and visualAvatar.Parent then
        visualAvatar:PivotTo(
            c:GetPivot() * CFrame.new(0, invisibleOffset, 0)
        )

        -- Copy joint animation transforms.
        for _, original in ipairs(c:GetDescendants()) do
            if original:IsA("Motor6D") then
                local matching = visualAvatar:FindFirstChild(
                    original.Name,
                    true
                )

                if matching and matching:IsA("Motor6D") then
                    matching.Transform = original.Transform
                end
            end
        end
    end

    lastInvisiblePosition = r.Position
end

