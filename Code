local savedHeadTransparency = {}
local savedHeadDecals = {}

local function setHeadless(enabled)
    local c = char()
    if not c then return end

    local head = c:FindFirstChild("Head")
    if not head then return end

    if enabled then
        if savedHeadTransparency[head] == nil then
            savedHeadTransparency[head] =
                head.LocalTransparencyModifier
        end

        head.LocalTransparencyModifier = 1

        for _, obj in ipairs(head:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then
                if savedHeadDecals[obj] == nil then
                    savedHeadDecals[obj] = obj.Transparency
                end

                obj.Transparency = 1
            end
        end
    else
        for part, value in pairs(savedHeadTransparency) do
            if part and part.Parent then
                part.LocalTransparencyModifier = value
            end
        end

        for part, value in pairs(savedHeadDecals) do
            if part and part.Parent then
                part.Transparency = value
            end
        end

        table.clear(savedHeadTransparency)
        table.clear(savedHeadDecals)
    end
end

local function setFreeze(enabled)
    local r = root()
    if not r then return end

    r.Anchored = enabled

    if enabled then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

local function sit()
    local h = hum()
    if h then h.Sit = true end
end

local function unstuck()
    local r = root()
    if not r then return end

    state.freeze = false
    r.Anchored = false

    r.CFrame = r.CFrame * CFrame.new(0, 6, 0)
    r.AssemblyLinearVelocity = Vector3.zero
end

local function respawn()
    local h = hum()
    if h then h.Health = 0 end
end

local function selfFling()
    local r = root()
    if not r then return end

    r.AssemblyLinearVelocity = Vector3.new(
        math.random(-120, 120),
        100,
        math.random(-120, 120)
    )

    r.AssemblyAngularVelocity = Vector3.new(15, 20, 15)
end

