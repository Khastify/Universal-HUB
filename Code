local AUTOEXEC_FILENAME = "KHASTIFY_AutoExecute.lua"

local AutoExecute = {
    startupInstalled = false,
    teleportSupported = false,
    status = "Disabled"
}

local QueueTeleport =
    queue_on_teleport
    or queueonteleport
