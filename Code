-- Expandable independent ESP color pickers; colors save even while disabled.
-- HSV gradient grid: horizontal hue, vertical saturation, with brightness slider.
local ESPGridColumns = 24
local ESPGridRows = 9
local ESPBrightness = {charms=1, skeleton=1}
local OpenESPCard = nil
local ESPCardClosers = {}
function H.ESPFeature(name, key, setter)
    local card = H.MakeCard(63)
    local status = H.Label(card, State[key] and "Enabled" or "Disabled", 12, C.faint)
    status.Position = UDim2.fromOffset(15, 33)
    status.Size = UDim2.new(1,-160,0,18)
    local title = H.Label(card, name, 14, C.text, true)
    title.Position = UDim2.fromOffset(15,8)
    title.Size = UDim2.new(1,-160,0,24)
    H.AddFavoriteButton(card,name,14)
    H.AddKeybindButton(card,name,14)
    local toggle = H.Create("TextButton", {Size=UDim2.new(1,-155,0,58), BackgroundTransparency=1,Text="",AutoButtonColor=false},card)
    local function Execute()
        setter(not State[key]); status.Text=State[key] and "Enabled" or "Disabled"; H.Save()
    end
    Commands[name]=Execute
    H.Bind(toggle.MouseButton1Click,Execute)
    local arrow = H.Create("TextButton", {Position=UDim2.new(1,-30,0,18),Size=UDim2.fromOffset(25,28),BackgroundTransparency=1,Text="›",TextColor3=C.muted,TextSize=25,Font=Enum.Font.GothamMedium,Rotation=0,AutoButtonColor=false},card)
    local _,_,savedBrightness=ESPColors[key]:ToHSV()
    ESPBrightness[key]=savedBrightness
    local picker = H.Create("Frame", {Position=UDim2.fromOffset(13,69),Size=UDim2.new(1,-26,0,203),BackgroundTransparency=1,Visible=false},card)
    local caption=H.Label(picker,"ESP COLOR GRADIENT",11,C.muted,true)
    caption.Size=UDim2.new(1,-80,0,18)
    local preview=H.Create("Frame",{Position=UDim2.new(1,-30,0,0),Size=UDim2.fromOffset(28,18),BackgroundColor3=ESPColors[key],BorderSizePixel=0},picker)
    H.Corner(preview,4)
    H.Stroke(preview,C.border,1)
    local grid=H.Create("Frame",{Position=UDim2.fromOffset(0,24),Size=UDim2.new(1,0,0,105),BackgroundTransparency=1},picker)
    local gridLayout=H.Create("UIGridLayout",{
        CellSize=UDim2.new(1/ESPGridColumns,-1,0,11),
        CellPadding=UDim2.fromOffset(1,1),
        SortOrder=Enum.SortOrder.LayoutOrder
    },grid)
    local cells={}
    local hexInput = H.Create("TextBox", {
        Position=UDim2.fromOffset(65,163),Size=UDim2.new(1,-65,0,27),
        BackgroundColor3=C.bg,BorderSizePixel=0,
        Text="",PlaceholderText="#9D5BFF",PlaceholderColor3=C.faint,
        TextColor3=C.text,Font=Enum.Font.GothamMedium,TextSize=12,
        ClearTextOnFocus=false,TextXAlignment=Enum.TextXAlignment.Center
    },picker)
    H.Corner(hexInput,6)
    H.Stroke(hexInput,C.border,1)
    local hexLabel=H.Label(picker,"HEX",10,C.muted,true)
    hexLabel.Position=UDim2.fromOffset(0,167)
    hexLabel.Size=UDim2.fromOffset(58,18)
    local function ToHex(color)
        return string.format("#%02X%02X%02X",
            math.floor(color.R*255+0.5),
            math.floor(color.G*255+0.5),
            math.floor(color.B*255+0.5))
    end
    local function SetESPColor(color)
        ESPColors[key]=color
        preview.BackgroundColor3=color
        hexInput.Text=ToHex(color)
        RecolorESP(key)
        H.Save()
    end
    hexInput.Text=ToHex(ESPColors[key])
    local function RefreshGrid()
        local brightness=ESPBrightness[key]
        for _,cell in ipairs(cells) do
            cell.button.BackgroundColor3=Color3.fromHSV(cell.hue,cell.saturation,brightness)
        end
    end
    for row=0,ESPGridRows-1 do
        for col=0,ESPGridColumns-1 do
            local hue=col/(ESPGridColumns-1)
            local saturation=1-row/(ESPGridRows-1)
            local button=H.Create("TextButton",{
                LayoutOrder=row*ESPGridColumns+col+1,
                BackgroundColor3=Color3.fromHSV(hue,saturation,ESPBrightness[key]),
                BorderSizePixel=0,Text="",AutoButtonColor=false
            },grid)
            table.insert(cells,{button=button,hue=hue,saturation=saturation})
            H.Bind(button.MouseButton1Click,function()
                SetESPColor(Color3.fromHSV(hue,saturation,ESPBrightness[key]))
            end)
        end
    end
    local brightnessLabel=H.Label(picker,"BRIGHTNESS",10,C.muted,true)
    brightnessLabel.Position=UDim2.fromOffset(0,137)
    brightnessLabel.Size=UDim2.fromOffset(90,17)
    local brightnessTrack=H.Create("Frame",{
        Position=UDim2.new(0,92,0,143),Size=UDim2.new(1,-92,0,7),
        BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0
    },picker)
    H.Corner(brightnessTrack,4)
    local shade=H.Create("UIGradient",{
        Color=ColorSequence.new(Color3.new(0,0,0),Color3.new(1,1,1))
    },brightnessTrack)
    local brightnessMarker=H.Create("Frame",{
        AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(ESPBrightness[key],0.5),
        Size=UDim2.fromOffset(5,14),BackgroundColor3=C.text,BorderSizePixel=0
    },brightnessTrack)
    H.Corner(brightnessMarker,2)
    H.Bind(hexInput.FocusLost,function()
        local raw=hexInput.Text:gsub("%s+",""):gsub("^#","")
        if raw:match("^%x%x%x$") then
            raw=raw:sub(1,1):rep(2)..raw:sub(2,2):rep(2)..raw:sub(3,3):rep(2)
        end
        if not raw:match("^%x%x%x%x%x%x$") then
            hexInput.Text=ToHex(ESPColors[key])
            return
        end
        local r=tonumber(raw:sub(1,2),16)
        local g=tonumber(raw:sub(3,4),16)
        local b=tonumber(raw:sub(5,6),16)
        local color=Color3.fromRGB(r,g,b)
        local _,_,v=color:ToHSV()
        ESPBrightness[key]=v
        brightnessMarker.Position=UDim2.fromScale(v,0.5)
        RefreshGrid()
        SetESPColor(color)
    end)
    local brightnessHit=H.Create("TextButton",{
        Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",AutoButtonColor=false
    },brightnessTrack)
    local draggingBrightness=false
    local function ApplyBrightness(x)
        local value=math.clamp((x-brightnessTrack.AbsolutePosition.X)/math.max(brightnessTrack.AbsoluteSize.X,1),0,1)
        ESPBrightness[key]=value
        brightnessMarker.Position=UDim2.fromScale(value,0.5)
        local h,s=ESPColors[key]:ToHSV()
        RefreshGrid()
        SetESPColor(Color3.fromHSV(h,s,value))
    end
    H.Bind(brightnessHit.InputBegan,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            draggingBrightness=true
            ApplyBrightness(input.Position.X)
        end
    end)
    H.Bind(UIS.InputChanged,function(input)
        if draggingBrightness and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            ApplyBrightness(input.Position.X)
        end
    end)
    H.Bind(UIS.InputEnded,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            draggingBrightness=false
        end
    end)
    local expanded=false
    local function SetExpanded(value)
        expanded=value
        if value then picker.Visible = true end
        H.Tween(arrow, {Rotation=value and 90 or 0, TextColor3=value and C.purple or C.muted}, 0.2)
        H.Tween(card,{Size=UDim2.new(1,0,0,value and 283 or 63)},0.2)
        if not value then
            task.delay(0.2, function()
                if not expanded and picker.Parent then picker.Visible=false end
            end)
        end
    end
    ESPCardClosers[key]=SetExpanded
    SetExpanded(false)
    H.Bind(arrow.MouseButton1Click,function()
        if not expanded then
            for other, close in pairs(ESPCardClosers) do if other~=key then close(false) end end
        end
        SetExpanded(not expanded)
    end)
    H.AddEntry(card,name.." color", "Visuals",false,name)
    return card
end

