local function RegisterCommand(name, callback)
    Commands[name] = callback
end

local function RunCommand(name)
    local callback = Commands[name]

    if callback then
        local ok, err = pcall(callback)

        if not ok then
            warn("[KHASTIFY] Command failed:", name, err)
        end
    end
end

local function UpdateKeybindLabels()
    for name, button in pairs(KeybindButtons) do
        if button and button.Parent then
            if WaitingForBind == name then
                button.Text = "..."
                button.TextColor3 = C.purple
            else
                button.Text = Keybinds[name] or "..."

                button.TextColor3 =
                    Keybinds[name] and C.text or C.faint
            end
        end
    end
end

local function SetKeybind(name, key)
    if key == State.menuKey then return false end

    for otherName, otherKey in pairs(Keybinds) do
        if otherKey == key then
            Keybinds[otherName] = nil
        end
    end

    Keybinds[name] = key

    Save()
    UpdateKeybindLabels()

    return true
end

