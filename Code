local StartPosition

Bind(Topbar.InputBegan, function(input)
    if input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        Dragging = true
        DragStart = input.Position
        StartPosition = Window.Position
    end
end)

Bind(UIS.InputChanged, function(input)
    if Dragging
        and input.UserInputType ==
        Enum.UserInputType.MouseMovement then

        local delta = input.Position - DragStart

        Window.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + delta.X,

            StartPosition.Y.Scale,
            StartPosition.Y.Offset + delta.Y
        )
    end
end)

Bind(UIS.InputEnded, function(input)
    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        and Dragging then

        Dragging = false

        local camera = workspace.CurrentCamera

        if camera then
            local size = camera.ViewportSize

            if size.X > 0 and size.Y > 0 then
                State.uiX = math.clamp(
                    (Window.AbsolutePosition.X + WIDTH / 2)
                    / size.X,
                    0,
                    1
                )

                State.uiY = math.clamp(
                    (Window.AbsolutePosition.Y + HEIGHT / 2)
                    / size.Y,
                    0,
                    1
                )

                Save()
            end
        end
    end
end)

--==================================================
-- INPUT
--==================================================

Bind(UIS.InputBegan, function(input, processed)
    if WaitingForBind then
        if input.UserInputType ==
            Enum.UserInputType.Keyboard then

            local name = WaitingForBind
            WaitingForBind = nil

            if input.KeyCode == Enum.KeyCode.Delete
                or input.KeyCode == Enum.KeyCode.Backspace then

                Keybinds[name] = nil
                Save()

            elseif input.KeyCode == Enum.KeyCode.Escape then
                -- Cancel.

            elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                SetKeybind(name, input.KeyCode.Name)
            end

            UpdateKeybindLabels()
        end

        return
    end

    if ChangingMenuKey then
        if input.UserInputType ==
            Enum.UserInputType.Keyboard then

            ChangingMenuKey = false

            if input.KeyCode ~= Enum.KeyCode.Escape
                and input.KeyCode ~= Enum.KeyCode.Unknown then

                State.menuKey = input.KeyCode.Name

                for name, key in pairs(Keybinds) do
                    if key == State.menuKey then
                        Keybinds[name] = nil
                    end
                end

                Save()
            end

            ShowSection("Settings")
        end

        return
    end

    if processed or UIS:GetFocusedTextBox() then
        return
    end

    if input.UserInputType ==
        Enum.UserInputType.Keyboard then

        local key = input.KeyCode.Name

        if key == State.menuKey then
            Window.Visible = not Window.Visible
            return
        end

        if input.KeyCode == Enum.KeyCode.Space
            and State.infiniteJump then

            local h = Hum()

            if h then
                h:ChangeState(
                    Enum.HumanoidStateType.Jumping
                )
            end
        end

        for commandName, assignedKey in pairs(Keybinds) do
            if assignedKey == key then
                RunCommand(commandName)
                break
            end
        end
    end

    if State.clickTP
        and input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        local position = UIS:GetMouseLocation()

        local x = Window.AbsolutePosition.X
        local y = Window.AbsolutePosition.Y
        local w = Window.AbsoluteSize.X
        local h = Window.AbsoluteSize.Y

        local overUI =
            Window.Visible
            and position.X >= x
            and position.X <= x + w
            and position.Y >= y
            and position.Y <= y + h

        if not overUI then
            local camera = workspace.CurrentCamera
            local r = Root()

            if camera and r then
                local ray = camera:ViewportPointToRay(
                    position.X,
                    position.Y
                )

                local params = RaycastParams.new()

                params.FilterType =
                    Enum.RaycastFilterType.Exclude

                local excluded = {}

                if Char() then
                    table.insert(excluded, Char())
                end

                if VisualAvatar then
                    table.insert(excluded, VisualAvatar)
                end

                if InvisibleFloor then
                    table.insert(excluded, InvisibleFloor)
                end

                if AirPlatform then
                    table.insert(excluded, AirPlatform)
                end

                params.FilterDescendantsInstances = excluded

                local hit = workspace:Raycast(
                    ray.Origin,
                    ray.Direction * 10000,
                    params
                )

                if hit then
                    if State.invisible then
                        State.invisible = false
                        SetInvisible(false)
                    end

                    local c = Char()

                    if c then
                        c:PivotTo(
                            CFrame.new(
                                hit.Position
                                + Vector3.new(0, 3.5, 0)
                            )
                        )
                    end

                    if State.airWalk then
                        StartAirWalk()
                    end
                end
            end
        end
    end
end)

