local LoadServerPage

LoadServerPage = function(reset)
    if ServerBrowser.loading then return end

    if reset then
        ServerBrowser.generation += 1
        ServerBrowser.cursor = nil

        table.clear(ServerBrowser.servers)

        for id, data in pairs(ServerBrowser.cards) do
            if not data.current then
                RemoveEntry(data.frame)

                if data.frame.Parent then
                    data.frame:Destroy()
                end

                ServerBrowser.cards[id] = nil
            end
        end
    end

    local generation = ServerBrowser.generation
    local cursor = ServerBrowser.cursor

    ServerBrowser.loading = true

    UpdateServerStatus("Loading public servers...")
    UpdateLoadMoreButton()

    task.spawn(function()
        local data, err = RequestServers(ServerURL(cursor))

        if not Alive
            or Active ~= "Servers"
            or generation ~= ServerBrowser.generation then

            return
        end

        ServerBrowser.loading = false

        if not data then
            UpdateServerStatus(
                "Unable to load servers: "
                .. tostring(err)
            )

            UpdateLoadMoreButton()
            return
        end

        ServerBrowser.cursor = data.nextPageCursor

        for _, server in ipairs(data.data) do
            if type(server) == "table"
                and type(server.id) == "string" then

                if server.id == game.JobId then
                    local currentCard =
                        ServerBrowser.cards[game.JobId]

                    if currentCard then
                        currentCard.population.Text =
                            ServerPopulation(server)
                    end

                elseif not ServerBrowser.cards[server.id] then
                    table.insert(
                        ServerBrowser.servers,
                        server
                    )

                    ServerCard(
                        server,
                        #ServerBrowser.servers,
                        false
                    )
                end
            end
        end

        UpdateServerStatus(
            tostring(#ServerBrowser.servers)
            .. " other public servers loaded"
        )

        UpdateLoadMoreButton()
        Filter()
    end)
end

local function ClearServerCards()
    ServerBrowser.generation += 1
    ServerBrowser.loading = false

    for _, data in pairs(ServerBrowser.cards) do
        if data.frame and data.frame.Parent then
            data.frame:Destroy()
        end
    end

    table.clear(ServerBrowser.cards)
    table.clear(ServerBrowser.servers)

    ServerBrowser.cursor = nil
    ServerBrowser.status = nil
    ServerBrowser.loadMoreButton = nil
end

