    local title = Label(
        List, value:upper(), 12, C.muted, true
    )

    title.Size = UDim2.new(1, 0, 0, 27)
    title.LayoutOrder = NextOrder()

    AddEntry(title, value, value)

    return title
end

local function MakeCard(height, order)
    local card = Create("Frame", {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        LayoutOrder = order or NextOrder()
    }, List)

    Corner(card, 9)
    Stroke(card, C.border)

    return card
end

local function AddKeybindButton(card, name, y)
    local button = Create("TextButton", {
        Position = UDim2.new(1, -102, 0, y),
        Size = UDim2.fromOffset(69, 32),
        BackgroundColor3 = C.bg,
        Text = Keybinds[name] or "...",
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        AutoButtonColor = false,
        ZIndex = 5
    }, card)

    Corner(button, 6)
    Stroke(button, C.border)

    KeybindButtons[name] = button

    Bind(button.MouseButton1Click, function()
        WaitingForBind = name
        button.Text = "..."
        button.TextColor3 = C.purple
    end)

    return button
end

local function Feature(
    name,
    category,
    description,
    callback,
    keybind
)
    local card = MakeCard(60)

    local click = Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, card)

    local title = Label(card, name, 14, C.text, true)
    title.Position = UDim2.fromOffset(15, 8)
    title.Size = UDim2.new(1, -112, 0, 24)

    local sub = Label(
        card, description or category, 12, C.faint
    )

    sub.Name = "StatusLabel"
    sub.Position = UDim2.fromOffset(15, 33)
    sub.Size = UDim2.new(1, -112, 0, 18)

    local arrow = Label(card, "›", 24, C.muted)
    arrow.Position = UDim2.new(1, -29, 0, 12)
    arrow.Size = UDim2.fromOffset(19, 34)
    arrow.TextXAlignment = Enum.TextXAlignment.Center

    Bind(click.MouseEnter, function()
        card.BackgroundColor3 = C.hover
    end)

    Bind(click.MouseLeave, function()
        card.BackgroundColor3 = C.card
    end)

    Bind(click.MouseButton1Click, function()
        if callback then callback(sub) end
    end)

    if keybind then
        AddKeybindButton(card, name, 14)
    end

    AddEntry(
        card,
        name .. " " .. (description or ""),
        category
    )

    return card
end

local function Toggle(name, key, category, callback)
    local status

    local function Execute()
        State[key] = not State[key]

        if callback then callback(State[key]) end

        if status and status.Parent then
            status.Text =
                State[key] and "Enabled" or "Disabled"
        end
    end

    Commands[name] = Execute

    local card = Feature(
        name,
        category,
        State[key] and "Enabled" or "Disabled",
        Execute,
        true
    )

    status = card:FindFirstChild("StatusLabel")
end

local function Action(name, category, description, callback)
    Commands[name] = callback

    Feature(
        name, category,
        description, callback, true
    )
end

