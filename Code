local function BindPlayer(userId, signal, callback)
    local connection = signal:Connect(callback)

    PlayerCardConnections[userId] =
        PlayerCardConnections[userId] or {}

    table.insert(
        PlayerCardConnections[userId],
        connection
    )

    return connection
end

local function DisconnectPlayerCard(userId)
    local connections = PlayerCardConnections[userId]

    if connections then
        for _, connection in ipairs(connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end
    end

    PlayerCardConnections[userId] = nil
end

local function GetThumbnail(player, image, generation)
    task.spawn(function()
        local ok, thumbnail = pcall(function()
            return Players:GetUserThumbnailAsync(
                player.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
        end)

        if ok
            and Alive
            and generation == PlayerListGeneration
            and image.Parent
            and Players:GetPlayerByUserId(player.UserId) then

            image.Image = thumbnail
        end
    end)
end

local function TeleportToPlayer(player)
    local target = player.Character
        and player.Character:FindFirstChild("HumanoidRootPart")

    if not target or not Root() then return end

    if State.invisible then
        State.invisible = false
        SetInvisible(false)
    end

    local c = Char()

    if c then
        c:PivotTo(
            target.CFrame * CFrame.new(3, 0, 0)
        )
    end

    if State.airWalk then
        StartAirWalk()
    end
end

local function LocalFlingDemo()
    local r = Root()
    if not r then return end

    local original = r.AssemblyAngularVelocity

    r.AssemblyAngularVelocity =
        Vector3.new(0, 30, 0)

    task.delay(0.45, function()
        if r and r.Parent then
            r.AssemblyAngularVelocity = original
        end
    end)
end

