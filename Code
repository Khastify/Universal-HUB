local HeadTransparency = {}
local HeadDecals = {}

local function SetHeadless(enabled)
    local c = Character()
    local head = c and c:FindFirstChild("Head")

    if not head then
        return
    end

    if enabled then
        if HeadTransparency[head] == nil then
            HeadTransparency[head] =
                head.LocalTransparencyModifier
        end

        head.LocalTransparencyModifier = 1

        for _, object in ipairs(head:GetDescendants()) do
            if object:IsA("Decal")
                or object:IsA("Texture") then

                if HeadDecals[object] == nil then
                    HeadDecals[object] =
                        object.Transparency
                end

                object.Transparency = 1
            end
        end
    else
        for part, value in pairs(HeadTransparency) do
            if part.Parent then
                part.LocalTransparencyModifier = value
            end
        end

        for object, value in pairs(HeadDecals) do
            if object.Parent then
                object.Transparency = value
            end
        end

        table.clear(HeadTransparency)
        table.clear(HeadDecals)
    end
end

local function Freeze(enabled)
    local r = Root()

    if not r then
        return
    end

    r.Anchored = enabled

    if enabled then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

local function Sit()
    local h = Humanoid()

    if h then
        h.Sit = true
    end
end

local function Unstuck()
    local r = Root()

    if not r then
        return
    end

    State.freeze = false
    r.Anchored = false

    r.CFrame = r.CFrame + Vector3.new(0, 6, 0)
    r.AssemblyLinearVelocity = Vector3.zero
end

local function Respawn()
    local h = Humanoid()

    if h then
        h.Health = 0
    end
end

local function SelfFling()
    local r = Root()

    if not r then
        return
    end

    r.AssemblyLinearVelocity = Vector3.new(
        math.random(-120, 120),
        100,
        math.random(-120, 120)
    )

    r.AssemblyAngularVelocity =
        Vector3.new(15, 20, 15)
end

local function Wave()
    local h = Humanoid()

    if h then
        pcall(function()
            h:PlayEmote("wave")
        end)
    end
end

local OriginalLighting = {
