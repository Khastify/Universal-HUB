local function CombinedFeature(
    name,
    category,
    sliderName,
    key,
    maximum,
    default,
    description,
    callback,
    sliderCallback
)
    -- Taller card contains both the action and slider.
    local card = MakeCard(122)

    local title = Label(
        card, name, 14, C.text, true
    )

    title.Position = UDim2.fromOffset(15, 8)
    title.Size = UDim2.new(1, -125, 0, 25)

    local status = Label(
        card, description, 12, C.faint
    )

    status.Position = UDim2.fromOffset(15, 32)
    status.Size = UDim2.new(1, -125, 0, 18)

    -- Keep keybind in the original top-right position.
    AddKeybindButton(card, name, 14)

    -- Clicking the upper portion activates the feature.
    local click = Create("TextButton", {
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, -112, 0, 54),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, card)

    local function Execute()
        if callback then
            callback(status)
        end
    end

    Commands[name] = Execute

    Bind(click.MouseButton1Click, Execute)

    Bind(click.MouseEnter, function()
        card.BackgroundColor3 = C.hover
    end)

    Bind(click.MouseLeave, function()
        card.BackgroundColor3 = C.card
    end)

    -- Slider is fully contained in the same card.
    AddSlider(
        card,
        sliderName,
        key,
        maximum,
        default,
        sliderCallback,
        62
    )

    AddEntry(
        card,
        name .. " " .. sliderName .. " " .. description,
        category
    )

    return card, status
end

