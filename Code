-- DRAG WINDOW

local dragging = false
local dragStart
local startPosition

bind(topbar.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = window.Position
    end
end)

bind(UIS.InputChanged, function(input)
    if not dragging then return end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        window.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

bind(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        if dragging then
            dragging = false

            local camera = workspace.CurrentCamera

            if camera then
                local size = camera.ViewportSize

                if size.X > 0 and size.Y > 0 then
                    state.uiX = math.clamp(
                        (window.AbsolutePosition.X + WIDTH / 2)
                        / size.X,
                        0,
                        1
                    )

                    state.uiY = math.clamp(
                        (window.AbsolutePosition.Y + HEIGHT / 2)
                        / size.Y,
                        0,
                        1
                    )

                    save()
                end
            end
        end
    end
end)

-- =====================================
-- KEYBOARD INPUT
-- =====================================

bind(UIS.InputBegan, function(input, processed)
    if changingHotkey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            changingHotkey = false

            if input.KeyCode ~= Enum.KeyCode.Escape
                and input.KeyCode ~= Enum.KeyCode.Unknown then

                state.menuKey = input.KeyCode.Name
                save()
            end

            searchBox.PlaceholderText = "search settings..."

            showSection("Settings")
        end

        return
    end

    if processed or UIS:GetFocusedTextBox() then
        return
    end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode.Name == state.menuKey then
            window.Visible = not window.Visible
        end

        if input.KeyCode == Enum.KeyCode.Space
            and state.infiniteJump then

            local h = humanoid()

            if h then
                h:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end

        if input.KeyCode == Enum.KeyCode.Q then
            dash()
        end
    end

    -- CLICK TELEPORT

    if state.clickTP
        and input.UserInputType == Enum.UserInputType.MouseButton1 then

        local position = UIS:GetMouseLocation()
        local overUI = false

        for _, obj in ipairs(
            guiParent:GetGuiObjectsAtPosition(
                position.X,
                position.Y
            )
        ) do
            if obj:IsDescendantOf(gui) then
                overUI = true
                break
            end
        end

        if not overUI then
            local camera = workspace.CurrentCamera
            local r = root()

            if camera and r then
                local ray = camera:ViewportPointToRay(
                    position.X,
                    position.Y
                )

                local params = RaycastParams.new()

                params.FilterType =
                    Enum.RaycastFilterType.Exclude

                local excluded = {}

                if character() then
                    table.insert(excluded, character())
                end

                if visualAvatar then
                    table.insert(excluded, visualAvatar)
                end

                if invisibleFloor then
                    table.insert(excluded, invisibleFloor)
                end

                if airPlatform then
                    table.insert(excluded, airPlatform)
                end

                params.FilterDescendantsInstances = excluded

                local hit = workspace:Raycast(
                    ray.Origin,
                    ray.Direction * 10000,
                    params
                )

                if hit then
                    if state.invisible then
                        state.invisible = false
                        setInvisible(false)
                    end

                    r.CFrame = CFrame.new(
                        hit.Position + Vector3.new(0, 3.5, 0)
                    )

                    if state.airWalk then
                        startAirWalk()
                    end
                end
            end
        end
    end
end)

