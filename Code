    }, avatar)

    GetThumbnail(player, avatar, generation)

    local displayName = Label(
        card,
        player.DisplayName,
        12,
        C.text,
        true
    )

    displayName.Position = UDim2.fromOffset(63, 10)
    displayName.Size = UDim2.new(1, -115, 0, 21)

    local username = Label(
        card,
        "@" .. player.Name,
        10,
        C.muted
    )

    username.Position = UDim2.fromOffset(63, 31)
    username.Size = UDim2.new(1, -115, 0, 16)

    -- V17 animated arrow

    local arrow = MakeDropdownArrow(card)

    local clickArea = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 59),

        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, card)

    Create("Frame", {
        Position = UDim2.fromOffset(12, 59),
        Size = UDim2.new(1, -24, 0, 1),

        BackgroundColor3 = C.border,
        BorderSizePixel = 0
    }, card)

    local actions = Create("Frame", {
        Position = UDim2.fromOffset(12, 70),
        Size = UDim2.new(1, -24, 0, 33),

        BackgroundTransparency = 1
    }, card)

    local tp = Create("TextButton", {
        Size = UDim2.new(0.48, 0, 1, 0),

        BackgroundColor3 = C.selected,
        BorderSizePixel = 0,

        Text = "TP",
        TextColor3 = C.text,

        Font = Enum.Font.GothamBold,
        TextSize = 11
    }, actions)

    Corner(tp, 7)

    local fling = Create("TextButton", {
        Position = UDim2.new(0.52, 0, 0, 0),
        Size = UDim2.new(0.48, 0, 1, 0),

        BackgroundColor3 = C.selected,
        BorderSizePixel = 0,

        Text = "Fling",
        TextColor3 = C.text,

        Font = Enum.Font.GothamBold,
        TextSize = 11
    }, actions)

    Corner(fling, 7)

    -- ======================================
    -- V17 SMOOTH EXPANSION
    -- ======================================

    local expanded = false

    local function SetExpanded(open, instant)
        expanded = open

        local targetHeight = open and 114 or 59
        local targetRotation = open and 90 or 0

        local targetColor = open and C.hover or C.card

        if instant then
            card.Size = UDim2.new(1, 0, 0, targetHeight)
            arrow.Rotation = targetRotation
            card.BackgroundColor3 = targetColor
        else
            Tween(
                card,
                {
                    Size = UDim2.new(
                        1,
                        0,
                        0,
                        targetHeight
                    ),

                    BackgroundColor3 = targetColor
                },
                0.2
            )

            Tween(
                arrow,
                {
                    Rotation = targetRotation
                },
                0.2
            )
        end
    end

    PlayerCards[player.UserId] = {
        frame = card,
        expand = SetExpanded
    }

    SetExpanded(
        ExpandedUserId == player.UserId,
        true
    )

    Bind(clickArea.MouseButton1Click, function()
        if ExpandedUserId == player.UserId then
            ExpandedUserId = nil
        else
            ExpandedUserId = player.UserId
        end

        for userId, data in pairs(PlayerCards) do
            if data.frame.Parent then
                data.expand(
                    userId == ExpandedUserId,
                    false
                )
            end
        end
    end)

    Bind(tp.MouseButton1Click, function()
        TeleportToPlayer(player)
    end)

    Bind(fling.MouseButton1Click, function()
        LocalFlingDemo()
    end)

    AddEntry(
        card,
        player.DisplayName .. " " .. player.Name .. " TP Fling",
        "All"
    )
end

