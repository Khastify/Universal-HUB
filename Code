    elseif kind == "voice" then

        -- Microphone
        iconRect(parentObj, 7, 2, 6, 10, color, 4)

        iconCurve(parentObj, {
            Vector2.new(4, 10),
            Vector2.new(4.5, 13),
            Vector2.new(7, 15),
            Vector2.new(10, 16),
            Vector2.new(13, 15),
            Vector2.new(15.5, 13),
            Vector2.new(16, 10)
        }, color, 1.8)

        iconLine(parentObj, 10, 16, 10, 18, color, 1.8)
        iconLine(parentObj, 7, 18, 13, 18, color, 1.8)

    elseif kind == "players" then

        -- Two-person outline
        iconCircle(parentObj, 7, 6, 3, color)
        iconCircle(parentObj, 15, 7, 2.4, color)

        iconCurve(parentObj, {
            Vector2.new(2, 17),
            Vector2.new(2.5, 14),
            Vector2.new(5, 12),
            Vector2.new(7.5, 11.5),
            Vector2.new(10, 12),
            Vector2.new(12, 14),
            Vector2.new(12.5, 17)
        }, color, 1.8)

        iconCurve(parentObj, {
            Vector2.new(14.5, 12),
            Vector2.new(17, 13),
            Vector2.new(18.5, 15),
            Vector2.new(19, 17)
        }, color, 1.8)

    elseif kind == "actions" then

        -- Magic wand
        iconLine(parentObj, 4, 16, 15, 5, color, 2.4)

        -- Sparkles
