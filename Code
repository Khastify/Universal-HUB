function H.MakePlayerCard(player, order)
    local card = H.MakeCard(63, order)
    card.ClipsDescendants = true

    local avatar = H.Create("ImageLabel", {
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.fromOffset(39, 39),
