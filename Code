local function RequestServers(url)
    local requestFunction =
        (type(request) == "function" and request)
        or (type(http_request) == "function" and http_request)
        or (
            syn
            and type(syn.request) == "function"
            and syn.request
        )
        or (
            http
            and type(http.request) == "function"
            and http.request
        )

    if not requestFunction then
        return nil, "HTTP requests are not supported."
    end

    local ok, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET",

            Headers = {
                ["Accept"] = "application/json"
            }
        })
    end)

    if not ok then
        return nil, tostring(response)
    end

    if type(response) ~= "table" then
        return nil, "Invalid HTTP response."
    end

    local status = response.StatusCode or response.Status

    if status and tonumber(status) ~= 200 then
        return nil, "HTTP " .. tostring(status)
    end

    local body = response.Body or response.body

    if type(body) ~= "string" then
        return nil, "No response body."
    end

    local decodedOk, decoded = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if not decodedOk or type(decoded) ~= "table" then
        return nil, "Unable to decode server data."
    end

    if type(decoded.data) ~= "table" then
        return nil, "Invalid server listing."
    end

    return decoded
end

local function ServerURL(cursor)
    local url =
        "https://games.roblox.com/v1/games/"
        .. tostring(game.PlaceId)
        .. "/servers/Public?sortOrder=Desc&limit=100"

    if cursor and cursor ~= "" then
        url ..= "&cursor="
            .. HttpService:UrlEncode(cursor)
    end

    return url
end

local function ServerShortId(id)
    if type(id) ~= "string" then
        return "Unknown"
    end

    if #id <= 16 then
        return id
    end

    return id:sub(1, 8)
        .. "..."
        .. id:sub(-5)
end

local function ServerPopulation(server)
    return tostring(server.playing or 0)
        .. "/"
        .. tostring(server.maxPlayers or 0)
        .. " Players"
end

