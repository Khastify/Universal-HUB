-- =========================================
-- DRAGGING
-- =========================================

local Dragging = false
local DragStart
local StartPosition

Connect(Topbar.InputBegan, function(input)
    if input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        Dragging = true

        DragStart = input.Position
        StartPosition = Window.Position
    end
end)

Connect(UIS.InputChanged, function(input)
    if Dragging
        and input.UserInputType ==
        Enum.UserInputType.MouseMovement then

        local delta = input.Position - DragStart

        Window.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + delta.X,

            StartPosition.Y.Scale,
            StartPosition.Y.Offset + delta.Y
        )
    end
end)

Connect(UIS.InputEnded, function(input)
    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        and Dragging then

        Dragging = false

        local camera = workspace.CurrentCamera

        if camera then
            local size = camera.ViewportSize

            if size.X > 0 and size.Y > 0 then
                State.uiX = math.clamp(
                    (
                        Window.AbsolutePosition.X
                        + WIDTH / 2
                    ) / size.X,
                    0,
                    1
                )

                State.uiY = math.clamp(
                    (
                        Window.AbsolutePosition.Y
                        + HEIGHT / 2
                    ) / size.Y,
                    0,
                    1
                )

                SaveSettings()
            end
        end
    end
end)

-- =========================================
-- KEYBOARD / MOUSE INPUT
-- =========================================

Connect(UIS.InputBegan, function(input, processed)
    if ChangingHotkey then
        if input.UserInputType ==
            Enum.UserInputType.Keyboard then

            ChangingHotkey = false

            if input.KeyCode ~= Enum.KeyCode.Escape
                and input.KeyCode ~= Enum.KeyCode.Unknown then

                State.menuKey = input.KeyCode.Name
                SaveSettings()
            end

            ShowSection("Settings")
        end

        return
    end

    if processed or UIS:GetFocusedTextBox() then
        return
    end

    if input.UserInputType ==
        Enum.UserInputType.Keyboard then

        if input.KeyCode.Name == State.menuKey then
            Window.Visible = not Window.Visible
        end

        if input.KeyCode == Enum.KeyCode.Space
            and State.infiniteJump then

            local h = Humanoid()

            if h then
                h:ChangeState(
                    Enum.HumanoidStateType.Jumping
                )
            end
        end

        if input.KeyCode == Enum.KeyCode.Q then
            Dash()
        end
    end

    if State.clickTP
        and input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        local position = UIS:GetMouseLocation()

        local x = Window.AbsolutePosition.X
        local y = Window.AbsolutePosition.Y

        local width = Window.AbsoluteSize.X
        local height = Window.AbsoluteSize.Y

        local overUI =
            Window.Visible
            and position.X >= x
            and position.X <= x + width
            and position.Y >= y
            and position.Y <= y + height

        if not overUI then
            local camera = workspace.CurrentCamera
            local r = Root()

            if camera and r then
                local ray = camera:ViewportPointToRay(
                    position.X,
                    position.Y
                )

                local params = RaycastParams.new()

                params.FilterType =
                    Enum.RaycastFilterType.Exclude

                local excluded = {}

                if Character() then
                    table.insert(
                        excluded,
                        Character()
                    )
                end

                if VisualAvatar then
                    table.insert(
                        excluded,
                        VisualAvatar
                    )
                end

                if InvisibleFloor then
                    table.insert(
                        excluded,
                        InvisibleFloor
                    )
                end

                if AirPlatform then
                    table.insert(
                        excluded,
                        AirPlatform
                    )
                end

                params.FilterDescendantsInstances =
                    excluded

                local hit = workspace:Raycast(
                    ray.Origin,
                    ray.Direction * 10000,
                    params
                )

                if hit then
                    if State.invisible then
                        State.invisible = false
                        SetInvisible(false)
                    end

                    local c = Character()

                    if c then
                        c:PivotTo(
                            CFrame.new(
                                hit.Position
                                    + Vector3.new(
                                        0,
                                        3.5,
                                        0
                                    )
                            )
                        )
                    end

                    if State.airWalk then
                        StartAirWalk()
                    end
                end
            end
        end
    end
end)

