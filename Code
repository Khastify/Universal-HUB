local function toggle(text, key, callback)
    local b

    b = button(text .. "     " .. (state[key] and "ON" or "OFF"), function()
        state[key] = not state[key]

        b.Text = "  " .. text .. "     " ..
            (state[key] and "ON" or "OFF")

        if callback then callback(state[key]) end
    end)
end

local function slider(text, key, min, max, callback)
    local row = ui("Frame", {
        Size = UDim2.new(1, -4, 0, 54),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0
    }, content)

    ui("UICorner", {CornerRadius = UDim.new(0, 5)}, row)

    local t = ui("TextLabel", {
        Position = UDim2.fromOffset(8, 3),
        Size = UDim2.new(1, -16, 0, 23),
        BackgroundTransparency = 1,
        Text = text .. "   " .. state[key],
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 11
    }, row)

    local track = ui("Frame", {
        Position = UDim2.new(0, 9, 0, 37),
        Size = UDim2.new(1, -18, 0, 5),
        BackgroundColor3 = C.edge,
        BorderSizePixel = 0
    }, row)

    local fill = ui("Frame", {
        Size = UDim2.fromScale(
            math.clamp((state[key] - min) / (max - min), 0, 1),
            1
        ),
        BackgroundColor3 = C.purple,
        BorderSizePixel = 0
    }, track)

    local dragging = false

    local function update(x)
        local ratio = math.clamp(
            (x - track.AbsolutePosition.X) /
            math.max(track.AbsoluteSize.X, 1),
            0,
            1
        )

        state[key] = math.floor(min + (max - min) * ratio + 0.5)
        fill.Size = UDim2.fromScale(ratio, 1)
        t.Text = text .. "   " .. state[key]

        callback(state[key])
        save()
    end

    bind(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input.Position.X)
        end
    end)

    bind(UIS.InputChanged, function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input.Position.X)
        end
    end)

    bind(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

