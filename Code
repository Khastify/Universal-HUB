local NametagSystem = {
    enabled = true,
    maxDistance = 100,

    -- V53: Increased from 14 to 16.
    textSize = 16,

    tags = {},
    originalDisplays = {},
    characterConnections = {},
    elapsed = 0
}

local function RestoreNametagDisplay(humanoid)
    local original = NametagSystem.originalDisplays[humanoid]

    if original and humanoid and humanoid.Parent then
        pcall(function()
            humanoid.DisplayDistanceType = original
        end)
    end

    NametagSystem.originalDisplays[humanoid] = nil
end

local function RemoveNametag(player)
    local data = NametagSystem.tags[player]

    if data then
        if data.gui then
            data.gui:Destroy()
        end

        if data.humanoid then
            RestoreNametagDisplay(data.humanoid)
        end
    end

    NametagSystem.tags[player] = nil
end

local function CreateNametag(player)
    if not Alive or not NametagSystem.enabled then
        return
    end

    if player == LP then return end

    RemoveNametag(player)

    local character = player.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not head or not humanoid then return end

    if NametagSystem.originalDisplays[humanoid] == nil then
        NametagSystem.originalDisplays[humanoid] =
            humanoid.DisplayDistanceType
    end

    pcall(function()
        humanoid.DisplayDistanceType =
            Enum.HumanoidDisplayDistanceType.None
    end)

    local billboard = Create("BillboardGui", {
        Name = "KHASTIFY_CameraNametag",
        Adornee = head,
        StudsOffsetWorldSpace = Vector3.new(0, 2.1, 0),
        Size = UDim2.fromOffset(200, 32),
        AlwaysOnTop = false,
        LightInfluence = 0,
        MaxDistance = 0,
        Enabled = false
    }, head)

    local nameLabel = Create("TextLabel", {
        Name = "DisplayName",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = player.DisplayName,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        TextStrokeTransparency = 0.45,
        Font = Enum.Font.SourceSans,

        -- V53 larger nametags.
        TextSize = NametagSystem.textSize,

        TextScaled = false,
        TextWrapped = false,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center
    }, billboard)

    NametagSystem.tags[player] = {
        gui = billboard,
        label = nameLabel,
        head = head,
        humanoid = humanoid,
        character = character
    }
end

local function SetupNametagPlayer(player)
    if player == LP then return end

    if NametagSystem.characterConnections[player] then
        NametagSystem.characterConnections[player]:Disconnect()
    end

    NametagSystem.characterConnections[player] =
        player.CharacterAdded:Connect(function(character)

            RemoveNametag(player)

            task.spawn(function()
                local head = character:WaitForChild("Head", 10)
                local humanoid =
                    character:WaitForChild("Humanoid", 10)

                if not Alive or not head or not humanoid then
                    return
                end

                if player.Character == character then
                    CreateNametag(player)
                end
            end)
        end)

    if player.Character then
        task.spawn(function()
            local character = player.Character

            local head = character:FindFirstChild("Head")
                or character:WaitForChild("Head", 10)

            local humanoid =
                character:FindFirstChildOfClass("Humanoid")
                or character:WaitForChild("Humanoid", 10)

            if Alive
                and head
                and humanoid
                and player.Character == character then

                CreateNametag(player)
            end
        end)
    end
end

local function UpdateNametags()
    if not NametagSystem.enabled then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local cameraPosition = camera.CFrame.Position

    for player, data in pairs(NametagSystem.tags) do
        if not player.Parent
            or not data.character
            or player.Character ~= data.character
            or not data.head
            or not data.head.Parent
            or not data.humanoid
            or not data.humanoid.Parent then

            RemoveNametag(player)
        else
            local distance =
                (cameraPosition - data.head.Position).Magnitude

            local withinRange =
                distance <= NametagSystem.maxDistance

            local alive = data.humanoid.Health > 0

            local _, onScreen =
                camera:WorldToViewportPoint(data.head.Position)

            local shouldShow =
                withinRange and alive and onScreen

            if data.gui.Enabled ~= shouldShow then
                data.gui.Enabled = shouldShow
            end

            if data.label.Text ~= player.DisplayName then
                data.label.Text = player.DisplayName
            end

            if data.humanoid.DisplayDistanceType
                ~= Enum.HumanoidDisplayDistanceType.None then

                pcall(function()
                    data.humanoid.DisplayDistanceType =
                        Enum.HumanoidDisplayDistanceType.None
                end)
            end
        end
    end
end

local function CleanupNametags()
    NametagSystem.enabled = false

    for player, connection in pairs(
        NametagSystem.characterConnections
    ) do
        connection:Disconnect()
        NametagSystem.characterConnections[player] = nil
    end

    local toRemove = {}

    for player in pairs(NametagSystem.tags) do
        table.insert(toRemove, player)
    end

    for _, player in ipairs(toRemove) do
        RemoveNametag(player)
    end

    for humanoid in pairs(NametagSystem.originalDisplays) do
        RestoreNametagDisplay(humanoid)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    SetupNametagPlayer(player)
end

Bind(Players.PlayerAdded, SetupNametagPlayer)

Bind(Players.PlayerRemoving, function(player)
    RemoveNametag(player)

    local connection =
        NametagSystem.characterConnections[player]

    if connection then
        connection:Disconnect()
        NametagSystem.characterConnections[player] = nil
    end
end)

