local function Line(parent, x1, y1, x2, y2, color, thick)
    thick = thick or 2

    local dx = x2 - x1
    local dy = y2 - y1
    local length = math.sqrt(dx * dx + dy * dy)

    local obj = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),

        Position = UDim2.fromOffset(
            (x1 + x2) / 2,
            (y1 + y2) / 2
        ),

        Size = UDim2.fromOffset(length, thick),

        Rotation = math.deg(math.atan2(dy, dx)),

        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parent)

    Create("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, obj)

    return obj
end

local function Dot(parent, x, y, radius, color)
    local obj = Create("Frame", {
        Position = UDim2.fromOffset(
            x - radius,
            y - radius
        ),

        Size = UDim2.fromOffset(
            radius * 2,
            radius * 2
        ),

        BackgroundColor3 = color,
        BorderSizePixel = 0
    }, parent)

    Create("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, obj)

    return obj
end

local function Circle(parent, x, y, radius, color, thick)
    local obj = Create("Frame", {
        Position = UDim2.fromOffset(
            x - radius,
            y - radius
        ),

        Size = UDim2.fromOffset(
            radius * 2,
            radius * 2
        ),

        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, parent)

    Create("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, obj)

    Stroke(obj, color, thick or 2)

    return obj
end

local function OutlineRect(
    parent, x, y, w, h, color, radius, thick
)
    local obj = Create("Frame", {
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),

        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, parent)

    Corner(obj, radius or 3)
    Stroke(obj, color, thick or 2)

    return obj
end

-- V27:
-- One shared stroke width for the four redesigned icons.

local ICON_STROKE = 1.8

local function Path(parent, points, color, closed, thickness)
    thickness = thickness or ICON_STROKE

    if #points < 2 then
        return
    end

    for i = 1, #points - 1 do
        local a = points[i]
        local b = points[i + 1]

        Line(
            parent,
            a.X, a.Y,
            b.X, b.Y,
            color,
            thickness
        )
    end

    if closed then
        local a = points[#points]
        local b = points[1]

        Line(
            parent,
            a.X, a.Y,
            b.X, b.Y,
            color,
            thickness
        )
    end
end

local function CurvePoints(p0, p1, p2, p3, segments)
    segments = segments or 24

    local points = {}

    for i = 0, segments do
        local t = i / segments
        local u = 1 - t

        local point =
            p0 * (u * u * u)
            + p1 * (3 * u * u * t)
            + p2 * (3 * u * t * t)
            + p3 * (t * t * t)

        table.insert(points, point)
    end

    return points
end

local function Curve(
    parent, p0, p1, p2, p3, color, thickness
)
    Path(
        parent,
        CurvePoints(p0, p1, p2, p3, 24),
        color,
        false,
        thickness
    )
end

local function ArcPoints(
    cx, cy, rx, ry, startAngle, endAngle, segments
)
    segments = segments or 32

    local points = {}

    for i = 0, segments do
        local a = math.rad(
            startAngle
            + (endAngle - startAngle) * i / segments
        )

        table.insert(
            points,
            Vector2.new(
                cx + math.cos(a) * rx,
                cy + math.sin(a) * ry
            )
        )
    end

    return points
end

local function SmoothCircle(parent, cx, cy, radius, color)
    Path(
        parent,
        ArcPoints(cx, cy, radius, radius, 0, 360, 48),
        color,
        true
    )
end

