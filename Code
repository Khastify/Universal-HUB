local function numberFeature(name, key, category, maximum, callback)
    local card = create("Frame", {
        Size = UDim2.new(1, -5, 0, 67),
        BackgroundColor3 = C.surface,
        BorderSizePixel = 0
    }, featureList)

    corner(card, 8)
    stroke(card, C.border, 1)

    local label = textLabel(
        card,
        name,
        12,
        C.text,
        true
    )

    label.Position = UDim2.fromOffset(15, 7)
    label.Size = UDim2.new(1, -110, 0, 23)

    local input = create("TextBox", {
        Position = UDim2.new(1, -91, 0, 9),
        Size = UDim2.fromOffset(75, 25),

        BackgroundColor3 = C.background,

        Text = tostring(state[key]),
        TextColor3 = C.text,

        Font = Enum.Font.Gotham,
        TextSize = 11,

        ClearTextOnFocus = false
    }, card)

    corner(input, 5)

    local track = create("Frame", {
        Position = UDim2.fromOffset(15, 48),

        Size = UDim2.new(1, -30, 0, 4),

        BackgroundColor3 = C.border,
        BorderSizePixel = 0
    }, card)

    corner(track, 3)

    local fill = create("Frame", {
        Size = UDim2.fromScale(
            math.clamp(state[key] / maximum, 0, 1),
            1
        ),

        BackgroundColor3 = C.purple,
        BorderSizePixel = 0
    }, track)

    corner(fill, 3)

    local function apply(value)
        value = tonumber(value)

        if not value then
            input.Text = tostring(state[key])
            return
        end

        value = math.clamp(
            math.floor(value + 0.5),
            0,
            maximum
        )

        state[key] = value
        input.Text = tostring(value)

        fill.Size = UDim2.fromScale(
            value / maximum,
            1
        )

        if callback then
            callback(value)
        end

        save()
    end

    bind(input.FocusLost, function()
        apply(input.Text)
    end)

    local sliding = false

    bind(track.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true

            local ratio = math.clamp(
                (i.Position.X - track.AbsolutePosition.X)
                / math.max(track.AbsoluteSize.X, 1),
                0,
                1
            )

            apply(ratio * maximum)
        end
    end)

    bind(UIS.InputChanged, function(i)
        if sliding
            and i.UserInputType == Enum.UserInputType.MouseMovement then

            local ratio = math.clamp(
                (i.Position.X - track.AbsolutePosition.X)
                / math.max(track.AbsoluteSize.X, 1),
                0,
                1
            )

            apply(ratio * maximum)
        end
    end)

    bind(UIS.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)

    table.insert(featureCards, {
        object = card,
        name = string.lower(name),
        category = category,
        description = "slider number"
    })
end

