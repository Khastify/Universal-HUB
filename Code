local function ClearList()
    for _, obj in ipairs(List:GetChildren()) do
        if obj ~= ListLayout and not obj:IsA("UIPadding") then
            obj:Destroy()
        end
    end

    for _, obj in ipairs(Categories:GetChildren()) do
        if obj ~= CategoryLayout then obj:Destroy() end
    end

    table.clear(Entries)
    table.clear(KeybindButtons)
end

local function AddEntry(obj, name, category, pinned)
    table.insert(Entries, {
        object = obj,
        name = name:lower(),
        category = category,
        pinned = pinned or false
    })
end

local function RemoveEntry(obj)
    for i = #Entries, 1, -1 do
        if Entries[i].object == obj then
            table.remove(Entries, i)
        end
    end
end

local function Filter()
    local query = SearchBox.Text:lower()

    for _, entry in ipairs(Entries) do
        if entry.object and entry.object.Parent then
            local matches =
                entry.pinned
                or query == ""
                or entry.name:find(query, 1, true)

            local categoryMatches =
                entry.pinned
                or CurrentCategory == "All"
                or entry.category == CurrentCategory

            entry.object.Visible = matches and categoryMatches
        end
    end
end

local function AddCategory(name)
    local button = Create("TextButton", {
        Size = UDim2.fromOffset(
            math.max(61, #name*8+24), 29
        ),
        BackgroundColor3 =
            CurrentCategory == name and C.selected or C.bg,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 =
            CurrentCategory == name and C.text or C.muted,
        Font = Enum.Font.GothamMedium,
        TextSize = 12
    }, Categories)

    Corner(button, 7)

    Bind(button.MouseButton1Click, function()
        if CategoryCallback then
            CategoryCallback(name)
            return
        end

        CurrentCategory = name

        for _, child in ipairs(Categories:GetChildren()) do
            if child:IsA("TextButton") then
                local selected = child.Text == name
                child.BackgroundColor3 =
                    selected and C.selected or C.bg
                child.TextColor3 =
                    selected and C.text or C.muted
            end
        end

        Filter()
    end)
end

