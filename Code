local function AddSlider(
    parent,
    name,
    key,
    maximum,
    default,
    callback,
    top
)
    top = top or 0

    local title = Label(
        parent, name, 12, C.muted, false
    )

    title.Position = UDim2.fromOffset(15, top)
    title.Size = UDim2.new(1, -190, 0, 25)

    -- Number input.

    local input = Create("TextBox", {
        Position = UDim2.new(1, -148, 0, top),
        Size = UDim2.fromOffset(67, 27),
        BackgroundColor3 = C.bg,
        Text = tostring(State[key]),
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        ClearTextOnFocus = false
    }, parent)

    Corner(input, 6)
    Stroke(input, C.border)

    -- Reset button.

    local reset = Create("TextButton", {
        Position = UDim2.new(1, -73, 0, top),
        Size = UDim2.fromOffset(58, 27),
        BackgroundColor3 = C.selected,
        BorderSizePixel = 0,
        Text = "Reset",
        TextColor3 = C.muted,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        AutoButtonColor = false
    }, parent)

    Corner(reset, 6)

    Bind(reset.MouseEnter, function()
        Tween(reset, {
            BackgroundColor3 = C.purple,
            TextColor3 = C.text
        }, 0.15)
    end)

    Bind(reset.MouseLeave, function()
        Tween(reset, {
            BackgroundColor3 = C.selected,
            TextColor3 = C.muted
        }, 0.15)
    end)

    -- Slider track.

    local track = Create("Frame", {
        Position = UDim2.fromOffset(15, top + 42),
        Size = UDim2.new(1, -30, 0, 5),
        BackgroundColor3 = C.border,
        BorderSizePixel = 0
    }, parent)

    Corner(track, 3)

    local fill = Create("Frame", {
        Size = UDim2.fromScale(
            math.clamp(State[key] / maximum, 0, 1),
            1
        ),
        BackgroundColor3 = C.purple,
        BorderSizePixel = 0
    }, track)

    Corner(fill, 3)

    local knob = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(
            math.clamp(State[key] / maximum, 0, 1),
            0.5
        ),
        Size = UDim2.fromOffset(11, 11),
        BackgroundColor3 = C.purple,
        BorderSizePixel = 0
    }, track)

    Corner(knob, 6)

    local function Apply(value)
        value = tonumber(value)

        if not value then
            input.Text = tostring(State[key])
            return
        end

        value = math.clamp(
            math.floor(value + 0.5),
            0,
            maximum
        )

        State[key] = value
        input.Text = tostring(value)

        local percent = value / maximum

        fill.Size = UDim2.fromScale(percent, 1)
        knob.Position = UDim2.fromScale(percent, 0.5)

        if callback then
            callback(value)
        end

        Save()
    end

    Bind(input.FocusLost, function()
        Apply(input.Text)
    end)

    Bind(reset.MouseButton1Click, function()
        Apply(default)
    end)

    -- Allow clicking or dragging the slider.

    local dragging = false

    local hitbox = Create("TextButton", {
        Position = UDim2.new(0, 0, 0.5, -12),
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 4
    }, track)

    local function UpdateFromX(x)
        local width = math.max(track.AbsoluteSize.X, 1)

        local percent = math.clamp(
            (x - track.AbsolutePosition.X) / width,
            0,
            1
        )

        Apply(percent * maximum)
    end

    Bind(hitbox.InputBegan, function(i)
        if i.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            dragging = true
            UpdateFromX(i.Position.X)
        end
    end)

    Bind(UIS.InputChanged, function(i)
        if dragging
            and i.UserInputType ==
            Enum.UserInputType.MouseMovement then

            UpdateFromX(i.Position.X)
        end
    end)

    Bind(UIS.InputEnded, function(i)
        if i.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            dragging = false
        end
    end)

    return {
        input = input,
        reset = reset,
        track = track,
        apply = Apply
    }
end

