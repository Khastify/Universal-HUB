local function Toggle(name, key, category, callback)
    Feature(
        name,
        category,
        State[key] and "Enabled" or "Disabled",

        function(sub)
            State[key] = not State[key]

            if callback then
                callback(State[key])
            end

            sub.Text =
                State[key] and "Enabled" or "Disabled"
        end
    )
end

local function Number(name, key, category, maximum, callback)
    local row = MakeCard(67)

    local title = Label(
        row,
        name,
        12,
        C.text,
        true
    )

    title.Position = UDim2.fromOffset(15, 7)
    title.Size = UDim2.new(1, -110, 0, 23)

    local input = Create("TextBox", {
        Position = UDim2.new(1, -91, 0, 9),
        Size = UDim2.fromOffset(75, 25),

        BackgroundColor3 = C.bg,

        Text = tostring(State[key]),
        TextColor3 = C.text,

        Font = Enum.Font.GothamMedium,
        TextSize = 11,

        ClearTextOnFocus = false
    }, row)

    Corner(input, 6)

    local track = Create("Frame", {
        Position = UDim2.fromOffset(15, 48),
        Size = UDim2.new(1, -30, 0, 4),

        BackgroundColor3 = C.border,
        BorderSizePixel = 0
    }, row)

    Corner(track, 3)

    local fill = Create("Frame", {
        Size = UDim2.fromScale(
            math.clamp(State[key] / maximum, 0, 1),
            1
        ),

        BackgroundColor3 = C.purple,
        BorderSizePixel = 0
    }, track)

    Corner(fill, 3)

    local function Apply(value)
        value = tonumber(value)

        if not value then
            input.Text = tostring(State[key])
            return
        end

        value = math.clamp(
            math.floor(value + 0.5),
            0,
            maximum
        )

        State[key] = value
        input.Text = tostring(value)

        fill.Size = UDim2.fromScale(
            value / maximum,
            1
        )

        if callback then
            callback(value)
        end

        Save()
    end

    Bind(input.FocusLost, function()
        Apply(input.Text)
    end)

    local sliding = false

    Bind(track.InputBegan, function(i)
        if i.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            sliding = true

            Apply(
                (i.Position.X - track.AbsolutePosition.X)
                / math.max(track.AbsoluteSize.X, 1)
                * maximum
            )
        end
    end)

    Bind(UIS.InputChanged, function(i)
        if sliding
            and i.UserInputType ==
            Enum.UserInputType.MouseMovement then

            Apply(
                (i.Position.X - track.AbsolutePosition.X)
                / math.max(track.AbsoluteSize.X, 1)
                * maximum
            )
        end
    end)

    Bind(UIS.InputEnded, function(i)
        if i.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            sliding = false
        end
    end)

    AddEntry(row, name, category)
end

