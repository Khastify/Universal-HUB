bind(LP.CharacterAdded, function(c)
    stopFly()
    stopAirWalk()

    removePart(hologram)
    removePart(support)

    hologram = nil
    support = nil
    invisibleActive = false

    state.invisible = false
    state.airWalk = false
    state.freeze = false

    table.clear(collisions)
    table.clear(savedTransparency)
    table.clear(savedHeadTransparency)
    table.clear(savedHeadDecals)

    local h = c:WaitForChild("Humanoid", 10)

    if h then
        h.WalkSpeed = state.speed
        h.UseJumpPower = true
        h.JumpPower = state.jump
    end

    task.wait(0.3)

    if state.fly then
        startFly()
    end
end)

