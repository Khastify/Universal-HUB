local function Dash()
    local r = Root()
    local camera = workspace.CurrentCamera

    if not r or not camera then
        return
    end

    local direction = camera.CFrame.LookVector

    direction = Vector3.new(
        direction.X,
        0,
        direction.Z
    )

    if direction.Magnitude < 0.01 then
        return
    end

    local velocity = r.AssemblyLinearVelocity

    r.AssemblyLinearVelocity =
        direction.Unit * State.dashPower
        + Vector3.new(0, velocity.Y, 0)
end

-- =========================================
-- INVISIBILITY
-- =========================================

local INVISIBLE_OFFSET = 11

local InvisibleActive = false
local VisualAvatar
local InvisibleFloor

local PartPairs = {}
local OriginalTransparency = {}

local OriginalCameraSubject
local OriginalCameraType
local OriginalCameraOffset

local InvisibleFloorY
local LastGroundY

local function RestoreTransparency()
    for part, value in pairs(OriginalTransparency) do
        if part and part.Parent then
            part.LocalTransparencyModifier = value
        end
    end

    table.clear(OriginalTransparency)
end

local function DestroyInvisibleObjects()
    if VisualAvatar then
        VisualAvatar:Destroy()
    end

    if InvisibleFloor then
        InvisibleFloor:Destroy()
    end

    VisualAvatar = nil
    InvisibleFloor = nil

    table.clear(PartPairs)
end

local function PartPath(object, ancestor)
    local pieces = {}
    local current = object

    while current and current ~= ancestor do
        local index = 0

        for _, sibling in ipairs(current.Parent:GetChildren()) do
            if sibling.Name == current.Name
                and sibling.ClassName == current.ClassName then

                index += 1

                if sibling == current then
                    break
                end
            end
        end

        table.insert(
            pieces,
            1,
            current.ClassName
                .. ":"
                .. current.Name
                .. ":"
                .. index
        )

        current = current.Parent
    end

    return table.concat(pieces, "/")
end

local function MakeVisualAvatar()
    local c = Character()

    if not c then
        return nil
    end

    local originalArchivable = c.Archivable
    c.Archivable = true

    local success, clone = pcall(function()
        return c:Clone()
    end)

    c.Archivable = originalArchivable

    if not success or not clone then
        return nil
    end

    clone.Name = "KHASTIFY_TransparentAvatar"

    for _, object in ipairs(clone:GetDescendants()) do
        if object:IsA("Script")
            or object:IsA("LocalScript") then

            object:Destroy()

        elseif object:IsA("JointInstance")
            or object:IsA("WeldConstraint")
            or object:IsA("Constraint") then

            object:Destroy()

        elseif object:IsA("BasePart") then

            object.Anchored = true
            object.CanCollide = false
            object.CanTouch = false
            object.CanQuery = false

            object.CastShadow = false
            object.LocalTransparencyModifier = 0

            if object.Name == "HumanoidRootPart" then
                object.Transparency = 1
            else
                object.Transparency = math.max(
                    object.Transparency,
                    0.3
                )
            end

        elseif object:IsA("Decal")
            or object:IsA("Texture") then

            object.Transparency = math.max(
                object.Transparency,
                0.3
            )

        elseif object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam") then

            object.Enabled = false
        end
    end

    local lookup = {}

    for _, part in ipairs(clone:GetDescendants()) do
        if part:IsA("BasePart") then
            lookup[PartPath(part, clone)] = part
        end
    end

    table.clear(PartPairs)

    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            local matching = lookup[PartPath(part, c)]

            if matching then
                table.insert(PartPairs, {
                    source = part,
                    visual = matching
                })
            end
        end
    end

    clone.Parent = workspace

    return clone
end

local function GroundAt(x, z, referenceY)
    local params = RaycastParams.new()

    params.FilterType = Enum.RaycastFilterType.Exclude

    local excluded = {}

    if Character() then
        table.insert(excluded, Character())
    end

    if VisualAvatar then
        table.insert(excluded, VisualAvatar)
    end

    if InvisibleFloor then
        table.insert(excluded, InvisibleFloor)
    end

    if AirPlatform then
        table.insert(excluded, AirPlatform)
    end

    params.FilterDescendantsInstances = excluded

    local result = workspace:Raycast(
        Vector3.new(x, referenceY + 14, z),
        Vector3.new(0, -32, 0),
        params
    )

    if result and result.Normal.Y > 0.35 then
        return result.Position.Y
    end

    return nil
end

local function SetBodyY(y)
    local c = Character()
    local r = Root()

    if not c or not r then
        return
    end

    local delta = y - r.Position.Y

    if math.abs(delta) > 0.001 then
        c:PivotTo(
            c:GetPivot()
                + Vector3.new(0, delta, 0)
        )
    end
end

local function RestoreCamera()
    local camera = workspace.CurrentCamera
    local h = Humanoid()

    if h and OriginalCameraOffset then
        h.CameraOffset = OriginalCameraOffset
    end

    if camera then
        camera.CameraType =
            OriginalCameraType
            or Enum.CameraType.Custom

        if OriginalCameraSubject
            and OriginalCameraSubject.Parent then

            camera.CameraSubject = OriginalCameraSubject

        elseif h then
            camera.CameraSubject = h
        end
    end

    OriginalCameraSubject = nil
    OriginalCameraType = nil
    OriginalCameraOffset = nil
end

local function MirrorAvatar()
    if not InvisibleActive or not VisualAvatar then
        return
    end

    local offset = Vector3.new(
        0,
        INVISIBLE_OFFSET,
        0
    )

    for _, pair in ipairs(PartPairs) do
        if pair.source.Parent
            and pair.visual.Parent then

            pair.visual.CFrame =
                pair.source.CFrame + offset

            pair.visual.Size = pair.source.Size
        end
    end
end

local function SetInvisible(enabled)
    local c = Character()
    local r = Root()
    local h = Humanoid()
    local camera = workspace.CurrentCamera

    if not enabled then
        if InvisibleActive and c then
            c:PivotTo(
                c:GetPivot()
                    + Vector3.new(
                        0,
                        INVISIBLE_OFFSET,
                        0
                    )
            )

            if r then
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        end

        InvisibleActive = false

        RestoreCamera()
        DestroyInvisibleObjects()
        RestoreTransparency()

        if not State.noclip then
            RestoreCollisions()
        end

        InvisibleFloorY = nil
        LastGroundY = nil

        return
    end

    if InvisibleActive or not c or not r or not h then
        return
    end

    local clone = MakeVisualAvatar()

    if not clone then
        State.invisible = false
        return
    end

    VisualAvatar = clone

    if camera then
        OriginalCameraSubject = camera.CameraSubject
        OriginalCameraType = camera.CameraType
    end

    OriginalCameraOffset = h.CameraOffset

    LastGroundY = GroundAt(
        r.Position.X,
        r.Position.Z,
        r.Position.Y
    ) or (r.Position.Y - 3.2)

    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            OriginalTransparency[part] =
                part.LocalTransparencyModifier
        end
    end

    ApplyNoclip()

    c:PivotTo(
        c:GetPivot()
            + Vector3.new(
                0,
                -INVISIBLE_OFFSET,
                0
            )
    )

    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = 1
        end
    end

    InvisibleFloorY = r.Position.Y - 3.2

    InvisibleFloor = MakePlatform(
        "KHASTIFY_InvisibleSupport",
        Vector3.new(14, 0.5, 14)
    )

    InvisibleActive = true

    MirrorAvatar()

    if camera then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = h

        h.CameraOffset =
            OriginalCameraOffset
            + Vector3.new(
                0,
                INVISIBLE_OFFSET,
                0
            )
    end
end

local function UpdateInvisible()
    if not InvisibleActive then
        return
    end

    local r = Root()

    if not r then
        return
    end

    ApplyNoclip()

    local position = r.Position

    local ground = GroundAt(
        position.X,
        position.Z,
        position.Y + INVISIBLE_OFFSET
    )

    if ground then
        local difference = ground - LastGroundY

        if (difference >= 0 and difference <= 3.5)
            or (difference < 0 and difference >= -5) then

            SetBodyY(r.Position.Y + difference)

            LastGroundY = ground
        end
    end

    position = r.Position

    InvisibleFloorY =
        LastGroundY - INVISIBLE_OFFSET

    if InvisibleFloor then
        InvisibleFloor.Position = Vector3.new(
            position.X,
            InvisibleFloorY - 0.25,
            position.Z
        )
    end

    if not State.fly then
        local minimumY = InvisibleFloorY + 3.2
        local maximumY = LastGroundY - 4.5

        if r.Position.Y < minimumY then
            SetBodyY(minimumY)

            local velocity = r.AssemblyLinearVelocity

            r.AssemblyLinearVelocity = Vector3.new(
                velocity.X,
                math.max(0, velocity.Y),
                velocity.Z
            )

        elseif r.Position.Y > maximumY then
            SetBodyY(maximumY)

            local velocity = r.AssemblyLinearVelocity

            r.AssemblyLinearVelocity = Vector3.new(
                velocity.X,
                math.min(0, velocity.Y),
                velocity.Z
            )
        end
    end
end

