function H.RestoreTransparency()
    for part, value in pairs(Transparency) do
        if part and part.Parent then
            part.LocalTransparencyModifier = value
        end
    end

    table.clear(Transparency)
end

function H.DestroyInvisible()
    if VisualAvatar then VisualAvatar:Destroy() end
    if InvisibleFloor then InvisibleFloor:Destroy() end

    VisualAvatar = nil
    InvisibleFloor = nil

    table.clear(PartPairs)
end

function H.PartPath(obj, ancestor)
    local pieces = {}
    local current = obj

    while current and current ~= ancestor do
        local index = 0

        for _, sibling in ipairs(current.Parent:GetChildren()) do
            if sibling.Name == current.Name
                and sibling.ClassName == current.ClassName then

                index += 1
                if sibling == current then break end
            end
        end

        table.insert(
            pieces, 1,
            current.ClassName .. ":"
                .. current.Name .. ":" .. index
        )

        current = current.Parent
    end

    return table.concat(pieces, "/")
end

function H.MakeVisual()
    local c = H.Char()
    if not c then return nil end

    local archivable = c.Archivable
    c.Archivable = true

    local ok, clone = pcall(function()
        return c:Clone()
    end)

    c.Archivable = archivable

    if not ok or not clone then return nil end

    clone.Name = "KHASTIFY_TransparentAvatar"

    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") then
            obj:Destroy()

        elseif obj:IsA("JointInstance")
            or obj:IsA("WeldConstraint")
            or obj:IsA("Constraint") then
            obj:Destroy()

        elseif obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.CastShadow = false
            obj.LocalTransparencyModifier = 0

            if obj.Name == "HumanoidRootPart" then
                obj.Transparency = 1
            else
                obj.Transparency = math.max(
                    obj.Transparency, 0.3
                )
            end

        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = math.max(obj.Transparency, 0.3)

        elseif obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Beam") then
            obj.Enabled = false
        end
    end

    local lookup = {}

    for _, part in ipairs(clone:GetDescendants()) do
        if part:IsA("BasePart") then
            lookup[H.PartPath(part, clone)] = part
        end
    end

    table.clear(PartPairs)

    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            local matching = lookup[H.PartPath(part, c)]

            if matching then
                table.insert(PartPairs, {
                    source = part,
                    visual = matching
                })
            end
        end
    end

    clone.Parent = workspace
    return clone
end

function H.GroundAt(x, z, referenceY)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local excluded = {}

    if H.Char() then table.insert(excluded, H.Char()) end
    if VisualAvatar then table.insert(excluded, VisualAvatar) end
    if InvisibleFloor then table.insert(excluded, InvisibleFloor) end
    if AirPlatform then table.insert(excluded, AirPlatform) end

    params.FilterDescendantsInstances = excluded

    local result = workspace:Raycast(
        Vector3.new(x, referenceY + 14, z),
        Vector3.new(0, -32, 0),
        params
    )

    if result and result.Normal.Y > 0.35 then
        return result.Position.Y
    end

    return nil
end

function H.SetBodyY(y)
    local c, r = H.Char(), H.Root()
    if not c or not r then return end

    local delta = y - r.Position.Y

    if math.abs(delta) > 0.001 then
        c:PivotTo(
            c:GetPivot() + Vector3.new(0, delta, 0)
        )
    end
end

function H.RestoreCamera()
    local camera = workspace.CurrentCamera
    local h = H.Hum()

    if h and OriginalCameraOffset then
        h.CameraOffset = OriginalCameraOffset
    end

    if camera then
        camera.CameraType =
            OriginalCameraType or Enum.CameraType.Custom

        if OriginalCameraSubject
            and OriginalCameraSubject.Parent then
            camera.CameraSubject = OriginalCameraSubject
        elseif h then
            camera.CameraSubject = h
        end
    end

    OriginalCameraSubject = nil
    OriginalCameraType = nil
    OriginalCameraOffset = nil
end

function H.MirrorAvatar()
    if not InvisibleActive or not VisualAvatar then return end

    local offset = Vector3.new(0, OFFSET - 1, 0)

    for _, pair in ipairs(PartPairs) do
        if pair.source.Parent and pair.visual.Parent then
            pair.visual.CFrame = pair.source.CFrame + offset
            pair.visual.Size = pair.source.Size
        end
    end
end

-- Restored from KHASTIFY'S UNIVERSAL HUB V17.
function H.SetInvisible(enabled)
    local c, r, h = H.Char(), H.Root(), H.Hum()
    local camera = workspace.CurrentCamera

    if not enabled then
        if InvisibleActive and c then
            c:PivotTo(c:GetPivot() + Vector3.new(0, OFFSET, 0))
            if r then
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        end

        InvisibleActive = false
        H.RestoreCamera()
        H.DestroyInvisible()
        H.RestoreTransparency()

        if not State.noclip then
            H.RestoreCollision()
        end

        FloorY = nil
        LastGroundY = nil
        return
    end

    if InvisibleActive or not c or not r or not h then return end

    local clone = H.MakeVisual()
    if not clone then
        State.invisible = false
        return
    end
    VisualAvatar = clone

    if camera then
        OriginalCameraSubject = camera.CameraSubject
        OriginalCameraType = camera.CameraType
    end
    OriginalCameraOffset = h.CameraOffset

    LastGroundY = H.GroundAt(r.Position.X, r.Position.Z, r.Position.Y)
        or (r.Position.Y - 3.2)

    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            Transparency[part] = part.LocalTransparencyModifier
        end
    end

    H.Noclip()
    c:PivotTo(c:GetPivot() + Vector3.new(0, -OFFSET, 0))
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = 1
        end
    end

    FloorY = r.Position.Y - 3.2
    InvisibleFloor = H.Platform("KHASTIFY_InvisibleSupport", Vector3.new(14, 0.5, 14))
    InvisibleActive = true
    H.MirrorAvatar()

    if camera then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = h
        h.CameraOffset = OriginalCameraOffset + Vector3.new(0, OFFSET, 0)
    end
end

function H.UpdateInvisible()
    if not InvisibleActive then return end
    local r = H.Root()
    if not r then return end

    H.Noclip()
    local p = r.Position
    local ground = H.GroundAt(p.X, p.Z, p.Y + OFFSET)

    if ground then
        local difference = ground - LastGroundY
        if (difference >= 0 and difference <= 3.5)
            or (difference < 0 and difference >= -5) then
            H.SetBodyY(r.Position.Y + difference)
            LastGroundY = ground
        end
    end

    p = r.Position
    FloorY = LastGroundY - OFFSET
    if InvisibleFloor then
        InvisibleFloor.Position = Vector3.new(p.X, FloorY - 0.25, p.Z)
    end

    if not State.fly then
        local minimumY = FloorY + 3.2
        local maximumY = LastGroundY - 4.5

        if r.Position.Y < minimumY then
            H.SetBodyY(minimumY)
            local v = r.AssemblyLinearVelocity
            r.AssemblyLinearVelocity = Vector3.new(v.X, math.max(0, v.Y), v.Z)
        elseif r.Position.Y > maximumY then
            H.SetBodyY(maximumY)
            local v = r.AssemblyLinearVelocity
            r.AssemblyLinearVelocity = Vector3.new(v.X, math.min(0, v.Y), v.Z)
        end
    end
end

